---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import FAQ from '../components/FAQ.astro';
import { selectTestimonials } from '../data/testimonials';
import { site, formatPrice, selfStudyModules } from '../data/site';

const stories = selectTestimonials(['winnie', 'mai', 'linda', 'stella']);
const title = 'Successful Eating – online selvstudieforløb på 58 dage';
const description =
  'Successful Eating er et online selvstudieforløb om overspisning: 58 dage, et fundament og syv moduler. Livslang adgang til materialet. ' +
  formatPrice(site.productPrice) + ' inkl. moms.';

const schema = {
  '@type': 'Product',
  '@id': site.url + '/forloebet/#product',
  name: site.productName,
  description,
  category: 'Online selvstudieforløb',
  brand: { '@type': 'Brand', name: site.name },
  provider: { '@id': site.url + '/#organization' },
  offers: {
    '@type': 'Offer',
    url: site.checkout,
    price: site.productPrice,
    priceCurrency: 'DKK',
    priceSpecification: {
      '@type': 'PriceSpecification',
      price: site.productPrice,
      priceCurrency: 'DKK',
      valueAddedTaxIncluded: true,
    },
  },
};
---

<Layout
  title={title}
  description={description}
  schema={schema}
  breadcrumbs={[{ name: 'Successful Eating', url: '/forloebet/' }]}
>
  <div class="se-sales">
    <section class="se-hero" aria-labelledby="sales-heading">
      <div class="container se-hero-grid">
        <div>
          <nav class="breadcrumbs" aria-label="Brødkrummer">
            <a href="/">Forside</a><span>/</span><span>Successful Eating</span>
          </nav>
          <span class="eyebrow">Successful Eating · online selvstudieforløb</span>
          <h1 id="sales-heading">Forstå din overspisning. Og lær at gøre noget andet.</h1>
          <p class="se-lead">
            Du ved måske allerede en hel del om mad. Alligevel kan du stå i køkkenet om aftenen og
            mærke, at den plan, du lagde i morges, ikke hjælper.
          </p>
          <p>
            I Successful Eating bruger du psykologisk viden, videoer og øvelser på egen hånd – i
            dit eget tempo.
          </p>
          <a class="button se-purchase-link" href={site.checkout} data-event="checkout_click" data-location="sales_hero">
            {site.purchaseCta} <Icon size={18} />
          </a>
          <p class="se-hero-note">
            {site.productDays} dage · Fundament og syv moduler · Livslang adgang ·{' '}
            {formatPrice(site.productPrice)} inkl. moms
          </p>
          <p class="se-separate">Individuelle samtaler kan tilkøbes separat. De er ikke med i prisen.</p>
        </div>
        <div class="se-hero-visual">
          <img
            src="/images/ditte-underviser.webp"
            width="685"
            height="586"
            alt="Ditte Munch-Andersen underviser ved en tavle"
            fetchpriority="high"
          />
          <div class="se-hero-caption">
            <strong>Udviklet af psykolog Ditte Munch-Andersen</strong>
            <span>Viden, øvelser og plads til at arbejde med dine egne mønstre.</span>
          </div>
        </div>
      </div>
    </section>

    <section class="section se-recognition" aria-labelledby="recognition-heading">
      <div class="container se-two-column">
        <div>
          <span class="eyebrow">Måske kan du genkende det</span>
          <h2 id="recognition-heading">Du har prøvet at tage dig sammen. Det er måske ikke dér, problemet ligger.</h2>
        </div>
        <div class="se-reading">
          <p>
            Måske spiser du videre, selvom du egentlig gerne vil stoppe. Måske lover du dig selv
            nye regler bagefter, og så begynder det hele forfra.
          </p>
          <p>
            Det handler sjældent om, at du ikke ved nok om mad. I onlineforløbet undersøger du
            de tanker, følelser og vaner, der kan holde mønsteret i gang. Når du bedre forstår
            dem, kan du begynde at øve andre handlinger.
          </p>
          <p>
            Du får ikke en ny liste med forbud. Du får en måde at arbejde konkret med din spisning
            og din hverdag på.
          </p>
        </div>
      </div>
      <div class="container se-pattern-grid">
        <article>
          <span>01</span>
          <h3>Før</h3>
          <p>Hvad sker der i timerne op til, at du spiser mere, end du ønsker?</p>
        </article>
        <article>
          <span>02</span>
          <h3>Under</h3>
          <p>Hvilke tanker og impulser gør det svært at stoppe, når du gerne vil?</p>
        </article>
        <article>
          <span>03</span>
          <h3>Efter</h3>
          <p>Hvordan kommer du videre uden selvkritik og endnu en streng plan?</p>
        </article>
      </div>
    </section>

    <section class="section se-method" id="det-faar-du" aria-labelledby="method-heading">
      <div class="container se-two-column">
        <div>
          <span class="eyebrow">Det får du</span>
          <h2 id="method-heading">Viden bliver først brugbar, når du arbejder med den.</h2>
          <p class="se-method-lead">
            Successful Eating er bygget som et 58-dages selvstudie. Du ser undervisningen, laver
            øvelserne og afprøver det lærte mellem modulerne.
          </p>
          <a class="button se-purchase-link" href={site.checkout} data-event="checkout_click" data-location="sales_method">
            {site.purchaseCta} <Icon size={18} />
          </a>
        </div>
        <div class="se-inclusions">
          <div>
            <Icon name="book" size={25} />
            <div>
              <h3>Et fundament og syv moduler</h3>
              <p>En tydelig rækkefølge, der hjælper dig med at tage ét tema ad gangen.</p>
            </div>
          </div>
          <div>
            <Icon name="leaf" size={25} />
            <div>
              <h3>Videoer og øvelser</h3>
              <p>Du omsætter viden til små, konkrete handlinger i din egen hverdag.</p>
            </div>
          </div>
          <div>
            <Icon name="shield" size={25} />
            <div>
              <h3>Livslang adgang</h3>
              <p>Du kan vende tilbage til onlineforløbets materiale efter de 58 dage.</p>
            </div>
          </div>
          <p class="se-inclusions-note">
            Forløbet gennemføres på egen hånd. Personlig sparring, gruppeterapi og individuelle
            samtaler er ikke inkluderet.
          </p>
        </div>
      </div>
    </section>

    <section class="section se-modules" id="moduler" aria-labelledby="modules-heading">
      <div class="container">
        <div class="se-section-heading">
          <span class="eyebrow">Sådan er forløbet bygget op</span>
          <h2 id="modules-heading">Fra fundamentet til din plan for tiden efter.</h2>
          <p>
            De 58 dage er fordelt på et fundament og syv moduler. Du arbejder med én del ad
            gangen og kan vende tilbage til materialet senere.
          </p>
        </div>
        <ol class="se-module-grid">
          {selfStudyModules.map((module, index) => (
            <li>
              <span class="se-module-number">{index === 0 ? 'Fundament' : 'Modul ' + index}</span>
              <h3>{module.title}</h3>
              <p>{module.description}</p>
            </li>
          ))}
        </ol>
        <div class="se-inline-action">
          <p>Du behøver ikke kunne gøre alt anderledes fra dag ét. Du skal have et sted at begynde.</p>
          <a class="button se-purchase-link" href={site.checkout} data-event="checkout_click" data-location="sales_modules">
            {site.purchaseCta} <Icon size={18} />
          </a>
        </div>
      </div>
    </section>

    <section class="section se-results" id="resultater" aria-labelledby="results-heading">
      <div class="container">
        <div class="se-section-heading">
          <span class="eyebrow">Brugerundersøgelse fra 2024</span>
          <h2 id="results-heading">Hvad oplevede tidligere deltagere?</h2>
          <p>
            Tallene kommer fra deltagere, der havde gennemført Successful Eating, og blev målt
            umiddelbart efter forløbet.
          </p>
        </div>
        <div class="se-results-grid">
          <article><strong>78 %</strong><p>havde nul eller højst én episode med overspisning i løbet af en periode på to uger.</p></article>
          <article><strong>86 %</strong><p>havde tabt sig – op til 6 kg.</p></article>
          <article><strong>43 %</strong><p>oplevede forbedret psykisk helbred.</p></article>
          <article><strong>29 %</strong><p>oplevede markant bedre fysisk helbred.</p></article>
        </div>
        <p class="se-source">
          Kilde: Brugerundersøgelse før/efter Successful Eating (2024). Målingerne er foretaget
          umiddelbart efter forløbet blandt deltagere, der havde gennemført det.
        </p>
        <p class="se-source">
          Tallene beskriver tidligere deltageres svar og er ikke en garanti for et bestemt resultat
          i det aktuelle selvstudie.
        </p>
      </div>
    </section>

    <section class="section se-stories" id="erfaringer" aria-labelledby="stories-heading">
      <div class="container">
        <div class="se-section-heading">
          <span class="eyebrow">Deltagernes erfaringer</span>
          <h2 id="stories-heading">Hvad har andre lagt mærke til?</h2>
          <p>Deres oplevelser er personlige. Læs og lyt med det forbehold, at din situation er din egen.</p>
        </div>
        <div class="se-quote-grid">
          {stories.map((story) => (
            <figure>
              <blockquote>“{story.quote}”</blockquote>
              <figcaption>{story.name}</figcaption>
            </figure>
          ))}
        </div>
        <div class="se-video-grid" aria-label="Videoer fra tidligere deltagere">
          <figure>
            <video controls playsinline preload="none" poster="/images/majbritt-testimonial.webp">
              <source src="/videos/majbritt-testimonial.mp4" type="video/mp4" />
              Din browser understøtter ikke videoafspilning.
            </video>
            <figcaption>
              <strong>Majbritt fortæller om sin erfaring</strong>
              <span>Video fra en tidligere deltager i Successful Eating.</span>
            </figcaption>
          </figure>
          <figure class="se-portrait-video">
            <video controls playsinline preload="none" poster="/images/louise-testimonial.webp">
              <source src="/videos/louise-testimonial.mp4" type="video/mp4" />
              Din browser understøtter ikke videoafspilning.
            </video>
            <figcaption>
              <strong>Louise fortæller om sin erfaring</strong>
              <span>Video fra en tidligere deltager i Successful Eating.</span>
            </figcaption>
          </figure>
        </div>
        <p class="se-source">
          Udtalelserne stammer fra tidligere udgaver af Successful Eating. Onlineforløbet sælges nu
          som selvstudie uden inkluderede samtaler.
        </p>
      </div>
    </section>

    <section class="section se-about" id="om-ditte" aria-labelledby="about-heading">
      <div class="container se-about-grid">
        <div class="se-about-image">
          <img
            src="/images/ditte-portrait.webp"
            srcset="/images/ditte-portrait-small.webp 500w, /images/ditte-portrait.webp 900w"
            sizes="(max-width: 800px) 88vw, 38vw"
            width="900"
            height="1600"
            loading="lazy"
            alt="Ditte Munch-Andersen i sin klinik"
          />
        </div>
        <div class="se-reading">
          <span class="eyebrow">Mennesket bag materialet</span>
          <h2 id="about-heading">Hej, jeg er Ditte Munch-Andersen.</h2>
          <p>
            Jeg er klinisk psykolog og har arbejdet med overspisning og forholdet til mad i mere
            end 20 år. I Successful Eating har jeg samlet den viden og de øvelser, jeg bruger til
            at hjælpe mennesker med at forstå mønstre i spisningen.
          </p>
          <p>
            Du får min undervisning i videoerne. Selve selvstudiet gennemfører du på egen hånd.
            Hvis du ønsker at tale med mig om din situation, kan du købe individuelle samtaler
            separat.
          </p>
          <a href="/om-ditte/" class="text-link">Læs om min faglige baggrund <Icon size={17} /></a>
        </div>
      </div>
    </section>

    <section class="section se-fit" aria-labelledby="fit-heading">
      <div class="container se-two-column">
        <div>
          <span class="eyebrow">Er selvstudiet det rette for dig?</span>
          <h2 id="fit-heading">Du arbejder selv. Den ramme skal passe til dine behov.</h2>
        </div>
        <div class="se-reading">
          <p>
            Successful Eating kan være relevant, hvis du vil forstå din overspisning og er klar
            til at arbejde med videoer og øvelser på egen hånd. Du behøver ikke have alle svar,
            før du begynder.
          </p>
          <p>
            Har du brug for individuel vurdering, tæt støtte eller behandling, skal du vælge
            hjælp med personlig kontakt. Tvangsoverspisning (BED) er en diagnose, og selvstudiet
            erstatter ikke en faglig vurdering.
          </p>
          <p>
            Hvis du fremkalder opkastning, har udtalt restriktiv spisning, oplever symptomer på
            anoreksi eller er bekymret for dit fysiske helbred, bør du kontakte din egen læge.
          </p>
          <a class="text-link" href="/individuelt-forloeb/">
            Se individuelle samtaler som separat tilbud <Icon size={17} />
          </a>
        </div>
      </div>
    </section>

    <section class="section se-pricing" id="priser" aria-labelledby="price-heading">
      <div class="container se-pricing-grid">
        <div>
          <span class="eyebrow">Pris og adgang</span>
          <h2 id="price-heading">Successful Eating for {formatPrice(site.productPrice)} inkl. moms.</h2>
          <p class="se-lead">
            Du får et online selvstudieforløb bygget til 58 dage. Materialet er dit at vende
            tilbage til med livslang adgang.
          </p>
          <p>
            Det er en selvstændig måde at arbejde med din spisning på. Har du brug for samtaler med
            mig, kan du tilkøbe dem som et separat tilbud.
          </p>
        </div>
        <div class="se-price-card">
          <span class="eyebrow">Successful Eating · online selvstudieforløb</span>
          <strong class="se-price">{formatPrice(site.productPrice)}</strong>
          <span class="se-vat">inkl. moms</span>
          <ul>
            <li><Icon name="check" size={18} /> 58 dage: fundament og syv moduler</li>
            <li><Icon name="check" size={18} /> Videoundervisning og øvelser</li>
            <li><Icon name="check" size={18} /> Livslang adgang til onlineforløbets materiale</li>
          </ul>
          <p>Individuelle samtaler, personlig sparring og gruppeterapi er ikke inkluderet.</p>
          <a class="button se-purchase-link" href={site.checkout} data-event="checkout_click" data-location="sales_price">
            {site.purchaseCta} <Icon size={18} />
          </a>
          <small>Du fortsætter til den eksterne købsside hos systeme.io.</small>
          <a href="/terms/" class="se-terms-link">Læs handelsbetingelserne</a>
        </div>
      </div>
    </section>

    <FAQ />

    <section class="se-final" aria-labelledby="final-heading">
      <div class="container">
        <span class="eyebrow">Et sted at begynde</span>
        <h2 id="final-heading">Du behøver ikke endnu en kur. Du kan begynde med at forstå mønsteret.</h2>
        <p>
          Successful Eating giver dig 58 dages struktur og materiale, du kan bruge igen senere.
          Du arbejder selvstændigt, i det tempo der passer ind i dit liv.
        </p>
        <a class="button se-purchase-link" href={site.checkout} data-event="checkout_click" data-location="sales_final">
          {site.purchaseCta} <Icon size={18} />
        </a>
        <p class="se-final-note">{formatPrice(site.productPrice)} inkl. moms · Livslang adgang · Samtaler kan tilkøbes separat</p>
      </div>
    </section>
  </div>
</Layout>

<style>
  .se-sales { overflow: clip; }
  .se-sales section[id] { scroll-margin-top: 120px; }
  .se-sales .button { white-space: normal; }
  .se-hero { background: var(--sage); padding-block: clamp(48px, 5vw, 76px); }
  .se-hero-grid, .se-two-column, .se-about-grid, .se-pricing-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr);
    gap: clamp(38px, 6vw, 92px);
    align-items: center;
  }
  .se-hero .breadcrumbs { margin-bottom: 28px; }
  .se-hero .eyebrow { margin-bottom: 12px; }
  .se-hero h1 { max-width: 770px; font-size: clamp(2.7rem, 4.4vw, 4.5rem); overflow-wrap: normal; hyphens: none; }
  .se-hero p { max-width: 650px; }
  .se-lead { color: var(--ink); font-size: clamp(1.18rem, 1.7vw, 1.4rem); line-height: 1.65; }
  .se-hero .se-lead { margin-top: 24px; }
  .se-purchase-link { margin-top: 24px; }
  .se-hero-note, .se-separate { font-size: .94rem; line-height: 1.5; }
  .se-hero-note { margin-top: 19px; font-weight: 650; }
  .se-separate { margin-top: 6px; color: var(--muted); }
  .se-hero-visual { position: relative; align-self: stretch; display: grid; align-content: center; }
  .se-hero-visual img { width: 100%; border-radius: 22px; aspect-ratio: 1 / .92; object-fit: cover; }
  .se-hero-caption { background: var(--white); border-radius: 16px; padding: 20px 24px; margin: -44px 24px 0; position: relative; box-shadow: 0 12px 35px #294c3d18; line-height: 1.4; }
  .se-hero-caption strong, .se-hero-caption span { display: block; }
  .se-hero-caption span { color: var(--muted); font-size: .94rem; margin-top: 5px; }
  .se-two-column { align-items: start; }
  .se-two-column h2 { max-width: 620px; }
  .se-reading { max-width: 670px; }
  .se-reading p { line-height: 1.8; }
  .se-reading h2 { margin-bottom: 24px; }
  .se-pattern-grid { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 18px; margin-top: 58px; }
  .se-pattern-grid article, .se-module-grid li { border: 1px solid var(--line); border-radius: 18px; padding: 27px; background: var(--white); }
  .se-pattern-grid article span, .se-module-number { color: var(--rust); font-size: .85rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .se-pattern-grid h3 { margin: 12px 0; }
  .se-method { background: var(--paper); }
  .se-method-lead { margin-top: 26px; max-width: 580px; }
  .se-inclusions { background: var(--white); border: 1px solid var(--line); border-radius: 22px; padding: clamp(25px, 4vw, 42px); }
  .se-inclusions > div { display: flex; gap: 18px; padding-block: 18px; }
  .se-inclusions > div + div { border-top: 1px solid var(--line); }
  .se-inclusions svg { color: var(--green); margin-top: 3px; }
  .se-inclusions h3 { font-family: var(--sans); font-size: 1.13rem; font-weight: 700; letter-spacing: 0; }
  .se-inclusions p { color: var(--muted); font-size: .98rem; line-height: 1.6; margin-top: 4px; }
  .se-inclusions .se-inclusions-note { border-top: 1px solid var(--line); margin-top: 13px; padding-top: 22px; color: var(--ink); }
  .se-modules { background: var(--sand); }
  .se-section-heading { max-width: 800px; margin-bottom: 48px; }
  .se-section-heading p { color: var(--muted); max-width: 700px; margin-top: 22px; }
  .se-module-grid { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 18px; }
  .se-module-grid h3 { margin: 14px 0 11px; font-size: 1.38rem; }
  .se-module-grid p { color: var(--muted); line-height: 1.65; }
  .se-inline-action { display: flex; gap: 30px; justify-content: space-between; align-items: center; margin-top: 38px; }
  .se-inline-action p { max-width: 600px; }
  .se-inline-action .button { flex-shrink: 0; margin-top: 0; }
  .se-results { background: var(--green); color: var(--white); }
  .se-results .se-section-heading p, .se-results .se-source { color: #eef2e9; }
  .se-results-grid { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 18px; }
  .se-results-grid article { border: 1px solid #ffffff55; border-radius: 18px; padding: 26px; }
  .se-results-grid strong { display: block; font-family: var(--serif); font-size: clamp(2.5rem, 4vw, 3.9rem); font-weight: 500; line-height: 1; }
  .se-results-grid p { margin-top: 18px; line-height: 1.55; }
  .se-source { font-size: .92rem; line-height: 1.6; margin-top: 26px; max-width: 850px; }
  .se-source + .se-source { margin-top: 9px; }
  .se-stories { background: var(--peach); }
  .se-quote-grid, .se-video-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 20px; }
  .se-quote-grid figure, .se-video-grid figure { margin: 0; background: var(--white); border: 1px solid var(--line); border-radius: 18px; overflow: hidden; }
  .se-quote-grid figure { padding: 28px; display: flex; flex-direction: column; justify-content: space-between; }
  .se-quote-grid blockquote { margin: 0; font-family: var(--serif); font-size: 1.24rem; line-height: 1.55; }
  .se-quote-grid figcaption { margin-top: 24px; font-weight: 700; }
  .se-video-grid { margin-top: 24px; align-items: start; }
  .se-video-grid video { display: block; width: 100%; max-height: 470px; background: #111; object-fit: contain; }
  .se-video-grid figure:first-child video { aspect-ratio: 16 / 9; }
  .se-video-grid .se-portrait-video video { aspect-ratio: 16 / 9; }
  .se-video-grid figcaption { padding: 20px 25px 25px; line-height: 1.45; }
  .se-video-grid figcaption strong, .se-video-grid figcaption span { display: block; }
  .se-video-grid figcaption span { font-size: .92rem; color: var(--muted); margin-top: 5px; }
  .se-about { background: var(--white); }
  .se-about-grid { grid-template-columns: minmax(0,.8fr) minmax(0,1.2fr); }
  .se-about-image { max-width: 430px; margin-inline: auto; }
  .se-about-image img { width: 100%; height: auto; border-radius: 20px; }
  .se-about .text-link, .se-fit .text-link { margin-top: 24px; }
  .se-fit { background: var(--sage); }
  .se-pricing { background: var(--sand); }
  .se-pricing-grid { align-items: start; }
  .se-pricing .se-lead { margin-top: 28px; }
  .se-price-card { background: var(--white); border: 1px solid var(--line); border-radius: 24px; padding: clamp(26px,4vw,46px); box-shadow: 0 22px 55px #294c3d12; }
