---
import Layout from '../layouts/Layout.astro';
import { site, consultation, services, formatPrice } from '../data/site';

// /forloebet har sin egen side (tidligere genereret af [service].astro).
// Layout leverer header, footer, popup, cookie-samtykke, canonical/OG og JSON-LD.
const service = services.find((s) => s.slug === 'forloebet')!;
const title = 'Fri fra overspisning – behandling af BED online | Successful Eating';
const description = `Fri fra overspisning: 8 ugers psykologisk behandlingsforløb online hos klinisk psykolog Ditte Munch-Andersen med forsamtale, gruppeterapi over fire mødegange og Successful Eating (videoer og øvelser). Pris ${formatPrice(site.treatmentPrice)}`;
const schema = {
  '@type': 'Service',
  '@id': `${site.url}/${service.slug}#service`,
  name: 'Fri fra overspisning – behandling af overspisning online',
  description: service.intro,
  provider: { '@id': `${site.url}/#organization` },
  areaServed: { '@type': 'Country', name: 'Danmark' },
  serviceType: 'Kognitiv behandling af overspisning',
  url: `${site.url}/${service.slug}`,
  offers: {
    '@type': 'Offer',
    price: site.treatmentPrice,
    priceCurrency: 'DKK',
    url: site.checkout,
    description:
      'Otte ugers behandlingsforløb, hvor en individuel forsamtale er inkluderet. Alle pengene tilbage, hvis forløbet ved forsamtalen vurderes at være et dårligt match.',
  },
};
---

<Layout
  title={title}
  description={description}
  schema={schema}
  breadcrumbs={[{ name: service.title, url: `/${service.slug}` }]}
>
  <div class="fl-page">
    <section class="fl-hero" aria-labelledby="hero-heading">
      <div class="fl-container">
        <nav class="fl-breadcrumbs" aria-label="Brødkrummer">
          <a href="/">Forside</a>
          <span>/</span>
          <span>Fri fra overspisning</span>
        </nav>

        <div class="fl-hero-grid">
          <div class="fl-hero-copy">
            <span class="fl-eyebrow">Overspisning & madstøj · Online i hele Danmark</span>

            <h1 id="hero-heading">Fri fra overspisning</h1>

            <p class="fl-intro">
              <strong>Et 8 ugers psykologisk behandlingsforløb.</strong> Forløbet inkluderer en
              forsamtale, gruppeterapi over fire mødegange og Successful Eating – navnet på det
              univers og den metode, jeg har udviklet gennem mange år. Det er her, du finder
              undervisningen, videoerne og øvelserne, som handler om psykologien bag overspisning.
            </p>

            <div class="fl-section-cta">
              <a
                class="fl-button"
                href={site.checkout}
                data-event="checkout_click"
                data-location="hero"
              >
                Tilmeld dig · {formatPrice(site.treatmentPrice)}
              </a>
            </div>

            <p class="fl-hero-note">
              Inkl. individuel forsamtale · Eller start med en forsamtale på 50 minutter til{' '}
              {formatPrice(site.consultationPrice)}
            </p>

            <div class="fl-capacity-card">
              <strong>Kun 6 pladser i gruppen ad gangen</strong>
              <p>
                Når du tilmelder dig, tager vi forsamtalen og aftaler din opstart ud fra din
                kalender og de ledige pladser. Er gruppen allerede fuld, er du først i rækken til
                den næste ledige plads.
              </p>
            </div>
          </div>

          <figure
            class="fl-video"
            data-video-embed
            data-video-id="6jLXFgJHOM0"
            data-video-title="Ditte Munch-Andersen om Fri fra overspisning"
          >
            <button type="button" class="fl-video-trigger">
              <img src="/images/ditte-underviser.webp" alt="" width="685" height="586" />
              <span class="fl-video-play" aria-hidden="true"></span>
              <span class="fl-video-label">Se videoen: Ditte fortæller om forløbet</span>
            </button>
            <figcaption class="fl-video-note">Videoen indlæses fra YouTube, når du trykker afspil.</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="fl-section fl-tone-white" aria-labelledby="recognition-heading">
      <div class="fl-container">
        <div class="fl-recognition-grid">
          <div class="fl-recognition-copy">
            <span class="fl-eyebrow">MÅSKE KAN DU GENKENDE DET</span>

            <h2 id="recognition-heading">Når overspisning, selvkritik og tanker om mad fylder</h2>

            <p>
              Hvis overspisning og tanker om mad påvirker din hverdag, kan psykologisk behandling
              være relevant.
            </p>

            <p>
              Vi undersøger sammen, hvad der udløser og vedligeholder dine mønstre, og arbejder med
              kognitive redskaber, som kan bruges i dit eget liv.
            </p>

            <p>
              Du behøver ikke kunne forklare alt på forhånd. I den individuelle forsamtale taler vi
              om din situation og vurderer sammen, om Fri fra overspisning er det rette match.
            </p>

            <div class="fl-section-cta">
              <a
                class="fl-button"
                href={site.checkout}
                data-event="checkout_click"
                data-location="recognition"
              >
                Tag første skridt · {formatPrice(site.treatmentPrice)}
              </a>
            </div>
          </div>

          <aside class="fl-facts-card">
            <span class="fl-eyebrow">PRAKTISK & OVERSKUELIGT</span>

            <h3>Fri fra overspisning</h3>

            <dl>
              <div>
                <dt>Behandler</dt>
                <dd>Ditte Munch-Andersen, klinisk psykolog</dd>
              </div>

              <div>
                <dt>Format</dt>
                <dd>Live online behandling · Maks. 6 i gruppen</dd>
              </div>

              <div>
                <dt>Målgruppe</dt>
                <dd>Overspisning & madstøj</dd>
              </div>

              <div>
                <dt>Varighed</dt>
                <dd>8 uger med daglige øvelser og viden</dd>
              </div>

              <div>
                <dt>Adgang til materiale</dt>
                <dd>12 uger</dd>
              </div>

              <div>
                <dt>Gruppen</dt>
                <dd>Ulige torsdage kl. 17–18.30 · Google Meet</dd>
              </div>

              <div>
                <dt>Pris</dt>
                <dd>{formatPrice(site.treatmentPrice)}</dd>
              </div>
            </dl>
          </aside>
        </div>
      </div>
    </section>

    <section class="fl-section fl-tone-sage" aria-labelledby="results-heading">
      <div class="fl-container">
        <div class="fl-results-heading">
          <span class="fl-eyebrow">RESULTATER FRA 2024</span>

          <h2 id="results-heading">Hvad oplevede deltagere, der gennemførte forløbet?</h2>

          <p class="fl-intro">
            I en brugerundersøgelse fra 2024 blandt deltagere, der gennemførte forløbet, blev der
            rapporteret konkrete ændringer i overspisning samt psykisk og fysisk helbred.
          </p>
        </div>

        <div class="fl-result-grid">
          <article class="fl-result-card">
            <span class="fl-result-number">78 %</span>
            <p>havde ingen eller højst én overspisning de sidste 2 uger af forløbet.</p>
          </article>

          <article class="fl-result-card">
            <span class="fl-result-number">43 %</span>
            <p>oplevede forbedret psykisk helbred.</p>
          </article>

          <article class="fl-result-card">
            <span class="fl-result-number">29 %</span>
            <p>oplevede markant bedre fysisk helbred.</p>
          </article>
        </div>

        <p class="fl-result-source">
          Resultaterne er individuelle og dokumenterer ikke et bestemt resultat for den enkelte.{' '}
          <a href="/resultater#dokumenterede-resultater">
            Læs mere om undersøgelsen og resultaterne.
          </a>
        </p>

        <div class="fl-section-cta">
          <a
            class="fl-button"
            href={site.checkout}
            data-event="checkout_click"
            data-location="results"
          >
            Start dit forløb · {formatPrice(site.treatmentPrice)}
          </a>
        </div>
      </div>
    </section>

    <section
      class="fl-section fl-transformation fl-tone-peach"
      aria-labelledby="transformation-heading"
    >
      <div class="fl-container">
        <span class="fl-eyebrow">HVAD KAN DU ARBEJDE HEN IMOD?</span>

        <h2 id="transformation-heading">
          Forestil dig, hvis du kunne få et friere forhold til mad
        </h2>

        <p class="fl-intro">
          Målet er ikke en bestemt vægt eller kropsstørrelse. Målet er, at overspisning, madregler
          og tankerne om mad ikke længere styrer dig på samme måde.
        </p>

        <div class="fl-transformation-list">
          <div class="fl-transformation-item">
            {' '}
            Du forstår, hvorfor du overspiser – og hvad der konkret udløser dine overspisninger.
          </div>

          <div class="fl-transformation-item">
            {' '}
            Du får redskaber til at bryde mønsteret og håndtere trangen til at overspise på nye
            måder.
          </div>

          <div class="fl-transformation-item">
            {' '}
            Du oplever mere kontrol omkring mad i stedet for igen og igen at føle, at du mister
            kontrollen.
          </div>

          <div class="fl-transformation-item">
            {' '}
            Du kan håndtere svære følelser uden automatisk at bruge mad til at regulere dem.
          </div>

          <div class="fl-transformation-item">
            {' '}
            Du får mindre madstøj og mere frihed til at være til stede i dit liv uden konstant at
            tænke på mad, spisning eller næste overspisning.
          </div>

          <div class="fl-transformation-item">
            {' '}
            Du lærer at håndtere tilbagefald, så en svær dag ikke behøver udvikle sig til en ny
            spiral.
          </div>

          <div class="fl-transformation-item">
            {' '}
            Du står med konkrete strategier, du kan bruge efter forløbet og en plan for, hvordan du
            fastholder dine nye mønstre.
          </div>
        </div>

        <p class="fl-intro fl-transformation-closing">Så er du landet det helt rigtige sted.</p>

        <div class="fl-section-cta">
          <a
            class="fl-button"
            href={site.checkout}
            data-event="checkout_click"
            data-location="transformation"
          >
            Få støtte til at skabe nye mønstre
          </a>
        </div>
      </div>
    </section>

    <section class="fl-section fl-tone-white" id="det-faar-du" aria-labelledby="overview-heading">
      <div class="fl-container">
        <div class="fl-section-heading">
          <span class="fl-eyebrow">FAGLIG STØTTE · PLADS TIL DIN HVERDAG</span>

          <h2 id="overview-heading">Det får du i Fri fra overspisning</h2>

          <p class="fl-intro">
            Fri fra overspisning er et 8-ugers psykologisk behandlingsforløb. Jeg følger dig fra
            den første forsamtale til den sidste gruppeterapi. Mellem samtalerne arbejder du i
            Successful Eating med viden og øvelser, der hjælper dig med at træne nye mønstre i dit
            eget liv.
          </p>
        </div>

        <div class="fl-inclusion-grid">
          <article class="fl-inclusion-card">
            <div class="fl-icon">01</div>

            <h3>Individuel forsamtale</h3>

            <p>
              Vi taler om din situation, de områder du har brug for at arbejde med, og de
              situationer og triggere, der typisk sætter din overspisning i gang.
            </p>

            <p>
              Sammen vurderer vi, om forløbet er det rigtige for dig. Samtalen varer 50 minutter og
              kan foregå i klinikken i Helsingør eller online.
            </p>
          </article>

          <article class="fl-inclusion-card">
            <div class="fl-icon">02</div>

            <h3>4 online gruppeterapier</h3>

            <p>
              Hver anden torsdag mødes gruppen online til klinisk struktureret gruppebehandling med
              højst 6 deltagere.
            </p>

            <p>
              Gruppen mødes på Google Meet i ulige uger torsdag kl. 17–18.30. Der er løbende optag,
              og samtalerne optages ikke.
            </p>
          </article>

          <article class="fl-inclusion-card">
            <div class="fl-icon">03</div>

            <h3>Successful Eating: viden og øvelser mellem samtalerne</h3>

            <p>
              Successful Eating er onlinedelen af forløbet, hvor du finder undervisningen,
              videoerne og øvelserne. Du får ca. 5 timers video i små, overskuelige bidder fordelt
              over 8 psykologiske faser.
            </p>

            <p>
              Du arbejder med konkrete, daglige øvelser, så du får mulighed for at bruge det, du
              lærer, i din egen hverdag.
            </p>
          </article>

          <article class="fl-inclusion-card">
            <div class="fl-icon">04</div>

            <h3>Du bliver fulgt hele vejen</h3>

            <p>
              Fra forsamtalen til den sidste gruppeterapi følger jeg dig i arbejdet med dit
              overspisningsmønster. Du får 5 terapigange med mig – én individuel forsamtale og fire
              gruppeterapigange – plus ca. 5 timers videoundervisning og øvelser, som du arbejder
              med mellem møderne.
            </p>

            <p>
              I videoerne får du den viden og erfaring, jeg har samlet gennem mere end 20 år som
              psykolog, og som ligger til grund for den måde, jeg arbejder med overspisning på.
            </p>

            <p>
              Kombinationen af terapi, viden og træning gør Fri fra overspisning til et samlet
              behandlingsforløb over 8 uger. Ved at kombinere individuel samtale, gruppeterapi og
              videoundervisning kan jeg samtidig tilbyde et effektivt og omfattende
              behandlingsforløb til en væsentligt lavere pris end et tilsvarende individuelt forløb.
            </p>
          </article>
        </div>

        <div class="fl-section-cta">
          <a
            class="fl-button"
            href={site.checkout}
            data-event="checkout_click"
            data-location="overview"
          >
            Se pris og tilmelding
          </a>
        </div>
      </div>
    </section>

    <section class="fl-section fl-tone-sage" id="gruppen" aria-labelledby="group-heading">
      <div class="fl-container">
        <div class="fl-group-grid">
          <div>
            <span class="fl-eyebrow">GRUPPEN</span>

            <h2 id="group-heading">Behandling i gruppe, så du ikke står alene med overspisning</h2>

            <p>
              Hver anden torsdag mødes jeg med gruppen online. Jeg er autoriseret psykolog, og I er
              højst seks deltagere ad gangen, så der er tid og ro til dig og dine udfordringer med
              overspisning.
            </p>

            <p>
              Gruppeforløbet er psykologisk behandling af overspisning (BED). Du arbejder med
              metoder fra kognitiv adfærdsterapi, som skal mindske overspisningsepisoderne og
              forbedre din trivsel og dit helbred.
            </p>

            <p>
              Du får faglig behandling af en psykolog og samtidig støtte af andre, der kender
              overspisning indefra.
            </p>

            <p>
              Jeg har tavshedspligt, og i gruppen er reglen, at alt, der bliver delt i gruppen, er
              fortroligt.
            </p>

            <p>
              Der er løbende optag. Gruppen består derfor ikke nødvendigvis af de samme personer
              hele vejen igennem. Du møder nogle, der lige er begyndt, og nogle, der er kommet
              længere.
            </p>

            <div class="fl-section-cta">
              <a
                class="fl-button"
                href={site.checkout}
                data-event="checkout_click"
                data-location="group"
              >
                Få en plads i gruppen
              </a>
            </div>
          </div>

          <dl class="fl-group-facts">
            <div>
              <dt>Hvornår</dt>
              <dd>Ulige uger, torsdag kl. 17–18.30</dd>
            </div>

            <div>
              <dt>Varighed</dt>
              <dd>60–90 minutter, tilpasset antal deltagere</dd>
            </div>

            <div>
              <dt>Hvor</dt>
              <dd>Online på Google Meet</dd>
            </div>

            <div>
              <dt>Hvem</dt>
              <dd>Højst 6 deltagere ad gangen</dd>
            </div>

            <div>
              <dt>Start</dt>
              <dd>Løbende optag</dd>
            </div>

            <div>
              <dt>Optagelse</dt>
              <dd>Samtalerne optages ikke</dd>
            </div>
          </dl>
        </div>
      </div>
    </section>

    <section class="fl-section fl-tone-white" id="faser" aria-labelledby="phase-heading">
      <div class="fl-container">
        <div class="fl-phase-intro">
          <span class="fl-eyebrow">TRIN FOR TRIN MOD MERE MADRO</span>

          <h2 id="phase-heading">De 8 faser i Successful Eating</h2>

          <p class="fl-intro">
            Du bevæger dig fra at forstå kroppens signaler og dine overspisningsmønstre til at kunne
            håndtere følelser, tilbagefald og tiden efter forløbet.
          </p>

          <p>
            Du arbejder dig igennem én fase ad gangen. Inden du går videre, stopper du kort op og
            reflekterer over, hvad du har taget med dig. Næste fase låses op, når du er klar.
          </p>
        </div>

        <ol class="fl-phase-grid">
          <li>
            <article class="fl-phase-card">
              <span class="fl-phase-number">Fase 1</span>
              <h3>Fundamentet</h3>
              <p>
                Du genopbygger kontakten til kroppens sult- og mæthedssignaler og får indsigt i,
                hvornår du spiser uden fysisk sult.
              </p>
            </article>
          </li>

          <li>
            <article class="fl-phase-card">
              <span class="fl-phase-number">Fase 2</span>
              <h3>Det afhængige mønster</h3>
              <p>
                Du arbejder med den psykiske afhængighed af mad og lærer strategier til at håndtere
                impulsen til at overspise.
              </p>
            </article>
          </li>

          <li>
            <article class="fl-phase-card">
              <span class="fl-phase-number">Fase 3</span>
              <h3>Redskaberne</h3>
              <p>
                Du bryder med slankekurstankegangen og de rigide regler, der ofte holder
                overspisningen fast.
              </p>
            </article>
          </li>

          <li>
            <article class="fl-phase-card">
              <span class="fl-phase-number">Fase 4</span>
              <h3>Perspektivskifte</h3>
              <p>Du arbejder med at løsne grebet fra slankekure, vægtfokus og madstøj.</p>
            </article>
          </li>

          <li>
            <article class="fl-phase-card">
              <span class="fl-phase-number">Fase 5</span>
              <h3>Følelser og regulering</h3>
              <p>Du lærer at håndtere tristhed, mental træthed og stress uden at ty til mad.</p>
            </article>
          </li>

          <li>
            <article class="fl-phase-card">
              <span class="fl-phase-number">Fase 6</span>
              <h3>Førstehjælp ved tilbagefald</h3>
              <p>
                Du lærer at vende tilbage til dine nye mønstre hurtigt og uden straf, så et
                tilbagefald ikke bliver en ny spiral.
              </p>
            </article>
          </li>

          <li>
            <article class="fl-phase-card">
              <span class="fl-phase-number">Fase 7</span>
              <h3>Forholdet til kroppen</h3>
              <p>Du arbejder med at mindske kropslede og finde mere ro i den krop, du har.</p>
            </article>
          </li>

          <li>
            <article class="fl-phase-card">
              <span class="fl-phase-number">Fase 8</span>
              <h3>Fasthold forandringen</h3>
              <p>Du forbereder dig på tiden efter forløbet, så de nye mønstre holder.</p>
            </article>
          </li>
        </ol>

        <div class="fl-section-cta">
          <a
            class="fl-button"
            href={site.checkout}
            data-event="checkout_click"
            data-location="phases"
          >
            Arbejd med dine mønstre · {formatPrice(site.treatmentPrice)}
          </a>
        </div>
      </div>
    </section>

    <section class="fl-section fl-tone-sage" aria-labelledby="testimonial-heading">
      <div class="fl-container">
        <div class="fl-testimonial-heading">
          <div>
            <span class="fl-eyebrow">ERFARINGER MED FORLØBET</span>

            <h2 id="testimonial-heading">Når nye mønstre kan mærkes i hverdagen</h2>
          </div>

          <p>
            Tidligere deltagere fortæller om mere frihed i situationer med mad, mindre madstøj og et
            forløb, der giver mening.
          </p>
        </div>

        <div class="fl-testimonial-grid">
          <figure class="fl-testimonial">
            <blockquote>
              “Ferie og sommerhus er nok den største højrisiko jeg kan sætte mig i, fordi hygge er
              forbundet med madindtag. Det er det stadig, men nu har jeg kontrollen over indtaget og
              jeg har hygget mig lige meget af den grund”
            </blockquote>

            <figcaption>
              <strong>Mai</strong>
              <span>Tidligere deltager i Successful Eating</span>
            </figcaption>
          </figure>

          <figure class="fl-testimonial">
            <blockquote>
              “Jeg er så glad for, at jeg besluttede mig for dit forløb og synes, det er et super
              godt materiale, du har lavet. Det giver så meget mening for mig og beskriver nærmest i
              detaljer, hvordan jeg har det med mad”
            </blockquote>

            <figcaption>
              <strong>Christina</strong>
              <span>Tidligere deltager i Successful Eating</span>
            </figcaption>
          </figure>

          <figure class="fl-testimonial">
            <blockquote>
              “Som 71-årig har jeg endelig, takket være dit system, fået styr på min afhængighed af
              søde sager”
            </blockquote>

            <figcaption>
              <strong>Susanne</strong>
              <span>Tidligere deltager i Successful Eating</span>
            </figcaption>
          </figure>
        </div>

        <p class="fl-testimonial-source">
          Udtalelserne er indsamlet direkte fra tidligere deltagere siden 2014. Successful Eating er
          løbende udviklet, og deltagernes oplevelser er individuelle.
        </p>

        <p class="fl-testimonial-source">
          <a href={site.trustpilot}>Se også anmeldelser på Trustpilot</a>
        </p>

        <div class="fl-section-cta">
          <a
            class="fl-button"
            href={site.checkout}
            data-event="checkout_click"
            data-location="testimonials"
          >
            Skab dine egne erfaringer · {formatPrice(site.treatmentPrice)}
          </a>
        </div>
      </div>
    </section>

    <section class="fl-section fl-tone-white" aria-labelledby="value-heading">
      <div class="fl-container">
        <div class="fl-value-grid">
          <div>
            <span class="fl-eyebrow">DET FÅR DU</span>

            <h2 id="value-heading">Et samlet behandlingsforløb – ikke bare mere viden</h2>

            <p>
              Du får personlig behandlerkontakt, gruppebehandling, videoundervisning og konkrete
              øvelser, der kan afprøves i din hverdag.
            </p>

            <div class="fl-section-cta">
