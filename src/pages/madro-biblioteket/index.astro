---
import Layout from '../../layouts/Layout.astro';
import Articles from '../../components/Articles.astro';
import CTA from '../../components/CTA.astro';
import Icon from '../../components/Icon.astro';
import library from '../../data/library-pages.json';
import { site } from '../../data/site';
---

<Layout
  title="Madro-biblioteket | Viden om overspisning, madstøj og ADHD"
  description="Find forståelig viden om madro, overspisning om aftenen og ADHD. Korte svar, faglige kilder og veje til mere støtte hos Successful Eating."
  schema={{
    '@type': 'CollectionPage',
    '@id': `${site.url}/madro-biblioteket#collection`,
    name: 'Madro-biblioteket',
    url: `${site.url}/madro-biblioteket`,
    inLanguage: 'da-DK',
  }}
  breadcrumbs={[{ name: 'Madro-biblioteket', url: '/madro-biblioteket' }]}
>
  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Brødkrummer">
        <a href="/">Forside</a>
        <span>/</span>
        <span>Madro-biblioteket</span>
      </nav>
      <span class="eyebrow">VIDEN MED PLADS TIL NUANCER</span>
      <h1>
        Forstå mere.
        <br />
        <em>Døm dig selv mindre.</em>
      </h1>
      <p class="intro">
        Viden om overspisning, madstøj og de mønstre, der kan fylde i hverdagen. Begynd dér, hvor du
        genkender dig selv.
      </p>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <Articles />
      <div class="library-feature">
        <h2 style="margin-bottom:28px">Mere fra biblioteket</h2>
        <div class="archive-list">
          {library.map((p) => (
            <article class="archive-item">
              <h3>
                <a href={`/${p.slug}`}>{p.title}</a>
              </h3>
              <p style="margin-top:15px">{p.description}</p>
              <a class="text-link" href={`/${p.slug}`}>
                Læs artiklen →
              </a>
            </article>
          ))}
        </div>
      </div>
      <div class="library-feature">
        <div class="section-heading">
          <div>
            <span class="eyebrow">MERE AT GÅ PÅ OPDAGELSE I</span>
            <h2>År med viden og refleksioner.</h2>
          </div>
          <a class="text-link" href="/blog">
            Søg i hele artikelarkivet <Icon size={17} />
          </a>
        </div>
        <p class="intro">
          Find tidligere artikler om madvaner, følelser og forholdet til kroppen. Arkivet bevarer
          artiklernes oprindelige datoer, så du kan se, hvornår de er skrevet.
        </p>
      </div>
    </div>
  </section>
  <CTA />
</Layout>
