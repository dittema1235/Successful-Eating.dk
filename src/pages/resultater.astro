---
import Layout from '../layouts/Layout.astro';
import CTA from '../components/CTA.astro';
import Icon from '../components/Icon.astro';
import ParticipantTestimonials from '../components/ParticipantTestimonials.astro';
import { site, consultation, formatPrice } from '../data/site';
---

<Layout
  title="Resultater fra Successful Eating | Behandling af overspisning"
  description="Se deltagererfaringer og resultater fra Successful Eating: 78 % havde ingen eller højst én overspisning på to uger. Behandling af overspisning online."
  breadcrumbs={[{ name: 'Resultater', url: '/resultater' }]}
>
  <section class="page-hero tone-sage results-hero">
    <div class="container results-hero-grid">
      <div>
        <nav class="breadcrumbs" aria-label="Brødkrummer">
          <a href="/">Forside</a>
          <span>/</span>
          <span>Resultater</span>
        </nav>
        <span class="eyebrow">FRA KONTROLTAB TIL MERE MADRO</span>
        <h1>
          Når maden fylder mindre,
          <br />
          får <em>livet mere plads.</em>
        </h1>
        <p class="intro">
          Successful Eating hjælper dig med at forstå det, der holder overspisningen i gang, og
          arbejde konkret med nye måder at møde sult, følelser og madtanker på.
        </p>
        <div class="actions">
          <a
            href="/forloebet#priser"
            class="button"
            data-event="pricing_click"
            data-location="results_hero"
          >
            Se forløbet og pris <Icon size={18} />
          </a>
          <a href="#dokumenterede-resultater" class="text-link">
            Se deltagernes resultater <Icon size={17} />
          </a>
        </div>
        <p class="hero-note">8 ugers behandlingsforløb · Klinisk psykolog · Højst 6 deltagere</p>
      </div>
      <figure class="results-person">
        <img
          src="/images/ditte-underviser.webp"
          alt="Psykolog Ditte Munch-Andersen underviser"
          width="685"
          height="586"
        />
        <figcaption>
          <strong>Ditte Munch-Andersen</strong>
          <span>Klinisk psykolog · Mere end 20 års erfaring</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <section
    class="section results-evidence"
    id="dokumenterede-resultater"
    aria-labelledby="evidence-heading"
  >
    <div class="container">
      <div class="section-heading evidence-heading">
        <div>
          <span class="eyebrow">RESULTATER FRA 2024</span>
          <h2 id="evidence-heading">Forandring, der kan mærkes og måles.</h2>
        </div>
        <p class="intro">
          I en brugerundersøgelse før og efter Successful Eating blandt deltagere, der gennemførte
          forløbet, viste svarene:
        </p>
      </div>
      <div class="evidence-grid">
        <article>
          <strong>
            78<span>%</span>
          </strong>
          <p>havde ingen eller højst én overspisning i løbet af to uger</p>
        </article>
        <article>
          <strong>
            43<span>%</span>
          </strong>
          <p>oplevede, at deres psykiske helbred var forbedret</p>
        </article>
        <article>
          <strong>
            29<span>%</span>
          </strong>
          <p>oplevede markant bedre fysisk helbred</p>
        </article>
      </div>
      <p class="evidence-source">
        Kilde: Brugerundersøgelse før/efter Successful Eating (2024) blandt deltagere, der
        gennemførte forløbet. Resultater er individuelle.
      </p>
    </div>
  </section>

  <section class="section" id="forandring" aria-labelledby="results-heading">
    <div class="container">
      <div class="section-heading">
        <div>
          <span class="eyebrow">DET ARBEJDER DU HEN IMOD</span>
          <h2 id="results-heading">Mere frihed omkring mad. Mere ro i dig.</h2>
        </div>
        <p class="intro">
          Målet er ikke at spise perfekt. Målet er, at du får bedre mulighed for at forstå dine
          mønstre og vælge anderledes, når spisningen bliver svær.
        </p>
      </div>
      <div class="results-grid">
        <article>
          <Icon name="leaf" size={27} />
          <h3>Mindre kontroltab</h3>
          <p>
            Du arbejder med at opdage dine udløsere tidligere og bryde cirklen omkring overspisning.
          </p>
        </article>
        <article>
          <Icon name="heart" size={27} />
          <h3>Mindre skyld og selvkritik</h3>
          <p>Du øver dig i at møde svære episoder uden at straffe dig selv eller begynde forfra.</p>
        </article>
        <article>
          <Icon name="shield" size={27} />
          <h3>En mere stabil spisning</h3>
          <p>Du får redskaber til mere regelmæssighed og færre sort-hvide regler om mad.</p>
        </article>
        <article>
          <Icon name="book" size={27} />
          <h3>Redskaber, du kan bruge videre</h3>
          <p>Du lærer at arbejde med tanker, følelser og vaner både under og efter forløbet.</p>
        </article>
      </div>
    </div>
  </section>

  <ParticipantTestimonials
    ids={['winnie', 'mai', 'linda', 'stella', 'jette', 'christina']}
    tone="peach"
    heading="Sådan beskriver tidligere deltagere forandringen"
    intro="De udvalgte erfaringer handler om overspisning, madregler, kontrol og et ændret forhold til mad."
    showTrustpilotLink
  />

  <section class="section">
    <div class="container content-grid">
      <div class="prose">
        <span class="eyebrow">PSYKOLOGISK BEHANDLING</span>
        <h2>Behandling frem for endnu en kur.</h2>
        <p>
          Overspisning handler sjældent om, at du mangler viden om, hvad du burde spise. Derfor
          begynder Successful Eating heller ikke med en ny liste over forbud. Vi undersøger det
          mønster, der opstår før, under og efter en overspisning, så du kan arbejde med det, der
          faktisk holder dig fast.
        </p>
        <p>
          Tilgangen tager afsæt i kognitiv adfærdsterapi. Du arbejder blandt andet med måltidsrytme,
          udløsere, alt-eller-intet-tanker, følelsesmæssige situationer og dit forhold til kroppen.
          De digitale moduler giver dig forståelsen; samtalerne og øvelserne hjælper dig med at
          omsætte den til din hverdag.
        </p>
        <p>
          Successful Eating er et struktureret behandlingsforløb hos klinisk psykolog Ditte
          Munch-Andersen. Det er den kliniske forsamtale, den live behandlerkontakt og det samlede
          terapeutiske arbejde, der gør forløbet til behandling – de digitale moduler understøtter
          behandlingen undervejs.
        </p>
        <h2>Et forløb med personlig støtte</h2>
        <ul class="results-checklist">
          <li>
            <Icon name="check" size={18} /> Individuel forsamtale med Ditte
          </li>
          <li>
            <Icon name="check" size={18} /> Fire live gruppesamtaler med højst seks deltagere
          </li>
          <li>
            <Icon name="check" size={18} /> Otte psykologiske moduler
          </li>
          <li>
            <Icon name="check" size={18} /> Korte øvelser, du kan bruge i din egen hverdag
          </li>
          <li>
            <Icon name="check" size={18} /> Materiale til at fastholde det, du har lært
          </li>
        </ul>
        <p>
          Ditte er klinisk psykolog, uddannet fra Københavns Universitet i 2004, og har mere end 20
          års erfaring som psykolog. Du bliver mødt af en fagperson, som hjælper dig med at se hele
          din situation – ikke kun det, du har spist.
        </p>
        <p>
          <a href="/om-ditte">Mød Ditte og læs om hendes tilgang</a>.
        </p>
      </div>
      <aside class="facts-card results-offer">
        <span class="eyebrow">PRIS & TRYGHED</span>
        <h2>Kom godt fra start.</h2>
        <p class="results-price">{formatPrice(site.treatmentPrice)}</p>
        <p class="tax-note">
          Prisen er momsfritaget, fordi forløbet leveres som sundhedsfaglig behandling hos en
          autoriseret psykolog.
        </p>
        <p>
          Prisen dækker det otte ugers behandlingsforløb, live behandling og en individuel klinisk
          forsamtale.
        </p>
        <div class="offer-promise">
          <Icon name="shield" size={23} />
          <p>
            <strong>Et trygt første skridt.</strong> Vurderes forløbet ved forsamtalen at være et
            dårligt match, får du alle pengene tilbage.
          </p>
        </div>
        <a
          class="button"
          href="/forloebet#priser"
          data-event="pricing_click"
          data-location="results_offer"
        >
          Se pris og tilmelding <Icon size={17} />
        </a>
        <a class="text-link" href="/forloebet#om-forloebet">
          Se hele forløbets indhold <Icon size={16} />
        </a>
        <a
          class="text-link"
          href={consultation.href}
          data-event="consultation_click"
          data-location="results_offer"
        >
          Start med {site.consultationMinutes} minutter · {formatPrice(site.consultationPrice)}{' '}
          <Icon size={16} />
        </a>
        <p class="consultation-note">Beløbet modregnes, hvis du bagefter vælger hele forløbet.</p>
      </aside>
    </div>
  </section>

  <section class="results-foundation">
    <div class="container results-foundation-inner">
      <div>
        <span class="eyebrow">ET FAGLIGT FUNDAMENT</span>
        <h2>Psykologisk behandling med retning.</h2>
      </div>
      <p>
        Arbejdet med regelmæssig spisning, udløsere, tanker, følelser og kropsbillede ligger i tråd
        med centrale elementer i kognitiv behandling af overspisning. Du får en tydelig ramme og
        støtte til at bruge den i dit eget liv.
        <a href="https://www.nice.org.uk/guidance/ng69/chapter/Recommendations#treating-binge-eating-disorder">
          Læs den faglige retningslinje
        </a>
        .
      </p>
    </div>
  </section>

  <CTA purchase />
</Layout>

<style>
  .results-hero {
    overflow: hidden;
  }
  .results-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(320px, 0.75fr);
    gap: clamp(42px, 7vw, 90px);
    align-items: center;
  }
  .results-person {
    margin: 0;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 24px 54px #2d3d2921;
  }
  .results-person img {
    display: block;
    width: 100%;
    aspect-ratio: 1.17;
    object-fit: cover;
  }
  .results-person figcaption {
    display: flex;
    flex-direction: column;
    padding: 20px 23px 22px;
  }
  .results-person strong {
    color: var(--green);
  }
  .results-person span {
    margin-top: 4px;
    color: var(--muted);
    font-size: var(--text-small);
  }
  .results-evidence {
    background: var(--green);
    color: var(--white);
  }
  .results-evidence .eyebrow,
  .results-evidence h2,
  .results-evidence .intro {
    color: var(--white);
  }
  .evidence-heading {
    align-items: end;
  }
  .evidence-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    margin-top: clamp(35px, 5vw, 58px);
  }
  .evidence-grid article {
    min-height: 270px;
    padding: clamp(30px, 4vw, 48px);
    border: 1px solid #ffffff40;
    border-radius: 8px;
    background: #ffffff0b;
  }
  .evidence-grid strong {
    display: block;
    color: #f5e1bd;
    font-family: var(--serif);
    font-size: clamp(4.25rem, 8vw, 6.8rem);
    font-weight: 500;
    letter-spacing: -0.06em;
    line-height: 0.9;
  }
  .evidence-grid strong span {
    margin-left: 4px;
    font-size: 0.52em;
  }
  .evidence-grid p {
    max-width: 290px;
    margin-top: 27px;
    font-size: clamp(1.05rem, 1.7vw, 1.3rem);
    line-height: 1.5;
  }
  .evidence-source {
    margin-top: 23px;
    color: #ffffffb8;
    font-size: var(--text-small);
  }
  .results-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
  }
  .results-grid article {
    padding: 30px 26px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--white);
  }
  .results-grid :global(svg) {
    color: #637453;
  }
  .results-grid h3 {
    margin: 23px 0 12px;
    font-size: 1.4rem;
  }
  .results-grid p {
    color: var(--muted);
    font-size: var(--text-body);
    line-height: 1.7;
  }
  .results-checklist {
    display: grid;
    gap: 11px;
    margin-block: 25px 30px;
    padding: 0;
    list-style: none;
  }
  .results-checklist li {
    display: flex;
    gap: 10px;
    align-items: flex-start;
  }
  .results-checklist :global(svg) {
    flex: 0 0 auto;
    margin-top: 4px;
    color: #637453;
  }
  .results-offer {
    background: var(--sage);
  }
  .results-price {
    margin: 12px 0 0;
    color: var(--green);
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 600;
  }
  .tax-note {
    margin: 4px 0 24px;
    color: var(--green);
    font-size: var(--text-small);
    font-weight: 600;
  }
  .offer-promise {
    display: flex;
    gap: 13px;
    margin-top: 25px;
    padding-top: 22px;
    border-top: 1px solid var(--line);
  }
  .offer-promise :global(svg) {
    flex: 0 0 auto;
  }
  .offer-promise strong {
    display: block;
    margin-bottom: 4px;
  }
  .results-offer .text-link {
    margin-top: 22px;
  }
  .consultation-note {
    margin: 7px 0 0;
    color: var(--muted);
    font-size: var(--text-small);
  }
  .results-foundation {
    padding-block: clamp(55px, 7vw, 85px);
    background: #eeefe7;
  }
  .results-foundation-inner {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr);
    gap: clamp(35px, 7vw, 90px);
    align-items: center;
  }
  .results-foundation p {
    font-size: var(--text-lead);
    line-height: 1.75;
  }
  .results-foundation a {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  @media (max-width: 900px) {
    .results-hero-grid,
    .results-foundation-inner {
      grid-template-columns: 1fr;
    }
    .results-person {
      max-width: 620px;
    }
    .results-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .evidence-grid {
      grid-template-columns: 1fr;
    }
    .evidence-grid article {
      min-height: 0;
    }
  }
  @media (max-width: 620px) {
    .results-grid {
      grid-template-columns: 1fr;
    }
    .results-hero .actions {
      align-items: flex-start;
    }
  }
</style>
