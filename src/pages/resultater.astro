---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import CTA from '../components/CTA.astro';
import ParticipantTestimonials from '../components/ParticipantTestimonials.astro';

const title = 'Resultater og deltagererfaringer | Successful Eating';
const description =
  'Se resultater fra brugerundersøgelsen før/efter Successful Eating (2024) og læs tidligere deltageres erfaringer. Tallene er målt umiddelbart efter forløbet.';
---

<Layout
  title={title}
  description={description}
  breadcrumbs={[{ name: 'Resultater', url: '/resultater/' }]}
>
  <section class="page-hero tone-sage">
    <div class="container results-hero">
      <div>
        <nav class="breadcrumbs" aria-label="Brødkrummer">
          <a href="/">Forside</a><span>/</span><span>Resultater</span>
        </nav>
        <span class="eyebrow">RESULTATER FRA 2024</span>
        <h1>Hvad oplevede tidligere deltagere i Successful Eating?</h1>
        <p class="intro">
          Her kan du se, hvad deltagere svarede umiddelbart efter, at de havde gennemført
          Successful Eating. Resultaterne beskriver deres erfaringer. De kan ikke forudsige
          dit resultat i det aktuelle online selvstudieforløb.
        </p>
        <a href="/forloebet/" class="button">Se onlineforløbet <Icon size={17} /></a>
      </div>
      <img
        src="/images/ditte-underviser.webp"
        width="685"
        height="586"
        alt="Ditte Munch-Andersen underviser ved en tavle"
      />
    </div>
  </section>

  <section class="section results-evidence" id="dokumenterede-resultater" aria-labelledby="evidence-heading">
    <div class="container">
      <span class="eyebrow">BRUGERUNDERSØGELSE FØR/EFTER</span>
      <h2 id="evidence-heading">Deltagernes svar, samlet på ét sted.</h2>
      <div class="results-grid">
        <article><strong>78 %</strong><p>havde nul eller højst én episode med overspisning i løbet af en periode på to uger.</p></article>
        <article><strong>86 %</strong><p>havde tabt sig – op til 6 kg.</p></article>
        <article><strong>43 %</strong><p>oplevede forbedret psykisk helbred.</p></article>
        <article><strong>29 %</strong><p>oplevede markant bedre fysisk helbred.</p></article>
      </div>
      <p class="results-source">
        Kilde: Brugerundersøgelse før/efter Successful Eating (2024). Målingerne er foretaget
        umiddelbart efter forløbet blandt deltagere, der havde gennemført det.
      </p>
      <p class="results-source">
        Det er selvrapporterede svar fra tidligere deltagere. Der er ikke oplyst deltagerantal
        eller længere opfølgning her, og tallene er ikke en garanti for et bestemt resultat.
      </p>
    </div>
  </section>

  <section class="section results-context" aria-labelledby="context-heading">
    <div class="container results-context-grid">
      <div>
        <span class="eyebrow">HVAD ARBEJDER DU MED?</span>
        <h2 id="context-heading">Mindre kontroltab begynder med at forstå mønsteret.</h2>
      </div>
      <div>
        <p>
          Successful Eating er nu et online selvstudieforløb. Du arbejder med videoer og øvelser
          over 58 dage: et fundament og syv moduler. Målet er at opdage, hvad der sker før, under
          og efter en overspisning, og øve nye måder at handle på.
        </p>
        <p>
          Onlineforløbet indeholder ikke personlig vurdering, gruppeterapi eller individuelle
          samtaler. Hvis du ønsker individuelle samtaler med Ditte, kan du købe dem separat.
        </p>
        <a href="/individuelt-forloeb/" class="text-link">
          Læs om individuelle samtaler <Icon size={17} />
        </a>
      </div>
    </div>
  </section>

  <ParticipantTestimonials
    ids={['winnie', 'mai', 'linda', 'stella', 'jette', 'christina']}
    tone="peach"
    heading="Sådan beskriver tidligere deltagere deres oplevelse"
    intro="Citaterne er fra tidligere udgaver af Successful Eating. Deres oplevelser er personlige og kan ikke love dig samme resultat."
    showTrustpilotLink
  />

  <section class="section results-video-link">
    <div class="container">
      <div>
        <span class="eyebrow">SE OG LYT</span>
        <h2>Hør Majbritt og Louise fortælle.</h2>
        <p>
          På siden om onlineforløbet finder du to videoer fra tidligere deltagere sammen med
          flere skriftlige erfaringer.
        </p>
      </div>
      <a href="/forloebet/#erfaringer" class="button">Se deltagernes videoer <Icon size={17} /></a>
    </div>
  </section>

  <CTA />
</Layout>

<style>
  .results-hero { display: grid; grid-template-columns: minmax(0,1.1fr) minmax(0,.9fr); gap: clamp(35px,6vw,85px); align-items: center; }
  .results-hero h1 { max-width: 720px; }
  .results-hero .intro { margin-top: 25px; max-width: 620px; }
  .results-hero .button { margin-top: 28px; }
  .results-hero img { width: 100%; border-radius: 20px; }
  .results-evidence { background: var(--green); color: var(--white); }
  .results-evidence h2 { max-width: 800px; }
  .results-grid { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 17px; margin-top: 42px; }
  .results-grid article { padding: 25px; border: 1px solid #ffffff55; border-radius: 18px; }
  .results-grid strong { display: block; font: 500 clamp(2.7rem,4vw,4rem)/1 var(--serif); }
  .results-grid p { margin-top: 17px; line-height: 1.55; }
  .results-source { max-width: 900px; font-size: .92rem; line-height: 1.6; margin-top: 24px; color: #eef2e9; }
  .results-source + .results-source { margin-top: 8px; }
  .results-context-grid { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1fr); gap: clamp(35px,7vw,100px); }
  .results-context-grid p { line-height: 1.8; }
  .results-context-grid .text-link { margin-top: 24px; }
  .results-video-link { background: var(--paper); }
  .results-video-link .container { display: flex; gap: 28px; justify-content: space-between; align-items: end; }
  .results-video-link h2 { max-width: 650px; }
  .results-video-link p { margin-top: 18px; max-width: 650px; }
  .results-video-link .button { flex-shrink: 0; }
  @media (max-width: 900px) {
    .results-hero, .results-context-grid { grid-template-columns: 1fr; }
    .results-grid { grid-template-columns: repeat(2,minmax(0,1fr)); }
    .results-hero img { max-width: 650px; }
  }
  @media (max-width: 650px) {
    .results-grid { grid-template-columns: 1fr; }
    .results-video-link .container { flex-direction: column; align-items: stretch; }
  }
</style>
