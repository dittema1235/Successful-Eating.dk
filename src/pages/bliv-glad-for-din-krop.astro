---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { site, formatPrice, bodyCourse } from '../data/site';

const title = 'Bliv glad for din krop – onlineforløb om kropsaccept';
const description =
  'Bliv glad for din krop er et onlineforløb om kropsaccept: seks moduler over seks uger og livslang adgang. ' +
  formatPrice(bodyCourse.price) +
  ' inkl. moms. Af psykolog Ditte Munch-Andersen.';

const schema = {
  '@type': 'Course',
  '@id': site.url + '/bliv-glad-for-din-krop/#course',
  name: bodyCourse.productName,
  description,
  inLanguage: 'da-DK',
  provider: { '@id': site.url + '/#organization' },
  offers: {
    '@type': 'Offer',
    url: new URL(bodyCourse.checkout, site.url).href,
    price: bodyCourse.price,
    priceCurrency: 'DKK',
    priceSpecification: {
      '@type': 'PriceSpecification',
      price: bodyCourse.price,
      priceCurrency: 'DKK',
      valueAddedTaxIncluded: true,
    },
  },
};

const modules = [
  {
    title: 'Hvordan dit kropsbillede blev skabt',
    description:
      'Du finder frem til de episoder, der har formet dit forhold til din krop. Og så begynder du at slippe dem.',
  },
  {
    title: 'Skjuler du din krop?',
    description:
      'Du ser på de strategier, du bruger for at skjule din krop, og på hvad de egentlig gør ved dig. Så kan du begynde at slippe dem.',
  },
  {
    title: 'Bliv din krops bedste ven',
    description:
      'Du øver dig i at stoppe den negative selvsnak og i at tale til dig selv med omsorg. Som du ville tale til en ven.',
  },
  {
    title: 'Afmonter dine “sandheder” om din krop',
    description:
      'Du lærer at få øje på de tanker, der sætter kropsskammen i gang, og at undersøge dem i stedet for bare at tro på dem.',
  },
  {
    title: 'Når andre kommenterer din krop',
    description:
      'Du bliver tryggere ved at sætte grænser og stå fast, når andre har meninger om din krop.',
  },
  {
    title: 'Sådan holder du fast',
    description:
      'Du lægger en plan, så du ikke glider tilbage i de gamle mønstre, og finder en ny og mere venlig vej videre.',
  },
];

const stories = [
  {
    name: 'Louise',
    quote:
      'For første gang i mit liv kan jeg tage et billede uden at granske alle mine ‘fejl’. Det er en frihed, jeg ikke troede var mulig.',
  },
  {
    name: 'Maria',
    quote:
      'Jeg har kæmpet med mit kropsbillede i årevis, men det her forløb har hjulpet mig med at se min krop på en ny måde. Det føles som en kæmpe lettelse!',
  },
];

const faqs = [
  {
    question: 'Hvad er Bliv glad for din krop?',
    answer:
      'Et onlineforløb om kropsaccept over seks uger. Du får adgang til ét nyt modul hver 7. dag og arbejder på egen hånd. Hvert modul bygger videre på det forrige.',
  },
  {
    question: 'Hvor længe har jeg adgang?',
    answer:
      'Du har livslang adgang til forløbets materiale. De seks uger beskriver, hvordan forløbet er bygget op, og ikke hvornår din adgang udløber.',
  },
  {
    question: 'Skal jeg tabe mig for at få noget ud af det?',
    answer:
      'Nej. Forløbet handler ikke om vægt. Der er ingen kostplan og ingen vægtmål. Det handler om dit forhold til din krop.',
  },
  {
    question: 'Er forløbet en erstatning for psykologisk behandling?',
    answer:
      'Nej. Bliv glad for din krop er et onlineforløb, du gennemfører selv. Det indeholder ingen individuel vurdering eller behandling. Har du det rigtig svært, kan du bestille individuelle samtaler eller tale med din egen læge.',
  },
  {
    question: 'Er samtaler med Ditte med i prisen?',
    answer:
      'Nej. Individuelle samtaler om kropsaccept er et separat tilbud, som du kan bestille, hvis du ønsker personlig kontakt.',
  },
  {
    question: 'Hvad koster forløbet?',
    answer:
      'Bliv glad for din krop koster ' +
      formatPrice(bodyCourse.price) +
      ' inkl. moms. Det samlede beløb og betalingsformen kan du se på købssiden, før du beslutter dig.',
  },
];
---

<Layout
  title={title}
  description={description}
  schema={schema}
  breadcrumbs={[{ name: 'Bliv glad for din krop', url: '/bliv-glad-for-din-krop/' }]}
>
  <div class="bk-sales">
    <section class="bk-hero" aria-labelledby="body-heading">
      <div class="container bk-hero-grid">
        <div>
          <nav class="breadcrumbs" aria-label="Brødkrummer">
            <a href="/">Forside</a><span>/</span><span>Bliv glad for din krop</span>
          </nav>
          <span class="eyebrow">Bliv glad for din krop · onlineforløb</span>
          <h1 id="body-heading">Slip kropskritikken. Uden først at skulle ændre din krop.</h1>
          <p class="bk-lead">
            Du kender stemmen. Den, der har en mening, hver gang du ser dig i spejlet. Den, der får
            dig til at vælge tøj, der skjuler, og til at sige nej til billeder.
          </p>
          <p>
            Hvad nu hvis vejen ud ikke er at ændre din krop, men at ændre dit forhold til den? Det
            arbejder vi med i Bliv glad for din krop.
          </p>
          <a
            class="button bk-purchase-link"
            href={bodyCourse.checkout}
            data-event="checkout_click"
            data-location="body_hero"
          >
            {bodyCourse.purchaseCta} <Icon size={18} />
          </a>
          <p class="bk-hero-note">
            Seks uger · Seks moduler · Livslang adgang · {formatPrice(bodyCourse.price)} inkl. moms
          </p>
          <p class="bk-separate">
            Individuelle samtaler om kropsaccept bestiller du separat. De er ikke med i prisen.
          </p>
        </div>
        <div class="bk-hero-visual">
          <img
            src="/images/ditte-portrait-hero.webp"
            srcset="/images/ditte-portrait-hero-small.webp 500w, /images/ditte-portrait-hero.webp 888w"
            sizes="(max-width: 900px) 90vw, 46vw"
            width="888"
            height="1110"
            alt="Psykolog Ditte Munch-Andersen smiler til kameraet"
            fetchpriority="high"
          />
          <div class="bk-hero-caption">
            <strong>Udviklet af psykolog Ditte Munch-Andersen</strong>
            <span>Seks moduler, der hjælper dig med at slippe skam, kropskritik og usikkerhed.</span>
          </div>
        </div>
      </div>
    </section>

    <section class="section bk-recognition" aria-labelledby="recognition-heading">
      <div class="container bk-two-column">
        <div>
          <span class="eyebrow">Måske kender du det</span>
          <h2 id="recognition-heading">Du har prøvet at gøre noget ved det. Det føles aldrig helt nok.</h2>
        </div>
        <div class="bk-reading">
          <p>
            Måske har du brugt mange år på at kæmpe med dit kropsbillede. Tankerne om, hvordan du ser
            ud. Om, hvad andre mon tænker. Om, hvad du burde gøre for at få det bedre.
          </p>
          <p>
            Måske har du prøvet at ændre din krop. Med kure, med træning eller med tøj, der skjuler
            det, du ikke kan lide. Og alligevel er det aldrig helt nok.
          </p>
          <p>
            Hvad hvis det ikke er din krop, der er problemet? Men den måde, du ser på den?
          </p>
        </div>
      </div>
      <div class="container bk-pattern-grid">
        <article>
          <span>01</span>
          <h3>Når du ser dig selv</h3>
          <p>Hvad lægger du først mærke til i spejlet? Og hvad sker der i dig bagefter?</p>
        </article>
        <article>
          <span>02</span>
          <h3>Når du skjuler dig</h3>
          <p>
            Tøj, der skal gemme. Billeder, du undgår. Situationer, du siger nej til. Hvad koster det
            dig?
          </p>
        </article>
        <article>
          <span>03</span>
          <h3>Når andre siger noget</h3>
          <p>
            En kommentar kan hænge ved i flere dage. Hvordan kan du stå fast uden at falde sammen?
          </p>
        </article>
      </div>
    </section>

    <section class="section bk-method" id="det-faar-du" aria-labelledby="method-heading">
      <div class="container bk-two-column">
        <div>
          <span class="eyebrow">Tilgangen</span>
          <h2 id="method-heading">Kropsaccept handler ikke om at give op. Det handler om frihed.</h2>
          <p class="bk-method-lead">
            Måske tænker du, at roen først kommer, den dag din krop har ændret sig. I forløbet
            kigger vi på den tanke. Og på, hvad den har kostet dig undervejs.
          </p>
          <p class="bk-method-lead">
            Jeg har arbejdet med forholdet til mad, krop og selvværd i mere end 20 år. Øvelserne i
            forløbet er værktøjer fra kognitiv terapi, som jeg bruger sammen med mine klienter.
          </p>
          <a
            class="button bk-purchase-link"
            href={bodyCourse.checkout}
            data-event="checkout_click"
            data-location="body_method"
          >
            {bodyCourse.purchaseCta} <Icon size={18} />
          </a>
        </div>
        <div class="bk-inclusions">
          <div>
            <Icon name="clock" size={25} />
            <div>
              <h3>Seks uger, seks moduler</h3>
              <p>
                Du får adgang til ét nyt modul hver 7. dag. Hvert modul bygger videre på det
                forrige, så du arbejder dig gradvist gennem de tanker og vaner, der står i vejen.
              </p>
            </div>
          </div>
          <div>
            <Icon name="heart" size={25} />
            <div>
              <h3>Konkrete værktøjer og strategier</h3>
              <p>
                Du får noget at gøre, ikke kun noget at forstå. Til selvsnakken, til skammen og til
                de situationer, hvor andre har meninger om din krop.
              </p>
            </div>
          </div>
          <div>
            <Icon name="shield" size={25} />
            <div>
              <h3>Livslang adgang</h3>
              <p>
                Kropsaccept er ikke noget, du bliver færdig med på seks uger. Materialet er dit
                bagefter, og du kan tage det frem igen, når du har brug for det.
              </p>
            </div>
          </div>
          <p class="bk-inclusions-note">
            Forløbet gennemfører du på egen hånd. Individuelle samtaler med mig er ikke
            inkluderet.
          </p>
        </div>
      </div>
    </section>

    <section class="section bk-modules" id="moduler" aria-labelledby="modules-heading">
      <div class="container">
        <div class="bk-section-heading">
          <span class="eyebrow">Sådan er forløbet bygget op</span>
          <h2 id="modules-heading">Fra tankerne om din krop til din plan for tiden efter.</h2>
          <p>
            Seks moduler, ét ad gangen. Du arbejder med ét tema, før det næste åbner.
          </p>
        </div>
        <ol class="bk-module-grid">
          {
            modules.map((module, index) => (
              <li>
                <span class="bk-module-number">Modul {index + 1}</span>
                <h3>{module.title}</h3>
                <p>{module.description}</p>
              </li>
            ))
          }
        </ol>
        <div class="bk-inline-action">
          <p>Du behøver ikke have det hele på plads fra dag ét. Du skal bare i gang.</p>
          <a
            class="button bk-purchase-link"
            href={bodyCourse.checkout}
            data-event="checkout_click"
            data-location="body_modules"
          >
            {bodyCourse.purchaseCta} <Icon size={18} />
          </a>
        </div>
      </div>
    </section>

    <section class="section bk-stories" id="erfaringer" aria-labelledby="stories-heading">
      <div class="container">
        <div class="bk-section-heading">
          <span class="eyebrow">Deltagernes erfaringer</span>
          <h2 id="stories-heading">Hvad siger tidligere deltagere?</h2>
          <p>Deres oplevelser er personlige. Din situation er din egen.</p>
        </div>
        <div class="bk-quote-grid">
          {
            stories.map((story) => (
              <figure>
                <blockquote>“{story.quote}”</blockquote>
                <figcaption>
                  {story.name}
                  <span>Deltager på Bliv glad for din krop</span>
                </figcaption>
              </figure>
            ))
          }
        </div>
        <p class="bk-source">
          Udtalelserne er hentet fra den tidligere salgsside for forløbet.
        </p>
      </div>
    </section>

    <section class="section bk-about" id="om-ditte" aria-labelledby="about-heading">
      <div class="container bk-about-grid">
        <div class="bk-about-image">
          <img
            src="/images/ditte-portrait.webp"
            srcset="/images/ditte-portrait-small.webp 500w, /images/ditte-portrait.webp 900w"
            sizes="(max-width: 800px) 88vw, 38vw"
            width="900"
            height="1600"
            loading="lazy"
            alt="Psykolog Ditte Munch-Andersen"
          />
        </div>
        <div class="bk-reading">
          <span class="eyebrow">Mennesket bag forløbet</span>
          <h2 id="about-heading">Hej, jeg er Ditte.</h2>
          <p>
            Jeg er psykolog og har i mere end 20 år arbejdet med forholdet til mad, krop og
            selvværd. Ikke med slankekure eller hurtige løsninger, men med metoder fra kognitiv
            terapi.
          </p>
          <p>
            Jeg har set, hvor meget tankerne om kroppen kan fylde i en hverdag. Og jeg ved, hvor
            stor en lettelse det kan være at slippe dem.
          </p>
          <ul class="checklist">
            <li>
              <Icon name="check" size={16} /> Cand.psych.aut., uddannet fra Københavns Universitet i
              2004
            </li>
            <li>
              <Icon name="check" size={16} /> MCT Institute® Registered – 2-årig international
              efteruddannelse i Metakognitiv Terapi fra The Metacognitive Therapy Institute (MCTI®)
              v. prof. Adrian Wells
            </li>
            <li>
              <Icon name="check" size={16} /> 2-årig efteruddannelse i Kognitiv Adfærdsterapi (KAT),
              Selskab for Adfærds- og Kognitiv Terapi (SAKT)
            </li>
          </ul>
          <a href="/om-ditte/" class="text-link">Læs om min faglige baggrund <Icon size={17} /></a>
        </div>
      </div>
    </section>

    <section class="section bk-fit" aria-labelledby="fit-heading">
      <div class="container bk-two-column">
        <div>
          <span class="eyebrow">Er forløbet noget for dig?</span>
          <h2 id="fit-heading">Det kan du forvente. Og det kan du ikke.</h2>
        </div>
        <div class="bk-reading">
          <p>
            Bliv glad for din krop er til dig, der gerne vil arbejde med kropskritik og selvbillede
            på egen hånd og i et tempo, der passer til dit liv. Du behøver ikke have alle svar,
            før du begynder.
          </p>
          <p>
            Jeg kan ikke love dig et bestemt resultat. Forskningen peger på, at indsatser, der
            udelukkende arbejder med kropsbilledet, i gennemsnit kan give en lille til moderat
            forbedring. Det viser en samlet gennemgang af 62 afprøvninger med i alt 3.846
            deltagere. Efter korrektion for skævheder i studierne var effekten stadig pålidelig,
            men lille.<sup><a href="#kilde-1" aria-label="Se kilde 1">1</a></sup> Gennemgangen
            handler om den slags indsatser i almindelighed og ikke om netop dette forløb.
          </p>
          <p>
            Forløbet er ikke behandling og erstatter ikke en faglig vurdering. Der er hverken
            kostplan eller vægtmål. Hvis du fremkalder opkastning, spiser meget restriktivt, har
            symptomer på anoreksi eller er bekymret for dit helbred, så tal med din egen læge.
          </p>
          <p>
            Vil du hellere tale med mig, kan du{' '}
            <a href="/kropsglaede/">bestille individuelle samtaler om kropsaccept</a>. Kæmper du
            mest med overspisning, kan du læse om{' '}
            <a href="/forloebet/">Successful Eating</a>.
          </p>
          <p class="bk-source" id="kilde-1">
            <sup>1</sup> Kilde: Alleva, J.M., Sheeran, P., Webb, T.L. m.fl. (2015). A meta-analytic
            review of stand-alone interventions to improve body image. <i>PLoS ONE, 10</i>(9),
            e0139177.{' '}
            <a href="https://doi.org/10.1371/journal.pone.0139177" rel="noopener">
              doi.org/10.1371/journal.pone.0139177
            </a>
          </p>
        </div>
      </div>
    </section>

    <section class="section bk-pricing" id="priser" aria-labelledby="price-heading">
      <div class="container bk-pricing-grid">
        <div>
          <span class="eyebrow">Pris og adgang</span>
          <h2 id="price-heading">Bliv glad for din krop for {formatPrice(bodyCourse.price)} inkl. moms.</h2>
          <p class="bk-lead">
            Seks uger, seks moduler og livslang adgang. Du betaler én gang, og materialet er dit at
            vende tilbage til.
          </p>
          <p>
            Har du brug for at tale med mig, kan du bestille individuelle samtaler som et separat
            tilbud.
          </p>
        </div>
        <div class="bk-price-card">
          <span class="eyebrow">Bliv glad for din krop · onlineforløb</span>
          <strong class="bk-price">{formatPrice(bodyCourse.price)}</strong>
          <span class="bk-vat">inkl. moms</span>
          <ul>
            <li><Icon name="check" size={18} /> Seks uger: ét nyt modul hver 7. dag</li>
            <li><Icon name="check" size={18} /> Værktøjer og strategier til dagligdagen</li>
            <li><Icon name="check" size={18} /> Livslang adgang til materialet</li>
          </ul>
          <p>Individuelle samtaler er ikke inkluderet.</p>
          <a
            class="button bk-purchase-link"
            href={bodyCourse.checkout}
            data-event="checkout_click"
            data-location="body_price"
          >
            {bodyCourse.purchaseCta} <Icon size={18} />
          </a>
          <small>Du fortsætter til en ekstern købsside.</small>
          <a href="/terms/" class="bk-terms-link">Læs handelsbetingelserne</a>
        </div>
      </div>
    </section>

    <section class="section faq-section" id="spoergsmaal">
      <div class="container faq-grid">
        <div class="faq-intro">
          <span class="eyebrow">Det må du gerne spørge om</span>
          <h2>Spørgsmål om Bliv glad for din krop</h2>
          <p>Her er svarene på det, de fleste vil vide, før de beslutter sig.</p>
          <a href="/kontakt" class="text-link">Spørg Ditte <Icon size={17} /></a>
        </div>
        <div class="faq-list">
          {
            faqs.map((faq) => (
              <details>
                <summary>{faq.question}</summary>
                <p>{faq.answer}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <section class="bk-final" aria-labelledby="final-heading">
      <div class="container">
        <span class="eyebrow">Et sted at begynde</span>
        <h2 id="final-heading">Du behøver ikke vente med at få det bedre i din krop. Du kan begynde i dag.</h2>
        <p>
          Forestil dig, hvordan det ville føles at slippe den konstante kropskritik. Det er det,
          du øver dig i gennem seks uger.
        </p>
        <a
          class="button bk-purchase-link"
          href={bodyCourse.checkout}
          data-event="checkout_click"
          data-location="body_final"
        >
          {bodyCourse.purchaseCta} <Icon size={18} />
        </a>
        <p class="bk-final-note">
          {formatPrice(bodyCourse.price)} inkl. moms · Livslang adgang · Samtaler bestilles separat
        </p>
      </div>
    </section>
  </div>
</Layout>

<style>
  .bk-sales { overflow: clip; }
  .bk-sales section[id] { scroll-margin-top: 120px; }
  .bk-sales .button { white-space: normal; }
  .bk-hero { background: var(--peach); padding-block: clamp(48px, 5vw, 76px); }
  .bk-hero-grid, .bk-two-column, .bk-about-grid, .bk-pricing-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr);
    gap: clamp(38px, 6vw, 92px);
    align-items: center;
  }
  .bk-hero .breadcrumbs { margin-bottom: 28px; }
  .bk-hero .eyebrow { margin-bottom: 12px; }
  .bk-hero h1 { max-width: 770px; font-size: clamp(2.7rem, 4.4vw, 4.5rem); overflow-wrap: normal; hyphens: none; }
  .bk-hero p { max-width: 650px; }
  .bk-lead { color: var(--ink); font-size: clamp(1.18rem, 1.7vw, 1.4rem); line-height: 1.65; }
  .bk-hero .bk-lead { margin-top: 24px; }
  .bk-purchase-link { margin-top: 24px; }
  .bk-hero-note, .bk-separate { font-size: .94rem; line-height: 1.5; }
  .bk-hero-note { margin-top: 19px; font-weight: 650; }
  .bk-separate { margin-top: 6px; color: var(--muted); }
  .bk-hero-visual { position: relative; align-self: stretch; display: grid; align-content: center; }
  .bk-hero-visual img { width: 100%; border-radius: 22px; aspect-ratio: 1 / .92; object-fit: cover; object-position: center 22%; }
  .bk-hero-caption { background: var(--white); border-radius: 16px; padding: 20px 24px; margin: -44px 24px 0; position: relative; box-shadow: 0 12px 35px #294c3d18; line-height: 1.4; }
  .bk-hero-caption strong, .bk-hero-caption span { display: block; }
  .bk-hero-caption span { color: var(--muted); font-size: .94rem; margin-top: 5px; }
  .bk-two-column { align-items: start; }
  .bk-two-column h2 { max-width: 620px; }
  .bk-reading { max-width: 670px; }
  .bk-reading p { line-height: 1.8; }
  .bk-reading h2 { margin-bottom: 24px; }
  .bk-reading a:not(.text-link) { text-decoration: underline; text-underline-offset: 3px; }
  .bk-reading sup a { text-decoration: none; padding-inline: 2px; }
  .bk-pattern-grid { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 18px; margin-top: 58px; }
  .bk-pattern-grid article, .bk-module-grid li { border: 1px solid var(--line); border-radius: 18px; padding: 27px; background: var(--white); }
  .bk-pattern-grid article span, .bk-module-number { color: var(--rust); font-size: .85rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .bk-pattern-grid h3 { margin: 12px 0; }
  .bk-method { background: var(--paper); }
  .bk-method-lead { margin-top: 26px; max-width: 580px; }
  .bk-method-lead + .bk-method-lead { margin-top: 16px; }
  .bk-inclusions { background: var(--white); border: 1px solid var(--line); border-radius: 22px; padding: clamp(25px, 4vw, 42px); }
