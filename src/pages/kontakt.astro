---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
---

<Layout
  title="Kontakt psykolog Ditte Munch-Andersen | Successful Eating"
  description="Book en gratis afklarende samtale på 15 minutter, eller skriv til Ditte Munch-Andersen. Psykologisk hjælp online og på Hovedvagtsstræde 2C i Helsingør."
  breadcrumbs={[{ name: 'Kontakt', url: '/kontakt' }]}
>
  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Brødkrummer">
        <a href="/">Forside</a>
        <span>/</span>
        <span>Kontakt</span>
      </nav>
      <span class="eyebrow">DET BEGYNDER MED EN SAMTALE</span>
      <h1>
        Du er velkommen.
        <br />
        Også med alle dine spørgsmål.
      </h1>
      <p class="intro">
        Du behøver ikke vide præcis, hvilken hjælp du har brug for. Vi kan begynde med at finde ud
        af det sammen.
      </p>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="contact-grid">
        <article class="contact-card contact-main">
          <Icon name="clock" size={30} />
          <h2>En gratis afklaring</h2>
          <p>
            15 uforpligtende minutter til dine spørgsmål og en snak om, hvad der kunne være dit
            næste skridt. Du vælger en ledig tid i kalenderen.
          </p>
          <a class="button" href={site.booking} data-event="booking_click" data-location="contact">
            Find en tid i kalenderen <Icon name="northeast" size={17} />
          </a>
          <p class="contact-note">
            Booking åbner i Google Kalender. Den gratis afklaring er ikke en klinisk vurdering eller
            behandling.
          </p>
        </article>
        <article class="contact-card">
          <Icon name="mail" size={30} />
          <h2>Foretrækker du at skrive?</h2>
          <p>
            Send en kort besked med dine praktiske spørgsmål. Jeg svarer normalt inden for 1–2
            hverdage.
          </p>
          <a
            class="text-link"
            style="margin-top:25px"
            href={`mailto:${site.email}`}
            data-event="email_click"
          >
            {site.email} <Icon name="northeast" size={17} />
          </a>
          <p style="margin-top:18px">
            <a href={`tel:${site.phone.replaceAll(' ', '')}`} data-event="phone_click">
              Ring: {site.phone}
            </a>
          </p>
          <p class="contact-note">
            Undlad CPR-nummer og følsomme helbredsoplysninger i almindelig e-mail. Vi aftaler en
            passende ramme, hvis du har brug for at dele mere.
          </p>
        </article>
        <article class="contact-card">
          <Icon name="pin" size={30} />
          <h2>Vi kan mødes i Helsingør</h2>
          <p>
            {site.person}
            <br />
            {site.address}
            <br />
            {site.city}
          </p>
          <a
            class="text-link"
            style="margin-top:25px"
            href="https://www.google.com/maps/search/?api=1&query=Hovedvagtsstr%C3%A6de+2C+3000+Helsing%C3%B8r"
          >
            Se vej til klinikken <Icon name="northeast" size={17} />
          </a>
          <p class="contact-note">
            Samtaler efter aftale. Skriv gerne på forhånd, hvis du har spørgsmål om adgangsforhold.
          </p>
        </article>
        <article class="contact-card">
          <Icon name="globe" size={30} />
          <h2>Eller online, dér hvor du er</h2>
          <p>
            Du kan få hjælp fra hele Danmark. Find et roligt sted med en stabil internetforbindelse,
            hvor du kan tale uforstyrret.
          </p>
          <a class="text-link" style="margin-top:25px" href="/forloebet">
            Læs om behandlingen <Icon size={17} />
          </a>
        </article>
      </div>
    </div>
  </section>
</Layout>
