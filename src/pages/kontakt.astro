---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { site, consultation, formatPrice } from '../data/site';

// Google Apps Script-webapp, der sender formularens indhold som e-mail til Ditte.
const contactFormUrl =
  'https://script.google.com/macros/s/AKfycbxYSvV0gGSpMdT5fysQ05lWqOC6RvdQHn1XaL9ukHs9UnsTIaleJiLYkgHxfVf3S-mG/exec';
---

<Layout
  title="Kontakt psykolog Ditte Munch-Andersen | Successful Eating"
  description={`Kontakt psykolog Ditte Munch-Andersen. Start med en forsamtale på ${site.consultationMinutes} minutter til ${formatPrice(site.consultationPrice)}, som modregnes, hvis du vælger Successful Eating.`}
  breadcrumbs={[{ name: 'Kontakt', url: '/kontakt' }]}
>
  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Brødkrummer">
        <a href="/">Forside</a>
        <span>/</span>
        <span>Kontakt</span>
      </nav>
      <span class="eyebrow">DET BEGYNDER MED EN SAMTALE</span>
      <h1>
        Du er velkommen.
        <br />
        Også med alle dine spørgsmål.
      </h1>
      <p class="intro">
        Du behøver ikke vide præcis, hvilken hjælp du har brug for. Vi kan begynde med at finde ud
        af det sammen.
      </p>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="contact-grid">
        <article class="contact-card contact-main">
          <Icon name="clock" size={30} />
          <h2>Begynd med en forsamtale</h2>
          <p>
            {site.consultationMinutes} minutter med Ditte til {formatPrice(site.consultationPrice)}{' '}
            Sammen undersøger I dine behov og vurderer, om Successful Eating passer til dig. Vælger
            du efterfølgende forløbet, modregnes hele beløbet i prisen på{' '}
            {formatPrice(site.treatmentPrice)}
          </p>
          {consultation.online && (
            <p class="contact-important">
              <strong>Vigtigt:</strong> Vælg <u>Successful Eating</u>, når du booker, så din
              forsamtale registreres rigtigt.
            </p>
          )}
          <a
            class="button"
            href={consultation.href}
            data-event={
              consultation.online
                ? 'consultation_booking_click'
                : 'consultation_request_email_click'
            }
            data-location="contact"
          >
            {consultation.online
              ? `Book forsamtale · ${formatPrice(site.consultationPrice)}`
              : 'Aftal forsamtale via e-mail'}{' '}
            <Icon name="northeast" size={17} />
          </a>
          <p class="contact-note">
            {consultation.online
              ? 'Du betaler forsamtalen med det samme via Stripe og kan bruge alle almindelige betalingskort. Vælger du forløbet bagefter, får du beløbet som rabat på forløbet.'
              : 'Din mail åbnes. Tid og betaling aftales med Ditte; et klik er ikke en booking.'}
          </p>
          <p class="contact-note">
            Køber du hele forløbet fra start, er forsamtalen gratis og inkluderet. Du får alle
            pengene tilbage, hvis forløbet ved forsamtalen vurderes at være et dårligt match.{' '}
            <a href="/forloebet#priser">Se de to muligheder.</a>
          </p>
        </article>
        <article class="contact-card" id="skriv">
          <Icon name="mail" size={30} />
          <h2>Foretrækker du at skrive?</h2>
          <p>
            Send en kort besked med dine praktiske spørgsmål. Jeg svarer normalt inden for 1–2
            hverdage.
          </p>
          <form
            class="contact-form"
            data-contact-form
            data-endpoint={contactFormUrl}
            data-phone={site.phone}
          >
            <label>
              Dit navn
              <input type="text" name="name" autocomplete="name" required maxlength="200" />
            </label>
            <label>
              Din e-mail
              <input type="email" name="email" autocomplete="email" required maxlength="200" />
            </label>
            <label>
              Din besked
              <textarea name="message" rows="6" required maxlength="5000"></textarea>
            </label>
            <div class="contact-form-trap" aria-hidden="true">
              <label>
                Lad dette felt være tomt
                <input type="text" name="website" tabindex="-1" autocomplete="off" />
              </label>
            </div>
            <button class="button" type="submit">
              Send besked <Icon name="northeast" size={17} />
            </button>
            <p class="contact-form-status" role="status" aria-live="polite" data-form-status></p>
            <p class="contact-note">
              Når du sender formularen, sendes din besked som e-mail via Google til Ditte. Læs mere
              i <a href="/privatliv">privatlivspolitikken</a>.
            </p>
          </form>
          <p style="margin-top:18px">
            <a href={`tel:${site.phone.replaceAll(' ', '')}`} data-event="phone_click">
              Ring: {site.phone}
            </a>
          </p>
          <p class="contact-note">
            Undlad CPR-nummer og følsomme helbredsoplysninger i beskeden. Vi aftaler en passende
            ramme, hvis du har brug for at dele mere.
          </p>
        </article>
        <article class="contact-card">
          <Icon name="pin" size={30} />
          <h2>Vi kan mødes i Helsingør</h2>
          <p>
            {site.person}
            <br />
            {site.address}
            <br />
            {site.city}
          </p>
          <a
            class="text-link"
            style="margin-top:25px"
            href="https://www.google.com/maps/search/?api=1&query=Hovedvagtsstr%C3%A6de+2C+3000+Helsing%C3%B8r"
          >
            Se vej til klinikken <Icon name="northeast" size={17} />
          </a>
          <p class="contact-note">
            Samtaler efter aftale. Skriv gerne på forhånd, hvis du har spørgsmål om adgangsforhold.
          </p>
        </article>
        <article class="contact-card">
          <Icon name="globe" size={30} />
          <h2>Eller online, dér hvor du er</h2>
          <p>
            Du kan få hjælp fra hele Danmark. Find et roligt sted med en stabil internetforbindelse,
            hvor du kan tale uforstyrret.
          </p>
          <a class="text-link" style="margin-top:25px" href="/forloebet">
            Læs om behandlingen <Icon size={17} />
          </a>
        </article>
      </div>
    </div>
  </section>
</Layout>

<style>
  .contact-card .contact-important {
    margin: 22px 0 0;
    padding: 14px 18px;
    border-left: 4px solid var(--rust);
    border-radius: 0 7px 7px 0;
    background: var(--white);
    color: var(--ink);
    font-size: var(--text-small);
  }
  .contact-important u {
    font-weight: 700;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }
  .contact-form {
    display: grid;
    gap: 16px;
    margin-top: 25px;
  }
  .contact-form label {
    display: grid;
    gap: 6px;
    font-size: var(--text-label);
    font-weight: 550;
    color: var(--ink);
  }
  .contact-form input,
  .contact-form textarea {
    width: 100%;
    border: 1px solid var(--line);
    border-radius: 7px;
    padding: 13px 15px;
    background: var(--paper);
    color: var(--ink);
    font: inherit;
    font-size: var(--text-small);
  }
  .contact-form textarea {
    min-height: 150px;
    resize: vertical;
  }
  .contact-form textarea:focus-visible {
    outline: 3px solid var(--rust);
    outline-offset: 5px;
  }
  .contact-form-trap {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .contact-form .button {
    margin-top: 0;
    justify-self: start;
  }
  .contact-form .button:disabled {
    opacity: 0.6;
    cursor: wait;
    transform: none;
  }
  .contact-form-status {
    margin: 0;
    min-height: 0;
    color: var(--ink);
    font-size: var(--text-small);
  }
  .contact-form-status[data-state='error'] {
    color: var(--rust);
  }
</style>

<script>
  const loadedAt = Date.now();
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  if (form) {
    const status = form.querySelector<HTMLElement>('[data-form-status]')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;
      button.disabled = true;
      status.dataset.state = 'pending';
      status.textContent = 'Sender …';
      try {
        const body = new URLSearchParams(new FormData(form) as unknown as Record<string, string>);
        body.set('elapsed', String(Date.now() - loadedAt));
        const response = await fetch(form.dataset.endpoint!, { method: 'POST', body });
        const result = await response.json();
        if (!result.ok) throw new Error('rejected');
        form.reset();
        status.dataset.state = 'success';
        status.textContent = 'Tak for din besked. Jeg svarer normalt inden for 1–2 hverdage.';
      } catch {
        status.dataset.state = 'error';
        status.textContent = `Beskeden kunne ikke sendes. Prøv igen, eller ring på ${form.dataset.phone}.`;
      } finally {
        button.disabled = false;
      }
    });
  }
</script>
