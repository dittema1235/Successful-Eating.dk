---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { site, formatPrice, bodyCourse } from '../data/site';

// Salgssiden for onlineforløbet Bliv glad for din krop ligger på /kropsglaede.
export function getStaticPaths() {
  return [{ params: { service: 'kropsglaede' } }];
}

const title = 'Bliv glad for din krop – onlineforløb om kropsaccept';
const description =
  'Bliv glad for din krop er et onlineforløb om kropsaccept: seks moduler over seks uger med 9 videoer og 15 øvelser. Livslang adgang. ' +
  formatPrice(bodyCourse.price) +
  ' inkl. moms. Af psykolog Ditte Munch-Andersen.';

const schema = {
  '@type': 'Course',
  '@id': site.url + '/kropsglaede/#course',
  name: bodyCourse.productName,
  description,
  inLanguage: 'da-DK',
  provider: { '@id': site.url + '/#organization' },
  offers: {
    '@type': 'Offer',
    url: new URL(bodyCourse.checkout, site.url).href,
    price: bodyCourse.price,
    priceCurrency: 'DKK',
    priceSpecification: {
      '@type': 'PriceSpecification',
      price: bodyCourse.price,
      priceCurrency: 'DKK',
      valueAddedTaxIncluded: true,
    },
  },
};

// Indhold, antal og varigheder er hentet fra selve kurset i Simplero (3. nov. 2026):
// Start her + 6 moduler, 34 lektioner, 9 videoer (i alt 3 t 53 min), 15 øvelser.
const modules = [
  {
    title: 'Om kropsbilledet',
    lead: 'Forstå, hvordan dit forhold til kroppen er blevet til.',
    description: [
      'Du finder frem til, hvor skoen trykker.',
      'Hvordan blev dit kropsbillede til, og hvilke perioder og episoder har formet dit forhold til din krop?',
      'Bagefter ser du på dine værdier og på, hvad du vil vælge aktivt til og fra fremover.',
    ],
    meta: '2 videoer · 36 minutter · 2 øvelser',
    exercises: ['Vær detektiv på dine kropsidealer og dit kropsbillede', 'Find dine værdier'],
  },
  {
    title: 'Sikkerhedsadfærd',
    lead: 'Opdag, hvad du gør for at skjule din krop – og hvad det koster dig.',
    description: [
      'Alt det, du gør for at skjule det, du ikke bryder dig om.',
      'Du lærer at spotte din adfærd, opdager dine triggere og øver dig i at gøre noget nyt.',
      'Du tager også fat på selvsnakken, altså den måde, du mobber din krop på.',
    ],
    meta: '2 videoer · 1 time og 5 minutter · 4 øvelser',
    exercises: [
      'Lav en liste over din sikkerhedsadfærd',
      'Opdag dine triggere',
      'Byg din plan',
      'Test teori A mod teori B',
    ],
  },
  {
    title: 'Bliv den bedste ven for din krop',
    lead: 'Begynd at skabe flere gode oplevelser.',
    description: [
      'I de første moduler lærer du at holde op med at mobbe din krop.',
      'Nu fylder du på med gode oplevelser.',
      'For helt ærligt: En god ven gør mere end bare at lade være med at kritisere dig non-stop.',
      'Du arbejder med at styrke din relation til kroppen og skabe mere plads til det, der er vigtigt for dig.',
    ],
    meta: '1 video · 13 minutter · 3 øvelser og en idéliste',
    exercises: ['Styrk din relation og dyrk dine værdier', 'Date dig selv (med idéliste til aktiviteter)'],
  },
  {
    title: 'Afmonter dine “sandheder” om dit udseende',
    lead: 'Udfordr de tanker, der fastholder dig i kropsskam.',
    description: [
      'Måske har du nogle “sandheder” med dig.',
      '“Hvis jeg tager med til den fest, vil alle lægge mærke til min krop og dømme mig.”',
      '“Hvis han ser mig nøgen, vil han aldrig tænde på mig igen.”',
      '“Hvis jeg stopper med at kritisere mine fejl, mister jeg al motivation.”',
      'Du lærer at opdage de tanker, der sætter kropsskammen i gang, og at arbejde med dine antagelser, regler og katastrofetanker.',
    ],
    meta: '2 videoer · 1 time og 8 minutter · 2 øvelser',
    exercises: [
      'Gå til dine antagelser og find en ny og mere hensigtsmæssig selvsnak',
      'Arbejd videre med dine planer fra modul 2',
    ],
  },
  {
    title: 'God kommunikation',
    lead: 'Bliv bedre til at sætte grænser og sige fra.',
    description: [
      'Indimellem er der nogen, der kommenterer din krop eller overskrider dine grænser.',
      'Her arbejder vi med kommunikation og grænsesætning, så du ved, hvad du kan sige, når situationen opstår.',
    ],
    meta: '1 video · 33 minutter · 2 øvelser',
    exercises: [
      'Forbered gode svar på ubehagelige spørgsmål',
      'Når du føler dig grænseoverskredet og har lyst til at sige fra',
    ],
  },
  {
    title: 'Sådan gør du fremover',
    lead: 'Lav en plan for at holde fast i det, du har arbejdet med.',
    description: [
      'Har du haft et anspændt forhold til din krop i mange år, kan det være let at falde tilbage i de gamle vaner.',
      'Derfor lægger du en plan for, hvad du vil arbejde med fremover, og hvordan du holder fast på den lange bane.',
    ],
    meta: '1 video · 18 minutter · 2 øvelser',
    exercises: ['3 måneders plan', 'Tilbagefaldsplan'],
  },
];

const stories = [
  {
    name: 'Louise',
    quote:
      'For første gang i mit liv kan jeg tage et billede uden at granske alle mine ‘fejl’. Det er en frihed, jeg ikke troede var mulig.',
  },
  {
    name: 'Maria',
    quote:
      'Jeg har kæmpet med mit kropsbillede i årevis, men det her forløb har hjulpet mig med at se min krop på en ny måde. Det føles som en kæmpe lettelse!',
  },
];

// Fire gratis blogindlæg om kropsbillede (uden henvisning til andre forløb eller vægttab).
const reads = [
  {
    href: '/blog/50565-hvordan-vil-det-vaere-at-hade-din-krop/',
    title: 'Når du er hård ved din krop: begynd med mindre kropskritik',
    text: 'Du behøver ikke elske din krop for at tage vare på den. Et mere neutralt sprog og ét lille hverdagsvalg, når kritikken fylder.',
  },
  {
    href: '/blog/50294-du-behoever-ikke-at-elske-din-krop/',
    title: 'Du behøver ikke at elske din krop',
    text: 'Ikke som en start i hvert fald. Om hvorfor små, realistiske skridt ofte virker bedre end at forsøge at elske sin krop.',
  },
  {
    href: '/blog/50433-har-du-et-problem-med-din-krop-eller-med/',
    title: 'Har du et problem med din krop - eller med dine tanker?',
    text: 'Hvad hvis det, du gerne vil ændre, slet ikke behøver at ændre sig, før du kan være tilfreds?',
  },
  {
    href: '/blog/54908-man-maa-vaelge-sine-kampe/',
    title: 'Man må vælge sine kampe',
    text: 'Hvad er et normalt kropsbillede? Og hvornår begynder det, du ikke kan lide ved dig selv, at fylde for meget?',
  },
];

const faqs = [
  {
    question: 'Hvad får jeg helt præcist?',
    answer: [
      'Du får adgang til ni videoer med knap fire timers undervisning fordelt på seks moduler.',
      'Derudover får du 15 øvelser, som hjælper dig med at omsætte undervisningen til dit eget liv.',
    ],
  },
  {
    question: 'Hvad skal jeg bruge for at komme i gang?',
    answer: [
      'Du skal have adgang til internettet og kunne afspille videoer.',
      'Til øvelserne kan du downloade og printe materialet eller bruge en almindelig notesbog.',
    ],
  },
  {
    question: 'Hvor lang tid tager det?',
    answer: [
      'Forløbet er tilrettelagt over seks uger.',
      'Du får adgang til ét nyt modul hver syvende dag.',
      'Videoerne varer tilsammen knap fire timer. Derudover skal du sætte tid af til øvelserne.',
    ],
  },
  {
    question: 'Hvor længe har jeg adgang?',
    answer: [
      'Du har livslang adgang til materialet.',
      'Du kan derfor vende tilbage til videoer og øvelser, når du har brug for det – også efter de seks uger.',
    ],
  },
  {
    question: 'Skal jeg tabe mig for at få noget ud af det?',
    answer: [
      'Nej.',
      'Forløbet handler ikke om vægttab, kostplaner eller vægtmål.',
      'Vi arbejder med den måde, du tænker om og forholder dig til din krop på.',
    ],
  },
  {
    question: 'Er forløbet en erstatning for psykologisk behandling?',
    answer: [
      'Nej.',
      'Bliv glad for din krop er et online selvstudieforløb og ikke psykologisk behandling.',
      'Hvis du har symptomer på en spiseforstyrrelse eller er bekymret for dit helbred, bør du tale med din egen læge.',
    ],
  },
  {
    question: 'Er samtaler med Ditte med i prisen?',
    answer: [
      'Nej.',
      'Forløbet gennemfører du på egen hånd.',
      'Hvis du ønsker individuelle samtaler med mig om kropsaccept, kan du bestille dem som et separat tilbud.',
    ],
  },
  {
    question: 'Hvad koster forløbet?',
    answer: [
      'Bliv glad for din krop koster ' + formatPrice(bodyCourse.price) + ' inkl. moms.',
      'Du betaler én gang og får livslang adgang til materialet.',
      'Individuelle samtaler er ikke inkluderet.',
    ],
  },
];
---

<Layout
  title={title}
  description={description}
  schema={schema}
  breadcrumbs={[{ name: 'Bliv glad for din krop', url: '/kropsglaede/' }]}
>
  <div class="bk-sales">
    <section class="bk-hero" aria-labelledby="body-heading">
      <div class="container bk-hero-grid">
        <div>
          <nav class="breadcrumbs" aria-label="Brødkrummer">
            <a href="/">Forside</a><span>/</span><span>Bliv glad for din krop</span>
          </nav>
          <span class="eyebrow">Bliv glad for din krop · onlineforløb</span>
          <h1 id="body-heading">Slip kropskritikken. Uden først at skulle ændre din krop.</h1>
          <p class="bk-lead">
            Du kender stemmen. Den, der har en mening, hver gang du ser dig i spejlet. Den, der får
            dig til at vælge tøj, der skjuler, og til at sige nej til billeder.
          </p>
          <p>
            Måske har du længe tænkt, at du først kan blive rigtig glad, når din krop ser anderledes
            ud.
          </p>
          <p>
            Men hvad nu, hvis vejen til mere frihed ikke handler om at ændre din krop, men om at
            ændre dit forhold til den?
          </p>
          <p>
            I Bliv glad for din krop får du et psykologfagligt onlineforløb med konkrete værktøjer
            til at arbejde med kropskritik, skam og usikkerhed.
          </p>
          <a
            class="button bk-purchase-link"
            href={bodyCourse.checkout}
            data-event="checkout_click"
            data-location="body_hero"
          >
            {bodyCourse.purchaseCta} <Icon size={18} />
          </a>
          <p class="bk-hero-note">
            6 uger · 9 videoer · 15 øvelser · Livslang adgang<br />
            {formatPrice(bodyCourse.price)} inkl. moms
          </p>
          <p class="bk-separate">
            Individuelle samtaler bestilles separat og er ikke inkluderet i prisen.
          </p>
        </div>
        <div class="bk-hero-visual">
          <img
            src="/images/ditte-portrait-hero.webp"
            srcset="/images/ditte-portrait-hero-small.webp 500w, /images/ditte-portrait-hero.webp 888w"
            sizes="(max-width: 900px) 90vw, 46vw"
            width="888"
            height="1110"
            alt="Psykolog Ditte Munch-Andersen smiler til kameraet"
            fetchpriority="high"
          />
          <div class="bk-hero-caption">
            <strong>Udviklet af psykolog Ditte Munch-Andersen</strong>
          </div>
        </div>
      </div>
    </section>

    <section class="section bk-recognition" aria-labelledby="recognition-heading">
      <div class="container bk-two-column">
        <div>
          <span class="eyebrow">Måske kender du det</span>
          <h2 id="recognition-heading">
            Du har måske prøvet at ændre din krop. Men det føles aldrig helt nok.
          </h2>
        </div>
        <div class="bk-reading">
          <p>Måske har du brugt mange år på at kæmpe med dit kropsbillede.</p>
          <p>
            Tankerne om, hvordan du ser ud. Om, hvad andre mon tænker. Om, hvad du burde gøre for at
            få det bedre.
          </p>
          <p>Måske har du prøvet at ændre din krop med kure, træning eller nye kostvaner.</p>
          <p>
            Eller måske har du udviklet en hel række strategier for at skjule de dele af kroppen, du
            ikke bryder dig om.
          </p>
          <p>Men selv når du gør alt det rigtige, dukker utilfredsheden op igen.</p>
          <p><strong>Måske kan du genkende nogle af disse situationer:</strong></p>
        </div>
      </div>
      <div class="container bk-pattern-grid">
        <article>
          <span>01</span>
          <h3>Når du ser dig selv</h3>
          <p>
            Du kigger i spejlet og lægger straks mærke til det, du ikke kan lide. Maven, lårene,
            armene eller noget helt andet.
          </p>
          <p>Det kan påvirke dit humør og din måde at være i verden på.</p>
        </article>
        <article>
          <span>02</span>
          <h3>Når du skjuler dig</h3>
          <p>
            Du vælger tøj, der skal gemme din krop. Du undgår billeder eller siger nej til
            situationer, hvor du føler dig utilpas med dit udseende.
          </p>
          <p>Men hvad koster det dig at bruge så meget energi på at skjule dig?</p>
        </article>
        <article>
          <span>03</span>
          <h3>Når andre siger noget</h3>
          <p>En kommentar om din krop kan hænge ved i flere dage.</p>
          <p>
            Du tænker over, hvad personen mente, om vedkommende havde ret, og hvad du burde have
            svaret.
          </p>
          <p>Det kan være svært at stå fast, når usikkerheden rammer.</p>
        </article>
      </div>
      <div class="container bk-recognition-close">
        <div class="bk-reading">
          <p>Måske er det værd at stille dig selv et andet spørgsmål:</p>
          <p class="bk-question">
            Hvad nu, hvis det ikke er din krop, der er problemet, men den måde, du har lært at se på
            den?
          </p>
          <p>
            Du behøver ikke vente på, at din krop ændrer sig, før du begynder at arbejde med dit
            forhold til den.
          </p>
          <a
            class="button bk-purchase-link"
            href={bodyCourse.checkout}
            data-event="checkout_click"
            data-location="body_recognition"
          >
            {bodyCourse.purchaseCta} <Icon size={18} />
          </a>
        </div>
      </div>
    </section>

    <section class="section bk-future" aria-labelledby="future-heading">
      <div class="container bk-two-column">
        <div>
          <span class="eyebrow">Forestil dig</span>
          <h2 id="future-heading">Forestil dig, hvis …</h2>
          <p class="bk-method-lead">
            Du ikke længere skulle bruge så meget tid og energi på at tænke over din krop.
          </p>
        </div>
        <div class="bk-reading">
          <p><strong>Forestil dig, hvis du kunne:</strong></p>
          <ul class="checklist">
            <li>
              <Icon name="check" size={16} /> Se dig selv i spejlet uden automatisk at lede efter
              fejl.
            </li>
            <li>
              <Icon name="check" size={16} /> Vælge tøj ud fra, hvad du har lyst til at have på, i
              stedet for hvad der skjuler din krop.
            </li>
            <li>
              <Icon name="check" size={16} /> Være med på billeder uden bagefter at granske alle
              dine fejl.
            </li>
            <li>
              <Icon name="check" size={16} /> Tage til stranden eller være intim med din partner
              uden hele tiden at være optaget af, hvordan din krop ser ud.
            </li>
            <li>
              <Icon name="check" size={16} /> Deltage i sociale aktiviteter med mere opmærksomhed på
              oplevelsen end på dit udseende.
            </li>
            <li><Icon name="check" size={16} /> Møde dig selv med større venlighed og respekt.</li>
          </ul>
          <p>Det handler ikke om, at du skal elske alt ved din krop.</p>
          <p>
            Det handler om, at din krop ikke skal fylde så meget i dine tanker, at den begrænser dit
            liv.
          </p>
          <p>Du kan begynde at arbejde med dit forhold til kroppen, som den er lige nu.</p>
          <a
            class="button bk-purchase-link"
            href={bodyCourse.checkout}
            data-event="checkout_click"
            data-location="body_future"
          >
            {bodyCourse.purchaseCta} <Icon size={18} />
          </a>
        </div>
      </div>
    </section>

    <section class="bk-oneliner" aria-label="Så er du landet det rigtige sted">
      <div class="container">
        <p>Så er du landet det helt rigtige sted.</p>
      </div>
    </section>

    <section class="section bk-method" aria-labelledby="method-heading">
      <div class="container bk-two-column">
        <div>
          <span class="eyebrow">Introduktion til forløbet</span>
          <h2 id="method-heading">Introduktion til Bliv glad for din krop</h2>
          <p class="bk-method-lead">
            Et psykologfagligt onlineforløb, der hjælper dig med at arbejde med kropskritik, skam og
            usikkerhed – så du kan få et friere og mere afslappet forhold til din krop.
          </p>
        </div>
        <div class="bk-reading">
          <h3>Kropsaccept handler ikke om at give op. Det handler om frihed.</h3>
          <p>Måske tænker du, at roen først kommer den dag, din krop har ændret sig.</p>
          <p>
            At du først kan gå i det tøj, du gerne vil, tage på stranden eller være med på billeder,
            når du har tabt dig eller ændret dit udseende.
          </p>
          <p>Men hvad har det kostet dig at vente?</p>
          <p>
            I Bliv glad for din krop arbejder vi med den tanke. Og med, hvad den har betydet for dit
            liv indtil nu.
          </p>
          <p>
            Du lærer at opdage de tanker og handlinger, der fastholder dig i kropskritik og
            utilfredshed.
          </p>
          <p>
            Du arbejder blandt andet med sikkerhedsadfærd, negative tanker, antagelser og nye måder
            at forholde dig til din krop på.
          </p>
          <p>
            Tanken er, at du ikke bare skal slutte fred med din krop, men også begynde at skabe
            plads til flere gode oplevelser og større glæde i dit liv.
          </p>
          <p>Jeg har arbejdet med forholdet til mad, krop og selvværd i mere end 20 år.</p>
          <p>
            Øvelserne i forløbet bygger på værktøjer fra kognitiv terapi, som jeg også bruger sammen
            med mine klienter.
          </p>
          <a
            class="button bk-purchase-link"
            href={bodyCourse.checkout}
            data-event="checkout_click"
            data-location="body_method"
          >
            {bodyCourse.purchaseCta} <Icon size={18} />
          </a>
        </div>
      </div>
    </section>

    <section class="section bk-gets" id="det-faar-du" aria-labelledby="gets-heading">
      <div class="container bk-two-column">
        <div>
          <span class="eyebrow">Det får du</span>
          <h2 id="gets-heading">
            Et samlet forløb med konkrete værktøjer til at ændre dit forhold til din krop
          </h2>
          <p class="bk-method-lead">
            Når du køber Bliv glad for din krop, får du et struktureret onlineforløb, hvor du trin
            for trin arbejder med de tanker og handlinger, der påvirker dit kropsbillede.
          </p>
          <a
            class="button bk-purchase-link"
            href={bodyCourse.checkout}
            data-event="checkout_click"
            data-location="body_gets"
          >
            {bodyCourse.purchaseCta} <Icon size={18} />
          </a>
        </div>
        <div class="bk-inclusions">
          <div>
            <Icon name="book" size={25} />
            <div>
              <h3>9 videoer med knap fire timers undervisning</h3>
              <p>
                Undervisningen er fordelt på seks moduler. Du får viden om, hvordan kropsbilledet
                opstår, hvordan du arbejder med sikkerhedsadfærd og negative tanker, og hvordan du
                holder fast i det, du lærer.
              </p>
            </div>
          </div>
          <div>
            <Icon name="heart" size={25} />
            <div>
              <h3>15 øvelser, så du får brugt det, du lærer</h3>
              <p>
                Du får konkrete øvelser, der hjælper dig med at omsætte undervisningen til dit eget
                liv. Du kan downloade og printe dem eller bruge en almindelig notesbog. Jeg
                anbefaler, at du laver øvelserne for at få det fulde udbytte.
              </p>
            </div>
          </div>
          <div>
            <Icon name="clock" size={25} />
            <div>
              <h3>Start her og seks moduler over seks uger</h3>
              <p>
                Du begynder med en velkomst og et overblik over forløbet. Derefter får du adgang til
                ét nyt modul hver syvende dag. Hvert modul bygger videre på det forrige.
              </p>
            </div>
          </div>
          <div>
            <Icon name="shield" size={25} />
            <div>
              <h3>Dit eget tempo og livslang adgang</h3>
              <p>
                Forløbet er dit. Du kan gå tilbage til videoer og øvelser, når du har brug for det –
                også efter de seks uger.
              </p>
            </div>
          </div>
          <p class="bk-inclusions-note">
            Du gennemfører forløbet på egen hånd. Individuelle samtaler med mig er ikke inkluderet i
            prisen.
          </p>
        </div>
      </div>
    </section>

    <section class="section bk-modules" id="moduler" aria-labelledby="modules-heading">
      <div class="container">
        <div class="bk-section-heading">
          <span class="eyebrow">Sådan er forløbet bygget op</span>
          <h2 id="modules-heading">Fra tankerne om din krop til din plan for tiden efter.</h2>
          <p>
            Du arbejder med seks moduler, ét ad gangen. Hvert modul består af en kort introduktion,
            en eller to videoer og øvelser. Du får mulighed for at fordybe dig i ét tema, før det
            næste modul åbner.
          </p>
        </div>
        <div class="bk-start">
          <span class="bk-module-number">Start her</span>
          <p>
            Før det første modul får du en velkomst, en gennemgang af programmets opbygning og en
            oversigt over, hvad du får brug for.
          </p>
        </div>
        <ol class="bk-module-grid">
          {
            modules.map((module, index) => (
              <li>
                <span class="bk-module-number">Modul {index + 1}</span>
