---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import FAQ from '../components/FAQ.astro';
import CTA from '../components/CTA.astro';
import PurchaseOptions from '../components/PurchaseOptions.astro';
import ParticipantTestimonials from '../components/ParticipantTestimonials.astro';
import { site, services, formatPrice, treatmentModules } from '../data/site';
export function getStaticPaths() {
  return services.map((service) => ({ params: { service: service.slug }, props: { service } }));
}
const { service } = Astro.props;
const body = service.slug === 'kropsglaede';
const title = body
  ? 'Kropsaccept: individuel psykologisk behandling | Successful Eating'
  : 'Behandling af overspisning (BED) online | Successful Eating';
const heading = body
  ? 'Mindre kropskritik. Mere plads til at være dig.'
  : 'Behandling af overspisning online';
const schema = {
  '@type': 'Service',
  '@id': `${site.url}/${service.slug}#service`,
  name: body ? service.title : 'Successful Eating – behandling af overspisning online',
  description: service.intro,
  provider: { '@id': `${site.url}/#organization` },
  areaServed: { '@type': 'Country', name: 'Danmark' },
  serviceType: body
    ? 'Individuel psykologisk behandling med fokus på kropsaccept'
    : 'Kognitiv behandling af overspisning',
  url: `${site.url}/${service.slug}`,
  ...(!body
    ? {
        offers: {
          '@type': 'Offer',
          price: site.treatmentPrice,
          priceCurrency: 'DKK',
          url: site.checkout,
          description:
            'Otte ugers behandlingsforløb inklusive gratis individuel forsamtale. Alle pengene tilbage, hvis forløbet ved forsamtalen vurderes at være et dårligt match.',
        },
      }
    : {}),
};
---

<Layout
  title={title}
  description={
    body
      ? `${service.intro} Online i hele Danmark hos psykolog Ditte Munch-Andersen.`
      : `Online behandling af overspisning hos klinisk psykolog Ditte Munch-Andersen: 8 moduler, live gruppebehandling og forsamtale. Pris ${formatPrice(site.treatmentPrice)}`
  }
  schema={schema}
  breadcrumbs={[{ name: service.title, url: `/${service.slug}` }]}
>
  <section class={`page-hero tone-${service.tone}`}>
    <div class="container">
      <nav class="breadcrumbs" aria-label="Brødkrummer">
        <a href="/">Forside</a>
        <span>/</span>
        <span>{service.title}</span>
      </nav>
      <div class:list={{ 'treatment-hero': !body }}>
        <div>
          <span class="eyebrow">{service.tag} · Online i hele Danmark</span>
          <h1>{heading}</h1>
          <p class="intro">
            {body
              ? service.intro
              : 'Otte uger med psykolog Ditte Munch-Andersen, en lille gruppe og konkrete øvelser. Få støtte til at forstå din overspisning og arbejde mod mere madro.'}
          </p>
          <div class="actions">
            <a
              href={body ? '/kontakt' : '#priser'}
              class="button"
              data-event={body ? 'contact_click' : 'pricing_click'}
              data-location={service.slug}
            >
              {body ? 'Tal med Ditte om kropsaccept' : 'Se pris og tilmelding'} <Icon size={18} />
            </a>
            <a href={body ? '#om-forloebet' : '#det-faar-du'} class="text-link">
              {body ? 'Læs om behandlingen' : 'Det får du i forløbet'} <Icon size={17} />
            </a>
          </div>
          <p class="hero-note">
            {body
              ? 'Individuelle rammer · Plads til dine spørgsmål'
              : `${formatPrice(site.treatmentPrice)} inkl. gratis forsamtale · Eller start med ${site.consultationMinutes} minutter til ${formatPrice(site.consultationPrice)}`}
          </p>
        </div>
        {!body && (
          <figure class="treatment-person">
            <img
              src="/images/ditte-underviser.webp"
              alt="Ditte Munch-Andersen underviser ved en tavle"
              width="685"
              height="586"
            />
            <figcaption>
              <strong>Ditte Munch-Andersen</strong>
              <span>Klinisk psykolog · Uddannet fra Københavns Universitet i 2004</span>
              <a href="/om-ditte">
                Mød din behandler <Icon size={16} />
              </a>
            </figcaption>
          </figure>
        )}
      </div>
    </div>
  </section>
  {!body && (
    <section class="section treatment-overview" id="det-faar-du" aria-labelledby="overview-heading">
      <div class="container">
        <nav class="treatment-links" aria-label="Find rundt i forløbet">
          <a href="#det-faar-du">Indhold</a>
          <a href="#moduler">De 8 moduler</a>
          <a href="#om-forloebet">Er det noget for mig?</a>
          <a href="#priser">Pris & tilmelding</a>
          <a href="#spoergsmaal">Spørgsmål & svar</a>
        </nav>
        <span class="eyebrow">FAGLIG STØTTE. PLADS TIL DIN HVERDAG.</span>
        <h2 id="overview-heading">Det får du i Successful Eating</h2>
        <div class="treatment-inclusions">
          <article>
            <Icon name="shield" size={28} />
            <h3>Individuel forsamtale</h3>
            <p>Du og Ditte vurderer sammen, om forløbet passer til dine behov.</p>
          </article>
          <article>
            <Icon name="heart" size={28} />
            <h3>4 live gruppesamtaler</h3>
            <p>Online med højst 6 deltagere. Samtalerne optages ikke.</p>
          </article>
          <article>
            <Icon name="book" size={28} />
            <h3>8 psykologiske moduler</h3>
            <p>Fra kroppens signaler og madtrang til følelser, kropsro og nye mønstre.</p>
          </article>
          <article>
            <Icon name="leaf" size={28} />
            <h3>Øvelser til hverdagen</h3>
            <p>Korte, daglige øvelser og materiale til at arbejde videre efter forløbet.</p>
          </article>
        </div>
      </div>
    </section>
  )}
  {!body && (
    <section class="section module-section" id="moduler" aria-labelledby="module-heading">
      <div class="container">
        <div class="module-intro">
          <span class="eyebrow">TRIN FOR TRIN MOD MERE MADRO</span>
          <h2 id="module-heading">De 8 moduler i Successful Eating</h2>
          <p>
            Du bevæger dig fra at forstå kroppens signaler og dine overspisningsmønstre til at kunne
            håndtere følelser, tilbagefald og tiden efter forløbet. Modulerne giver retning, mens
            øvelserne og samtalerne hjælper dig med at omsætte indholdet i din hverdag.
          </p>
        </div>
        <ol class="module-list">
          {treatmentModules.map((module, index) => (
            <li>
              <article>
                <span class="module-number">Modul {index + 1}</span>
                <h3>{module.title}</h3>
                <p>{module.description}</p>
              </article>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}
  {!body && (
    <ParticipantTestimonials
      ids={['mai', 'jette', 'christina']}
      tone="sage"
      eyebrow="ERFARINGER MED FORLØBET"
      heading="Når nye mønstre kan mærkes i hverdagen"
      intro="Tidligere deltagere fortæller om mere frihed i situationer med mad, mere ro og et forløb, der giver mening."
      showResultsLink
    />
  )}
  {!body && <PurchaseOptions />}
  <section class="section" id="om-forloebet">
    <div class="container content-grid">
      <div class="prose">
        <h2>{body ? 'Et andet forhold til din krop' : 'Du skal ikke finde vej alene.'}</h2>
        <p>
          {body
            ? 'Når spejlet, tøjet eller tankerne om din krop bliver en daglig kamp, kan det påvirke både din trivsel og de ting, du har lyst til at gøre. Et individuelt behandlingsforløb giver plads til at undersøge selvkritik, skam og de mønstre, der vedligeholder ubehaget.'
            : 'Hvis overspisning, selvkritik og tanker om mad fylder i din hverdag, kan psykologisk behandling være relevant. Vi undersøger sammen, hvad der udløser og vedligeholder dine mønstre, og arbejder med kognitive redskaber, som kan bruges i dit eget liv.'}
        </p>
        <h2>Hvem er tilbuddet relevant for?</h2>
        <p>
          Tilbuddet er til dig, der oplever, at{' '}
          {body ? 'tanker om din krop og dit udseende' : 'overspisning og tanker om mad'} påvirker
          din trivsel. Du behøver ikke kunne forklare alt på forhånd.
        </p>
        <ul>
          {body ? (
            <>
              <li>Du bruger meget opmærksomhed på at vurdere eller kontrollere din krop.</li>
              <li>
                Skam og selvkritik får dig til at undgå situationer, du gerne ville deltage i.
              </li>
              <li>
                Du ønsker støtte til at arbejde med dit kropsbillede, uden at vægttab bliver målet.
              </li>
            </>
          ) : (
            <>
              <li>
                Du oplever tilbagevendende overspisning eller føler, at du mister kontrollen over
                din spisning.
              </li>
              <li>Madregler, skyld eller bekymringer tager meget af din opmærksomhed.</li>
              <li>
                Du ønsker støtte til at forstå dine mønstre og afprøve andre måder at håndtere dem
                på.
              </li>
            </>
          )}
        </ul>
        <h2>Det arbejder vi med</h2>
        <p>
          Tilgangen tager afsæt i kognitiv adfærdsterapi. Vi ser på samspillet mellem tanker,
          følelser, handlinger og din hverdag. Indholdet tilpasses efter en vurdering af dine behov.
        </p>
        {body ? (
          <>
            <p>
              Behandlingen foregår én til én med Ditte. Vi undersøger blandt andet, hvordan
              kropskritik påvirker dine handlinger, og arbejder med terapeutiske øvelser mellem
              samtalerne. Formålet er mindre belastning og mere handlefrihed i dit liv.
            </p>
            <p>
              Det er ikke et krav, at du skal elske din krop eller føle dig positiv hele tiden. Vi
              tager udgangspunkt i det, der er svært for dig, og finder realistiske skridt.
            </p>
          </>
        ) : (
          <>
            <p>
              Successful Eating er et otte ugers behandlingsforløb med personlig behandlerkontakt.
              Digitale oplæg og terapeutiske øvelser understøtter arbejdet i samtalerne.
            </p>
            <ul>
              <li>
                En individuel klinisk forsamtale, hvor vi vurderer, om behandlingen er det rette
                match.
              </li>
              <li>
                Fire live online gruppebehandlinger med højst seks deltagere. Samtalerne optages
                ikke.
              </li>
              <li>Otte psykologiske moduler som støtte til behandlingen.</li>
              <li>Korte, daglige terapeutiske øvelser, der kan afprøves i din hverdag.</li>
              <li>Materiale til vedligeholdelse og tilbagefaldsforebyggelse efter forløbet.</li>
            </ul>
            <section class="adhd-focus" aria-labelledby="adhd-focus-heading">
              <span class="eyebrow">AFPRØVET I PRAKSIS</span>
              <h2 id="adhd-focus-heading">ADHD er indtænkt i Successful Eating.</h2>
              <p>
                Jeg har gennem de sidste mange år haft mange kvinder med ADHD/ADD på Successful
                Eating. Deres erfaringer og fremskridt er en del af den kliniske erfaring, som
                forløbets opbygning og struktur er formet af.
              </p>
              <p>
                Forskning viser samtidig en tydelig sammenhæng mellem ADHD og spiseforstyrrelser. I
                en meta-analyse af 12 studier var odds for BED cirka fire gange højere blandt
                personer med ADHD. Udfordringer med impulskontrol, struktur og regulering kan derfor
                inddrages konkret i behandlingen af din overspisning.
              </p>
              <p>
                Successful Eating er et behandlingsforløb for overspisning, hvor ADHD er tænkt ind.
                Forløbet erstatter ikke en ADHD-udredning eller medicinsk behandling.
              </p>
              <p class="adhd-links">
                <a href="/madro-biblioteket/adhd-og-overspisning">Læs om ADHD og overspisning</a>
                <span aria-hidden="true">·</span>
                <a href="https://doi.org/10.1002/eat.22643">
                  Nazar et al. (2016), International Journal of Eating Disorders
                </a>
              </p>
            </section>
          </>
        )}
        <h2>Pris, indhold og opstart</h2>
        {body ? (
          <p>
            Kontakt Ditte for en aktuel samlet pris og beskrivelse af dit individuelle forløb,
            herunder antal samtaler, varighed og eventuelle tilkøb. Du får oplysningerne, før du
            beslutter dig. Forløbet indledes med en klinisk forsamtale.
          </p>
        ) : (
          <>
            <p>
              Forløbet koster {formatPrice(site.treatmentPrice)} inklusive en gratis individuel
              klinisk forsamtale. Vurderes forløbet ved forsamtalen at være et dårligt match, får du
              alle pengene tilbage.
            </p>
            <p>
              Du kan også starte med at købe en forsamtale på {site.consultationMinutes} minutter
              til {formatPrice(site.consultationPrice)} Vælger du efterfølgende at deltage i
              forløbet, modregnes hele beløbet. Du betaler da{' '}
              {formatPrice(site.treatmentPrice - site.consultationPrice)}
              mere – {formatPrice(site.treatmentPrice)} i alt. Behandlingen starter efter
              forsamtalen, når vi har vurderet, at den passer til din situation.
            </p>
            <a
              class="button"
              href={site.checkout}
              data-event="checkout_click"
              data-location="service_body"
            >
              Køb forløbet · {formatPrice(site.treatmentPrice)} <Icon name="northeast" size={17} />
            </a>
          </>
        )}
        <div class="callout">
          <p>
            <strong>Har du praktiske spørgsmål først?</strong> Du er velkommen til at
            <a href="/kontakt">kontakte Ditte</a> om indhold, opstart og rammer.
          </p>
        </div>
        <h2>Mulighed for tilskud</h2>
        <p>
          Der kan være mulighed for tilskud til psykologsamtaler gennem Sygeforsikringen “danmark”
          eller en privat sundhedsforsikring. Det afhænger blandt andet af dine vilkår og den
          faglige vurdering. Kontakt din forsikring før tilmelding; tilskud kan ikke garanteres.
        </p>
        <h2>Den rette hjælp til din situation</h2>
        <p>
          {body
            ? 'Stærk kropskritik kan indgå i forskellige psykiske vanskeligheder. Derfor begynder behandlingen med en individuel vurdering.'
            : 'En overspisning er ikke i sig selv en diagnose. Gentagne episoder med kontroltab og betydelig belastning kan være tegn på binge eating disorder (BED) eller andre vanskeligheder, som kræver faglig vurdering.'}{' '}
          Hvis anden eller mere specialiseret hjælp er relevant, taler vi om det.
        </p>
        <p>
          Har du fysiske symptomer, opkastning, udtalt restriktiv spisning eller er bekymret for dit
          helbred, bør du også kontakte din egen læge. Generel information kan ikke erstatte en
          individuel vurdering.
        </p>
        <p class="sources">
          Fagligt udgangspunkt:{' '}
          <a href="https://www.nice.org.uk/guidance/ng69">
            NICE's retningslinje for spiseforstyrrelser
          </a>
          . Retningslinjen dokumenterer ikke en bestemt effekt af Successful Eating. Læs om{' '}
          <a href="/resultater">metode og resultater</a>.
        </p>
      </div>
      <aside class="facts-card" aria-label="Kort om tilbuddet">
        <span class="eyebrow">PRAKTISK & OVERSKUELIGT</span>
        <h2>{service.title}</h2>
        <dl>
          <dt>Behandler</dt>
          <dd>
            <a href="/om-ditte">Ditte Munch-Andersen, klinisk psykolog</a>
          </dd>
          <dt>Format</dt>
          <dd>
            {body ? 'Individuelle samtaler online' : 'Live online behandling · Maks. 6 i gruppen'}
          </dd>
          <dt>Målgruppe</dt>
          <dd>{service.tag}</dd>
          <dt>Varighed</dt>
          <dd>{body ? 'Aftales ved den kliniske forsamtale' : '8 uger'}</dd>
          <dt>Samlet pris</dt>
          <dd>
            {body
              ? 'Oplyses før aftale'
              : `${site.treatmentPrice.toLocaleString('da-DK')} kr. ved samlet betaling`}
          </dd>
          <dt>Før behandling</dt>
          <dd>Individuel klinisk forsamtale</dd>
        </dl>
        <a
          class="button"
          href={body ? '/kontakt' : site.checkout}
          data-event={body ? 'contact_click' : 'checkout_click'}
          data-location="service_facts"
        >
          {body ? 'Lad os tale sammen' : `Køb forløbet · ${formatPrice(site.treatmentPrice)}`}{' '}
          <Icon name="northeast" size={17} />
        </a>
        <p class="small muted">
          {body
            ? 'Kontakt Ditte for pris og individuelle rammer.'
            : 'Gratis forsamtale inkluderet. Alle pengene tilbage, hvis forløbet ved forsamtalen vurderes at være et dårligt match.'}
        </p>
      </aside>
    </div>
  </section>
  <section class="section courses-section">
    <div class="container">
      <span class="eyebrow">SÅDAN KOMMER DU I GANG</span>
      <h2>
        Fra første spørgsmål
        <br />
        til dit næste skridt.
      </h2>
      <div class="steps">
        <div>
          <div class="step-number">01</div>
          <h3>Få overblik</h3>
          <p>
            Læs om behandlingen og vilkårene. Du er velkommen til at spørge Ditte, hvis du er i
            tvivl.
          </p>
        </div>
        <div>
          <div class="step-number">02</div>
          <h3>En klinisk forsamtale</h3>
          <p>Vi undersøger dine behov og vurderer sammen, om behandlingen er det rette match.</p>
        </div>
        <div>
          <div class="step-number">03</div>
          <h3>Behandling med støtte</h3>
          <p>
            Ved et behandlingsmatch aftaler vi rammerne og går i gang. Der er plads til at lære og
            øve sig.
          </p>
        </div>
      </div>
    </div>
  </section>
  <FAQ />
  <CTA body={body} purchase={!body} />
</Layout>

<style>
  .treatment-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 0.8fr);
    gap: clamp(30px, 5vw, 70px);
    align-items: center;
  }
  .treatment-hero h1 {
    font-size: clamp(2.5rem, 4.1vw, 3.75rem);
    hyphens: manual;
  }
  .treatment-person {
    margin: 0;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 70px 8px 8px 8px;
    overflow: hidden;
  }
  .treatment-person img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  figcaption {
    padding: 22px;
  }
  figcaption strong,
  figcaption span {
    display: block;
  }
  figcaption span {
    font-size: var(--text-small);
    color: var(--muted);
    margin-top: 4px;
  }
  figcaption a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: var(--text-small);
    text-decoration: underline;
    text-underline-offset: 4px;
    margin-top: 14px;
  }
  .treatment-overview {
    padding-block: 40px 65px;
  }
  .treatment-links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
    border-bottom: 1px solid var(--line);
    padding-bottom: 24px;
    margin-bottom: 40px;
  }
  .treatment-links a {
    font-size: var(--text-small);
    padding-block: 8px;
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .treatment-inclusions {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 28px;
    margin-top: 35px;
  }
  .treatment-inclusions article {
    border-top: 2px solid var(--sage-deep);
    padding-top: 24px;
  }
  .treatment-inclusions h3 {
    font-size: 1.5rem;
    margin: 16px 0 12px;
  }
  .treatment-inclusions p {
    color: var(--muted);
  }
  .module-section {
    background: var(--sand);
  }
  .module-intro {
    max-width: 760px;
  }
  .module-intro h2 {
    margin: 12px 0 18px;
  }
  .module-intro p {
    color: var(--muted);
    font-size: var(--text-lead);
  }
  .module-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
    margin: 42px 0 0;
    padding: 0;
    list-style: none;
    counter-reset: none;
  }
  .module-list li {
    min-width: 0;
  }
  .module-list article {
    height: 100%;
    padding: clamp(24px, 4vw, 34px);
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--white);
  }
  .module-number {
    display: block;
    color: var(--green);
    font-size: var(--text-small);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .module-list h3 {
    margin: 10px 0 12px;
    font-size: clamp(1.35rem, 2vw, 1.7rem);
  }
  .module-list p {
    margin: 0;
    color: var(--muted);
  }
  .adhd-focus {
    margin-block: 42px;
    padding: clamp(28px, 5vw, 46px);
    border-left: 4px solid var(--sage-deep);
    border-radius: 0 8px 8px 0;
    background: var(--sage);
  }
  .adhd-focus h2 {
    margin-top: 10px;
  }
  .adhd-focus p:last-child {
    margin-bottom: 0;
  }
  .adhd-links {
    display: flex;
    flex-wrap: wrap;
    gap: 5px 10px;
    padding-top: 5px;
    color: var(--muted);
    font-size: var(--text-small);
  }
  .adhd-links a {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  @media (max-width: 1000px) {
    .treatment-hero {
      grid-template-columns: minmax(0, 1fr);
    }
    .treatment-person {
      display: flex;
      align-items: center;
      border-radius: 8px;
    }
    .treatment-person img {
      width: 30%;
      max-width: 180px;
      align-self: stretch;
    }
    .treatment-inclusions {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 600px) {
    .treatment-inclusions {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }
    .treatment-person img {
      width: 28%;
    }
    figcaption {
      padding: 16px;
      min-width: 0;
    }
    figcaption strong {
      font-size: var(--text-small);
    }
    .treatment-overview {
      padding-block: 28px 45px;
    }
    .module-list {
      grid-template-columns: minmax(0, 1fr);
      margin-top: 30px;
    }
  }
</style>
