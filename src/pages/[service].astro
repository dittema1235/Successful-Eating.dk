---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { site, formatPrice, bodyCourse } from '../data/site';

// Salgssiden for onlineforløbet Bliv glad for din krop ligger på /kropsglaede.
export function getStaticPaths() {
  return [{ params: { service: 'kropsglaede' } }];
}

const title = 'Bliv glad for din krop – onlineforløb om kropsaccept';
const price = formatPrice(bodyCourse.price);
const checkout = bodyCourse.checkout;
const description =
  'Bliv glad for din krop er et onlineforløb om kropsaccept: seks moduler med 9 videoer og 15 øvelser. Adgang til alle moduler fra start og livslang adgang. ' +
  price +
  ' inkl. moms. Af psykolog Ditte Munch-Andersen.';

const schema = {
  '@type': 'Course',
  '@id': site.url + '/kropsglaede/#course',
  name: bodyCourse.productName,
  description,
  inLanguage: 'da-DK',
  provider: { '@id': site.url + '/#organization' },
  offers: {
    '@type': 'Offer',
    url: new URL(checkout, site.url).href,
    price: bodyCourse.price,
    priceCurrency: 'DKK',
    priceSpecification: {
      '@type': 'PriceSpecification',
      price: bodyCourse.price,
      priceCurrency: 'DKK',
      valueAddedTaxIncluded: true,
    },
  },
};

// Knaptekster efter Dittes manuskript. Alle knapper går til købssiden.
const cta = {
  hero: 'Ja tak – jeg vil gerne blive glad for min krop',
  recognition: 'Jeg vil have et friere forhold til min krop',
  future: 'Ja tak – jeg vil gerne arbejde med mit kropsforhold',
  method: 'Jeg vil gerne i gang',
  meet: 'Få adgang til Bliv glad for din krop',
  stories: 'Jeg vil også arbejde med mit kropsforhold',
  gets: 'Ja tak – jeg vil gerne have adgang',
  everyday: 'Jeg vil gerne tage det første skridt',
  about: 'Jeg vil gerne arbejde med Dittes metode',
  shared: 'Ja tak – jeg vil gerne med',
  fit: 'Jeg er klar til at komme i gang',
  price: 'Ja tak – jeg vil gerne blive glad for min krop',
  final: 'Ja tak – jeg vil gerne blive glad for min krop',
};

const experiences = [
  {
    name: 'Ursula',
    quote:
      'En fra job idag spurgte om jeg havde tabt mig! Jeg har ikke tabt et eneste gram, men jeg tror jeg bærer min krop på en mere sikker måde!',
  },
  {
    name: 'Ursula',
    quote:
      'Midt i livet havde jeg brug for at lære min krop at kende og finde ro og glæde i at jeg har forandret mig. Forløbet ‘bliv glad for din krop’ har ændret mit syn og jeg er gået sommeren i møde uden selvkritiske og skamfulde tanker om mine ‘fejl’.',
  },
  {
    name: 'Hanne',
    quote:
      'Dette forløb har været en øjenåbner for mig og jeg har fået givet slip og sat ord på nogle af mine inderste tanker, som jeg har gået med i mange mange år.',
  },
  {
    name: 'Charlotte',
    quote:
      'Så kom jeg på stranden i går, og selvom der ikke var mange mennesker og udfordringen ikke så stor, så tænkte jeg da på dellerne. Men det var nu grundlæggende den samme dejlige følelse, at komme i bølgen blå, som sidste år. Det er jo skønt.',
  },
];

const sharedThoughts = [
  {
    name: 'Barbara',
    quote:
      'Det jeg har opdaget der virkelig trigger mig til en overspisning det er tanken ‘jeg er for tyk ergo er jeg ikke godt nok’ derfor skal jeg tabe mig NU (og helst i går) så jeg kan blive slank og være god nok 🙉',
  },
  {
    name: 'Charlotte',
    quote: 'Selv da jeg objektivt set var normalvægtig, synes jeg ikke om hvordan min krop så ud.',
  },
  { name: 'Ursula', quote: 'Jeg er blevet så mega god! Bare ben HELE sommeren.' },
];

const benefits = [
  {
    label: '6 moduler',
    text: 'En overskuelig struktur, der guider dig gennem de forskellige dele af arbejdet med kropsaccept.',
  },
  {
    label: '9 undervisningsvideoer',
    text: 'Psykologfaglig undervisning, som hjælper dig med at forstå dine tanker og reaktioner.',
  },
  {
    label: '15 praktiske øvelser',
    text: 'Mulighed for at omsætte det, du lærer, til konkrete handlinger i din hverdag.',
  },
  {
    label: 'Ca. 4 timers undervisning',
    text: 'Et samlet forløb, du kan tage i bidder, når det passer dig.',
  },
  {
    label: 'Arbejde med tankemønstre',
    text: 'Bliv klogere på de tanker, der påvirker dit syn på kroppen.',
  },
  { label: 'Redskaber mod selvkritik', text: 'Øv dig i at møde dig selv på nye måder.' },
  { label: 'Fokus på egenomsorg', text: 'Arbejd med at prioritere dig selv og dine behov.' },
  {
    label: 'Adgang til alle moduler med det samme',
    text: 'Du kan begynde, så snart du har fået adgang.',
  },
  {
    label: 'Selvvalgt tempo',
    text: 'Du bestemmer selv, hvornår og hvor hurtigt du arbejder med materialet.',
  },
  {
    label: 'Livslang adgang',
    text: 'Du kan vende tilbage til undervisningen og øvelserne igen og igen.',
  },
];

// Fire gratis blogindlæg om kropsbillede (uden henvisning til andre forløb eller vægttab).
const reads = [
  {
    href: '/blog/50565-hvordan-vil-det-vaere-at-hade-din-krop/',
    title: 'Når du er hård ved din krop: begynd med mindre kropskritik',
    text: 'Du behøver ikke elske din krop for at tage vare på den. Et mere neutralt sprog og ét lille hverdagsvalg, når kritikken fylder.',
  },
  {
    href: '/blog/50294-du-behoever-ikke-at-elske-din-krop/',
    title: 'Du behøver ikke at elske din krop',
    text: 'Ikke som en start i hvert fald. Om hvorfor små, realistiske skridt ofte virker bedre end at forsøge at elske sin krop.',
  },
  {
    href: '/blog/50433-har-du-et-problem-med-din-krop-eller-med/',
    title: 'Har du et problem med din krop - eller med dine tanker?',
    text: 'Hvad hvis det, du gerne vil ændre, slet ikke behøver at ændre sig, før du kan være tilfreds?',
  },
  {
    href: '/blog/54908-man-maa-vaelge-sine-kampe/',
    title: 'Man må vælge sine kampe',
    text: 'Hvad er et normalt kropsbillede? Og hvornår begynder det, du ikke kan lide ved dig selv, at fylde for meget?',
  },
];

const faqs = [
  {
    question: 'Hvordan foregår forløbet?',
    answer:
      'Bliv glad for din krop er et online selvstudieforløb. Du får adgang til undervisningsvideoer og praktiske øvelser, som du arbejder med på egen hånd.',
  },
  {
    question: 'Hvornår får jeg adgang til modulerne?',
    answer:
      'Du får adgang til alle seks moduler med det samme. Du skal altså ikke vente på, at nye moduler bliver frigivet.',
  },
  {
    question: 'Skal jeg gennemføre forløbet på seks uger?',
    answer:
      'Nej. Du bestemmer selv tempoet. Du kan tage forløbet i den rækkefølge og det tempo, der passer til din hverdag.',
  },
  {
    question: 'Hvor lang tid tager forløbet?',
    answer:
      'Der er cirka fire timers undervisning fordelt på ni videoer. Derudover skal du sætte tid af til at arbejde med de 15 praktiske øvelser. Du bestemmer selv, hvor hurtigt du gennemfører det.',
  },
  {
    question: 'Hvor længe har jeg adgang?',
    answer:
      'Du har livslang adgang til materialet. Du kan derfor vende tilbage til undervisningen og øvelserne, når du har brug for det.',
  },
  {
    question: 'Handler forløbet om vægttab?',
    answer:
      'Nej. Forløbet handler ikke om kostplaner, slankekure eller vægtmål. Fokus er på dit forhold til kroppen og de tanker og mønstre, der påvirker det.',
  },
  {
    question: 'Er der personlig kontakt med Ditte inkluderet?',
    answer:
      'Nej. Forløbet er et selvstudie, hvor du arbejder selvstændigt med undervisningen og øvelserne. Hvis du ønsker individuel sparring, kan du tilkøbe individuelle samtaler separat.',
  },
  {
    question: 'Er forløbet behandling for en spiseforstyrrelse?',
    answer:
      'Nej. Forløbet er et selvstudie og erstatter ikke individuel behandling. Hvis du har symptomer på en spiseforstyrrelse eller er bekymret for dit helbred, anbefaler jeg, at du kontakter din egen læge.',
  },
];
---

<Layout
  title={title}
  description={description}
  schema={schema}
  breadcrumbs={[{ name: 'Bliv glad for din krop', url: '/kropsglaede/' }]}
>
  <div class="bk-sales">
    <section class="bk-hero" aria-labelledby="body-heading">
      <div class="container bk-hero-grid">
        <div>
          <nav class="breadcrumbs" aria-label="Brødkrummer">
            <a href="/">Forside</a><span>/</span><span>Bliv glad for din krop</span>
          </nav>
          <span class="eyebrow">Bliv glad for din krop</span>
          <h1 id="body-heading">
            Få et friere forhold til din krop – og brug livet på noget andet end at kritisere den
          </h1>
          <p class="bk-lead">Er du træt af, at tanker om din krop fylder så meget i din hverdag?</p>
          <p>
            Af at sammenligne dig med andre, gemme dig i tøjet eller lade utilfredsheden med din
            krop bestemme, hvad du har lyst til at gøre?
          </p>
          <p>
            Bliv glad for din krop er et online selvstudieforløb, der hjælper dig med at forstå og
            arbejde med de tanker og mønstre, der står i vejen for et mere afslappet og omsorgsfuldt
            forhold til din krop.
          </p>
          <p>
            Du får adgang til alle seks moduler med det samme. Du bestemmer selv tempoet og kan
            vende tilbage til materialet, når du har brug for det.
          </p>
          <ul class="checklist bk-facts">
            <li><Icon name="check" size={16} /> 6 moduler</li>
            <li><Icon name="check" size={16} /> 9 undervisningsvideoer</li>
            <li><Icon name="check" size={16} /> 15 praktiske øvelser</li>
            <li><Icon name="check" size={16} /> Ca. 4 timers undervisning</li>
            <li><Icon name="check" size={16} /> Livslang adgang</li>
            <li><Icon name="check" size={16} /> Pris: {price} inkl. moms</li>
          </ul>
          <a
            class="button bk-purchase-link"
            href={checkout}
            data-event="checkout_click"
            data-location="body_hero"
          >
            {cta.hero} <Icon size={18} />
          </a>
        </div>
        <div class="bk-hero-visual">
          <img
            src="/images/ditte-portrait-hero.webp"
            srcset="/images/ditte-portrait-hero-small.webp 500w, /images/ditte-portrait-hero.webp 888w"
            sizes="(max-width: 900px) 90vw, 46vw"
            width="888"
            height="1110"
            alt="Psykolog Ditte Munch-Andersen smiler til kameraet"
            fetchpriority="high"
          />
          <div class="bk-hero-caption">
            <strong>Udviklet af psykolog Ditte Munch-Andersen</strong>
          </div>
        </div>
      </div>
    </section>

    <section class="section bk-recognition" aria-labelledby="recognition-heading">
      <div class="container bk-two-column">
        <div>
          <h2 id="recognition-heading">Når kroppen fylder for meget i dine tanker</h2>
        </div>
        <div class="bk-reading">
          <p><strong>Måske kender du det:</strong></p>
          <ul class="bk-situations">
            <li>Du står foran spejlet og lægger mærke til alt det, du ikke bryder dig om.</li>
            <li>
              Du vælger tøj ud fra, hvad der skjuler din krop – frem for hvad du egentlig har lyst
              til at tage på.
            </li>
            <li>Du sammenligner dig med andre og føler, at din krop ikke er god nok.</li>
            <li>
              Du siger nej til oplevelser, fordi du ikke føler dig tilpas i din krop. Måske undgår
              du stranden, svømmehallen, bestemte sociale arrangementer eller bare at tage shorts
              på en varm sommerdag.
            </li>
          </ul>
          <p>Og selv når du prøver at tænke positivt, vender de kritiske tanker tilbage.</p>
          <p>
            Det kan være enormt opslidende at bruge så meget energi på sin krop. Ikke kun fordi
            tankerne gør ondt, men fordi de kan komme til at begrænse dit liv.
          </p>
          <p class="bk-question">
            Du fortjener at kunne være til stede i dit liv uden hele tiden at skulle forholde dig
            kritisk til din krop.
          </p>
          <a
            class="button bk-purchase-link"
            href={checkout}
            data-event="checkout_click"
            data-location="body_recognition"
          >
            {cta.recognition} <Icon size={18} />
          </a>
        </div>
      </div>
    </section>

    <section class="section bk-future" aria-labelledby="future-heading">
      <div class="container bk-two-column">
        <div>
          <h2 id="future-heading">Forestil dig, hvis&nbsp;…</h2>
        </div>
        <div class="bk-reading">
          <ul class="checklist">
            <li>
              <Icon name="check" size={16} /> Du kunne se dig selv i spejlet uden straks at lede efter
              noget, du ville lave om.
            </li>
            <li>
              <Icon name="check" size={16} /> Du kunne tage det tøj på, du har lyst til – uden at
              bruge lang tid på at skjule din krop.
            </li>
            <li>
              <Icon name="check" size={16} /> Du kunne tage på stranden, i svømmehallen eller til
              fest uden at lade kropskritiske tanker bestemme.
            </li>
            <li>
              <Icon name="check" size={16} /> Du kunne møde din krop med mere forståelse og mindre
              selvkritik.
            </li>
            <li>
              <Icon name="check" size={16} /> Du kunne bruge din energi på mennesker, oplevelser og
              ting, der betyder noget for dig.
            </li>
          </ul>
          <p>Det handler ikke om, at du skal elske hvert eneste sted på din krop.</p>
          <p>
            Det handler om, at din krop ikke skal stå i vejen for, at du kan leve det liv, du gerne
            vil leve.
          </p>
          <a
            class="button bk-purchase-link"
            href={checkout}
            data-event="checkout_click"
            data-location="body_future"
          >
            {cta.future} <Icon size={18} />
          </a>
        </div>
      </div>
    </section>

    <section class="bk-oneliner" aria-label="Så er du landet det rigtige sted">
      <div class="container">
        <p>Så er du landet det helt rigtige sted.</p>
      </div>
    </section>

    <section class="section bk-method" aria-labelledby="method-heading">
      <div class="container bk-two-column">
        <div>
          <h2 id="method-heading">Du kan ikke bare beslutte dig for at være glad for din krop</h2>
        </div>
        <div class="bk-reading">
          <p>Hvis det var så enkelt, havde du sikkert allerede gjort det.</p>
          <p>
            Et kritisk forhold til kroppen handler sjældent kun om, hvordan kroppen ser ud. Det kan
            også handle om tankemønstre, vaner, sammenligninger og forestillinger om, hvad der skal
            til, før du er god nok.
          </p>
          <p>
            Derfor hjælper det sjældent at sige til sig selv, at man bare skal tænke mere positivt.
          </p>
          <p>
            Du har brug for at forstå, hvad der sker, når selvkritikken tager over – og lære nye
            måder at møde dig selv på.
          </p>
          <p><strong>I forløbet arbejder du blandt andet med:</strong></p>
          <ul class="checklist">
            <li><Icon name="check" size={16} /> At opdage og forstå dine kropskritiske tanker.</li>
            <li>
              <Icon name="check" size={16} /> At blive klogere på de situationer, der udløser
              utilfredshed med kroppen.
            </li>
            <li>
              <Icon name="check" size={16} /> At undersøge de regler og forventninger, du stiller til
              dig selv.
            </li>
            <li><Icon name="check" size={16} /> At håndtere den indre kritiker.</li>
            <li>
              <Icon name="check" size={16} /> At øve dig i at møde dig selv med mere omsorg og
              forståelse.
            </li>
          </ul>
          <p>Målet er ikke at tvinge dig selv til at synes, at alt ved din krop er fantastisk.</p>
          <p>
            Målet er at skabe mere frihed, så følelsen af, at din krop ikke er god nok, ikke længere
            skal bestemme så meget i dit liv.
          </p>
          <a
            class="button bk-purchase-link"
            href={checkout}
            data-event="checkout_click"
            data-location="body_method"
          >
            {cta.method} <Icon size={18} />
          </a>
        </div>
      </div>
    </section>

    <section class="section bk-meet" aria-labelledby="meet-heading">
      <div class="container bk-two-column">
        <div>
          <h2 id="meet-heading">Mød Bliv glad for din krop</h2>
          <p class="bk-method-lead">
            Et online selvstudieforløb, der hjælper dig med at arbejde med dine tanker, følelser og
            handlemønstre, så du kan få et mere afslappet forhold til din krop.
          </p>
        </div>
        <div class="bk-reading">
          <p>Forløbet er bygget op omkring seks moduler med undervisningsvideoer og praktiske øvelser.</p>
          <p>
            Du får adgang til alle seks moduler med det samme. Der er ingen ventetid på næste modul,
            og du skal ikke følge en fastlagt ugeplan.
          </p>
          <p>
            Du bestemmer selv, hvornår du vil se undervisningen, hvilke øvelser du vil arbejde med,
            og hvor hurtigt du vil gennemføre forløbet.
          </p>
          <p>
            Du får livslang adgang, så du kan vende tilbage til materialet, når du har brug for det.
          </p>
          <p>
            Forløbet bygger på psykologfaglig viden og metoder fra blandt andet kognitiv
            adfærdsterapi.
          </p>
          <p>
            Det giver dig mulighed for at arbejde med dit kropsforhold på en struktureret og
            overskuelig måde – hjemme hos dig selv og i dit eget tempo.
          </p>
          <a
            class="button bk-purchase-link"
            href={checkout}
            data-event="checkout_click"
            data-location="body_meet"
          >
            {cta.meet} <Icon size={18} />
          </a>
        </div>
      </div>
    </section>

    <section class="section bk-stories" id="erfaringer" aria-labelledby="stories-heading">
      <div class="container">
        <div class="bk-section-heading">
          <h2 id="stories-heading">Beviset ligger i de personlige erfaringer</h2>
          <p>
            Her er nogle af de oplevelser, tidligere deltagere har delt fra deres arbejde med
            kropsforholdet.
          </p>
        </div>
        <div class="bk-quote-grid">
          {
            experiences.map((item) => (
              <figure>
                <blockquote>“{item.quote}”</blockquote>
                <figcaption>{item.name}</figcaption>
              </figure>
            ))
          }
        </div>
        <a
          class="button bk-purchase-link"
          href={checkout}
          data-event="checkout_click"
          data-location="body_stories"
        >
          {cta.stories} <Icon size={18} />
        </a>
      </div>
    </section>

    <section class="section bk-gets" id="det-faar-du" aria-labelledby="gets-heading">
      <div class="container">
        <div class="bk-section-heading">
          <h2 id="gets-heading">Det får du – og derfor er det værdifuldt</h2>
          <p>
            Når du køber Bliv glad for din krop, får du adgang til et samlet undervisningsforløb,
            der hjælper dig med at arbejde systematisk med dit kropsforhold.
          </p>
        </div>
        <p class="bk-benefits-intro"><strong>Du får:</strong></p>
        <ul class="bk-benefit-grid">
          {
            benefits.map((item) => (
              <li>
                <strong>{item.label}</strong>
                <p>{item.text}</p>
              </li>
            ))
          }
        </ul>
        <div class="bk-gets-close bk-reading">
          <p>
            Hvis du ønsker individuel sparring, kan{' '}
            <a href="/individuelt-forloeb/">individuelle samtaler</a> tilkøbes separat. De er ikke en
            del af selvstudieforløbet.
          </p>
          <p class="bk-invest">Din investering: {price} inkl. moms.</p>
          <p>
            Det er en investering i at bruge mindre energi på selvkritik og få mere frihed til at
            leve dit liv.
          </p>
          <a
            class="button bk-purchase-link"
            href={checkout}
            data-event="checkout_click"
            data-location="body_gets"
          >
            {cta.gets} <Icon size={18} />
          </a>
        </div>
      </div>
    </section>

    <section class="section bk-everyday" aria-labelledby="everyday-heading">
      <div class="container bk-two-column">
        <div>
          <h2 id="everyday-heading">Hvad kan arbejdet med dit kropsforhold betyde i hverdagen?</h2>
        </div>
        <div class="bk-reading">
          <p>Forandring handler ikke nødvendigvis om, at du pludselig elsker din krop.</p>
          <p>Den kan også vise sig i de små situationer:</p>
          <ul class="checklist">
            <li>
              <Icon name="check" size={16} /> At tage shorts på, selvom du tidligere ville have
              skjult dine ben.
            </li>
            <li>
              <Icon name="check" size={16} /> At tage på stranden og mærke glæden ved vandet frem for
              kun at tænke på din krop.
            </li>
            <li>
              <Icon name="check" size={16} /> At opdage, at en kommentar om dit udseende ikke
              behøver ødelægge resten af din dag.
            </li>
            <li>
              <Icon name="check" size={16} /> At vælge tøj ud fra lyst og komfort frem for ønsket om
              at skjule dig.
            </li>
            <li><Icon name="check" size={16} /> At bruge mindre tid på at kritisere dig selv.</li>
          </ul>
          <p>Det er netop den slags frihed, du kan arbejde hen imod gennem forløbet.</p>
          <p>
            Forløbet giver dig undervisning og øvelser. Dine personlige resultater afhænger af din
            situation og det arbejde, du selv lægger i processen.
          </p>
          <a
            class="button bk-purchase-link"
            href={checkout}
            data-event="checkout_click"
            data-location="body_everyday"
          >
            {cta.everyday} <Icon size={18} />
          </a>
        </div>
      </div>
    </section>

    <section class="section bk-about" id="om-ditte" aria-labelledby="about-heading">
      <div class="container bk-about-grid">
        <div class="bk-about-image">
          <img
            src="/images/ditte-portrait.webp"
