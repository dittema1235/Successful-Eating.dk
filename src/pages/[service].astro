---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { site, formatPrice, bodyCourse } from '../data/site';

// Salgssiden for onlineforløbet Bliv glad for din krop ligger på /kropsglaede.
export function getStaticPaths() {
  return [{ params: { service: 'kropsglaede' } }];
}

const title = 'Bliv glad for din krop – onlineforløb om kropsaccept';
const description =
  'Bliv glad for din krop er et onlineforløb om kropsaccept: seks moduler over seks uger med 9 videoer og 15 øvelser. Livslang adgang. ' +
  formatPrice(bodyCourse.price) +
  ' inkl. moms. Af psykolog Ditte Munch-Andersen.';

const schema = {
  '@type': 'Course',
  '@id': site.url + '/kropsglaede/#course',
  name: bodyCourse.productName,
  description,
  inLanguage: 'da-DK',
  provider: { '@id': site.url + '/#organization' },
  offers: {
    '@type': 'Offer',
    url: new URL(bodyCourse.checkout, site.url).href,
    price: bodyCourse.price,
    priceCurrency: 'DKK',
    priceSpecification: {
      '@type': 'PriceSpecification',
      price: bodyCourse.price,
      priceCurrency: 'DKK',
      valueAddedTaxIncluded: true,
    },
  },
};

// Indhold, antal og varigheder er hentet fra selve kurset i Simplero (3. nov. 2026):
// Start her + 6 moduler, 34 lektioner, 9 videoer (i alt 3 t 53 min), 15 øvelser.
const modules = [
  {
    title: 'Om kropsbilledet',
    description:
      'Du finder frem til, hvor skoen trykker. Hvordan blev dit kropsbillede til, og hvilke perioder og episoder har formet dit forhold til din krop? Bagefter ser du på dine værdier og på, hvad du vil vælge aktivt fra nu af.',
    meta: '2 videoer · 36 min. · 2 øvelser',
    exercises: ['Vær detektiv på dine kropsidealer og dit kropsbillede', 'Find dine værdier'],
  },
  {
    title: 'Sikkerhedsadfærd',
    description:
      'Alt det, du gør for at skjule det, du ikke bryder dig om. Du lærer at spotte din adfærd, opdager dine triggere og øver dig i at gøre noget nyt. Og du tager fat på selvsnakken, altså den måde, du mobber din krop på.',
    meta: '2 videoer · 1 t 5 min. · 4 øvelser',
    exercises: [
      'Lav en liste over din sikkerhedsadfærd',
      'Opdag dine triggere',
      'Byg din plan',
      'Test teori A mod teori B',
    ],
  },
  {
    title: 'Bliv den bedste ven for din krop',
    description:
      'I de første moduler lærer du at holde op med at mobbe din krop. Nu fylder du på med gode oplevelser. For helt ærligt: En god ven gør mere end bare at lade være med at kritisere dig non-stop.',
    meta: '1 video · 13 min. · 3 øvelser og en ideliste',
    exercises: ['Styrk din relation og dyrk dine værdier', 'Date dig selv (med ideliste til aktiviteter)'],
  },
  {
    title: 'Afmonter dine “sandheder” om dit udseende',
    description:
      'Måske har du nogle “sandheder” med dig. “Hvis jeg tager med til den fest, vil alle lægge mærke til min krop og dømme mig.” “Hvis han ser mig nøgen, vil han aldrig tænde på mig igen.” “Hvis jeg stopper med at kritisere mine fejl, mister jeg al motivation.” Du lærer at opdage de tanker, der sætter kropsskammen i gang, og at arbejde med dine antagelser, regler og katastrofetanker.',
    meta: '2 videoer · 1 t 8 min. · 2 øvelser',
    exercises: [
      'Gå til dine antagelser og find en ny og mere hensigtsmæssig selvsnak',
      'Arbejd videre med dine planer fra modul 2',
    ],
  },
  {
    title: 'God kommunikation',
    description:
      'Indimellem er der nogen, der kommenterer din krop eller overskrider dine grænser. Her arbejder vi med kommunikation og grænsesætning, så du ved, hvad du kan sige.',
    meta: '1 video · 33 min. · 2 øvelser',
    exercises: [
      'Forbered gode svar på ubehagelige spørgsmål',
      'Når du føler dig grænseoverskredet, og har lyst til at sige fra',
    ],
  },
  {
    title: 'Sådan gør du fremover',
    description:
      'Har du haft et anspændt forhold til din krop i mange år, kan det være let at falde tilbage i de gamle vaner. Derfor lægger du en plan for, hvad du vil arbejde med fremover, og hvordan du holder fast på den lange bane.',
    meta: '1 video · 18 min. · 2 øvelser',
    exercises: ['3 måneders plan', 'Tilbagefaldsplan'],
  },
];

const stories = [
  {
    name: 'Louise',
    quote:
      'For første gang i mit liv kan jeg tage et billede uden at granske alle mine ‘fejl’. Det er en frihed, jeg ikke troede var mulig.',
  },
  {
    name: 'Maria',
    quote:
      'Jeg har kæmpet med mit kropsbillede i årevis, men det her forløb har hjulpet mig med at se min krop på en ny måde. Det føles som en kæmpe lettelse!',
  },
];

// Fire gratis blogindlæg om kropsbillede (uden henvisning til andre forløb eller vægttab).
const reads = [
  {
    href: '/blog/50565-hvordan-vil-det-vaere-at-hade-din-krop/',
    title: 'Når du er hård ved din krop: begynd med mindre kropskritik',
    text: 'Du behøver ikke elske din krop for at tage vare på den. Et mere neutralt sprog og ét lille hverdagsvalg, når kritikken fylder.',
  },
  {
    href: '/blog/50294-du-behoever-ikke-at-elske-din-krop/',
    title: 'Du behøver ikke at elske din krop',
    text: 'Ikke som en start i hvert fald. Om hvorfor små, realistiske skridt ofte virker bedre end at forsøge at elske sin krop.',
  },
  {
    href: '/blog/50433-har-du-et-problem-med-din-krop-eller-med/',
    title: 'Har du et problem med din krop - eller med dine tanker?',
    text: 'Hvad hvis det, du gerne vil ændre, slet ikke behøver at ændre sig, før du kan være tilfreds?',
  },
  {
    href: '/blog/54908-man-maa-vaelge-sine-kampe/',
    title: 'Man må vælge sine kampe',
    text: 'Hvad er et normalt kropsbillede? Og hvornår begynder det, du ikke kan lide ved dig selv, at fylde for meget?',
  },
];

const faqs = [
  {
    question: 'Hvad får jeg helt præcist?',
    answer:
      'En velkomst, hvor du får overblik over forløbet, og derefter seks moduler. I alt er der 9 videoer på knap fire timer og 15 øvelser. Hvert modul bygger videre på det forrige, og du får adgang til ét nyt modul hver 7. dag.',
  },
  {
    question: 'Hvad skal jeg bruge for at komme i gang?',
    answer:
      'Du kan downloade og printe øvelserne, eller du kan bruge en helt almindelig notesbog. Jeg anbefaler, at du laver øvelserne for at få det fulde udbytte af forløbet.',
  },
  {
    question: 'Hvor lang tid tager det?',
    answer:
      'Forløbet er bygget over seks uger, hvor ét nyt modul åbner hver 7. dag. Videoerne varer knap fire timer i alt, og øvelserne kommer oveni. Forløbet er dit, så du kan tage det i dit eget tempo, også efter de seks uger.',
  },
  {
    question: 'Hvor længe har jeg adgang?',
    answer:
      'Du har livslang adgang til forløbets materiale. De seks uger beskriver, hvordan forløbet er bygget op, og ikke hvornår din adgang udløber.',
  },
  {
    question: 'Skal jeg tabe mig for at få noget ud af det?',
    answer:
      'Nej. Forløbet handler ikke om vægt. Der er ingen kostplan og ingen vægtmål. Det handler om dit forhold til din krop.',
  },
  {
    question: 'Er forløbet en erstatning for psykologisk behandling?',
    answer:
      'Nej. Bliv glad for din krop er et onlineforløb, du gennemfører selv. Det indeholder ingen individuel vurdering eller behandling. Har du det rigtig svært, kan du bestille individuelle samtaler eller tale med din egen læge.',
  },
  {
    question: 'Er samtaler med Ditte med i prisen?',
    answer:
      'Nej. Individuelle samtaler om kropsaccept er et separat tilbud, som du kan bestille, hvis du ønsker personlig kontakt.',
  },
  {
    question: 'Hvad koster forløbet?',
    answer:
      'Bliv glad for din krop koster ' +
      formatPrice(bodyCourse.price) +
      ' inkl. moms. Det samlede beløb og betalingsformen kan du se på købssiden, før du beslutter dig.',
  },
];
---

<Layout
  title={title}
  description={description}
  schema={schema}
  breadcrumbs={[{ name: 'Bliv glad for din krop', url: '/kropsglaede/' }]}
>
  <div class="bk-sales">
    <section class="bk-hero" aria-labelledby="body-heading">
      <div class="container bk-hero-grid">
        <div>
          <nav class="breadcrumbs" aria-label="Brødkrummer">
            <a href="/">Forside</a><span>/</span><span>Bliv glad for din krop</span>
          </nav>
          <span class="eyebrow">Bliv glad for din krop · onlineforløb</span>
          <h1 id="body-heading">Slip kropskritikken. Uden først at skulle ændre din krop.</h1>
          <p class="bk-lead">
            Du kender stemmen. Den, der har en mening, hver gang du ser dig i spejlet. Den, der får
            dig til at vælge tøj, der skjuler, og til at sige nej til billeder.
          </p>
          <p>
            Hvad nu hvis vejen ud ikke er at ændre din krop, men at ændre dit forhold til den? Det
            arbejder vi med i Bliv glad for din krop.
          </p>
          <a
            class="button bk-purchase-link"
            href={bodyCourse.checkout}
            data-event="checkout_click"
            data-location="body_hero"
          >
            {bodyCourse.purchaseCta} <Icon size={18} />
          </a>
          <p class="bk-hero-note">
            Seks uger · 9 videoer · 15 øvelser · Livslang adgang · {formatPrice(bodyCourse.price)} inkl. moms
          </p>
          <p class="bk-separate">
            Individuelle samtaler om kropsaccept bestiller du separat. De er ikke med i prisen.
          </p>
        </div>
        <div class="bk-hero-visual">
          <img
            src="/images/ditte-portrait-hero.webp"
            srcset="/images/ditte-portrait-hero-small.webp 500w, /images/ditte-portrait-hero.webp 888w"
            sizes="(max-width: 900px) 90vw, 46vw"
            width="888"
            height="1110"
            alt="Psykolog Ditte Munch-Andersen smiler til kameraet"
            fetchpriority="high"
          />
          <div class="bk-hero-caption">
            <strong>Udviklet af psykolog Ditte Munch-Andersen</strong>
            <span>Seks moduler, der hjælper dig med at slippe skam, kropskritik og usikkerhed.</span>
          </div>
        </div>
      </div>
    </section>

    <section class="section bk-recognition" aria-labelledby="recognition-heading">
      <div class="container bk-two-column">
        <div>
          <span class="eyebrow">Måske kender du det</span>
          <h2 id="recognition-heading">Du har prøvet at gøre noget ved det. Det føles aldrig helt nok.</h2>
        </div>
        <div class="bk-reading">
          <p>
            Måske har du brugt mange år på at kæmpe med dit kropsbillede. Tankerne om, hvordan du ser
            ud. Om, hvad andre mon tænker. Om, hvad du burde gøre for at få det bedre.
          </p>
          <p>
            Måske har du prøvet at ændre din krop. Med kure, med træning eller med tøj, der skjuler
            det, du ikke kan lide. Og alligevel er det aldrig helt nok.
          </p>
          <p>
            Hvad hvis det ikke er din krop, der er problemet? Men den måde, du ser på den?
          </p>
        </div>
      </div>
      <div class="container bk-pattern-grid">
        <article>
          <span>01</span>
          <h3>Når du ser dig selv</h3>
          <p>Hvad lægger du først mærke til i spejlet? Og hvad sker der i dig bagefter?</p>
        </article>
        <article>
          <span>02</span>
          <h3>Når du skjuler dig</h3>
          <p>
            Tøj, der skal gemme. Billeder, du undgår. Situationer, du siger nej til. Hvad koster det
            dig?
          </p>
        </article>
        <article>
          <span>03</span>
          <h3>Når andre siger noget</h3>
          <p>
            En kommentar kan hænge ved i flere dage. Hvordan kan du stå fast uden at falde sammen?
          </p>
        </article>
      </div>
    </section>

    <section class="section bk-method" id="det-faar-du" aria-labelledby="method-heading">
      <div class="container bk-two-column">
        <div>
          <span class="eyebrow">Tilgangen</span>
          <h2 id="method-heading">Kropsaccept handler ikke om at give op. Det handler om frihed.</h2>
          <p class="bk-method-lead">
            Måske tænker du, at roen først kommer, den dag din krop har ændret sig. I forløbet
            kigger vi på den tanke. Og på, hvad den har kostet dig undervejs.
          </p>
          <p class="bk-method-lead">
            Tanken er, at du arbejder dig frem til, at du ikke bare har sluttet fred med din krop,
            men også kan mærke glæde ved den.
          </p>
          <p class="bk-method-lead">
            Jeg har arbejdet med forholdet til mad, krop og selvværd i mere end 20 år. Øvelserne i
            forløbet er værktøjer fra kognitiv terapi, som jeg bruger sammen med mine klienter.
          </p>
          <a
            class="button bk-purchase-link"
            href={bodyCourse.checkout}
            data-event="checkout_click"
            data-location="body_method"
          >
            {bodyCourse.purchaseCta} <Icon size={18} />
          </a>
        </div>
        <div class="bk-inclusions">
          <span class="eyebrow bk-inclusions-title">Det får du, når du køber</span>
          <div>
            <Icon name="book" size={25} />
            <div>
              <h3>9 videoer, knap fire timers undervisning</h3>
              <p>
                Fordelt på seks moduler. Du får undervisning i, hvordan kropsbilledet opstår,
                hvordan du arbejder med sikkerhedsadfærd og negative tanker, og hvordan du holder
                fast bagefter.
              </p>
            </div>
          </div>
          <div>
            <Icon name="heart" size={25} />
            <div>
              <h3>15 øvelser, så du får brugt det, du lærer</h3>
              <p>
                Du kan downloade og printe dem eller bruge en almindelig notesbog. Jeg anbefaler, at
                du laver øvelserne for at få det fulde udbytte.
              </p>
            </div>
          </div>
          <div>
            <Icon name="clock" size={25} />
            <div>
              <h3>Start her og seks moduler over seks uger</h3>
              <p>
                Du begynder med en velkomst og et overblik over forløbet. Derefter får du adgang til
                ét nyt modul hver 7. dag. Hvert modul bygger videre på det forrige.
              </p>
            </div>
          </div>
          <div>
            <Icon name="shield" size={25} />
            <div>
              <h3>Dit eget tempo og livslang adgang</h3>
              <p>
                Forløbet er dit. Du kan gå tilbage til videoer og øvelser, når du har brug for det,
                også efter de seks uger.
              </p>
            </div>
          </div>
          <p class="bk-inclusions-note">
            Forløbet gennemfører du på egen hånd. Individuelle samtaler med mig er ikke
            inkluderet.
          </p>
        </div>
      </div>
    </section>

    <section class="section bk-modules" id="moduler" aria-labelledby="modules-heading">
      <div class="container">
        <div class="bk-section-heading">
          <span class="eyebrow">Sådan er forløbet bygget op</span>
          <h2 id="modules-heading">Fra tankerne om din krop til din plan for tiden efter.</h2>
          <p>
            Seks moduler, ét ad gangen. Du arbejder med ét tema, før det næste åbner. Hvert modul
            består af en kort introduktion, en eller to videoer og øvelser.
          </p>
        </div>
        <div class="bk-start">
          <span class="bk-module-number">Start her</span>
          <p>
            Før det første modul får du en velkomst, en gennemgang af programmets opbygning og en
            oversigt over, hvad du får brug for.
          </p>
        </div>
        <ol class="bk-module-grid">
          {
            modules.map((module, index) => (
              <li>
                <span class="bk-module-number">Modul {index + 1}</span>
                <h3>{module.title}</h3>
                <p>{module.description}</p>
                <p class="bk-module-meta">{module.meta}</p>
                <div class="bk-module-exercises">
                  <span>Øvelser, blandt andet</span>
                  <ul>
                    {module.exercises.map((exercise) => (
                      <li>{exercise}</li>
                    ))}
                  </ul>
                </div>
              </li>
            ))
          }
        </ol>
        <div class="bk-inline-action">
          <p>Du behøver ikke have det hele på plads fra dag ét. Du skal bare i gang.</p>
          <a
            class="button bk-purchase-link"
            href={bodyCourse.checkout}
            data-event="checkout_click"
            data-location="body_modules"
          >
            {bodyCourse.purchaseCta} <Icon size={18} />
          </a>
        </div>
      </div>
    </section>

    <section class="section bk-stories" id="erfaringer" aria-labelledby="stories-heading">
      <div class="container">
        <div class="bk-section-heading">
          <span class="eyebrow">Deltagernes erfaringer</span>
          <h2 id="stories-heading">Hvad siger tidligere deltagere?</h2>
          <p>Deres oplevelser er personlige. Din situation er din egen.</p>
        </div>
        <div class="bk-quote-grid">
          {
            stories.map((story) => (
              <figure>
                <blockquote>“{story.quote}”</blockquote>
                <figcaption>
                  {story.name}
                  <span>Deltager på Bliv glad for din krop</span>
                </figcaption>
              </figure>
            ))
          }
        </div>
        <p class="bk-source">
          Udtalelserne er hentet fra den tidligere salgsside for forløbet.
        </p>
      </div>
    </section>

    <section class="section bk-about" id="om-ditte" aria-labelledby="about-heading">
      <div class="container bk-about-grid">
        <div class="bk-about-image">
          <img
            src="/images/ditte-portrait.webp"
            srcset="/images/ditte-portrait-small.webp 500w, /images/ditte-portrait.webp 900w"
            sizes="(max-width: 800px) 88vw, 38vw"
            width="900"
            height="1600"
            loading="lazy"
            alt="Psykolog Ditte Munch-Andersen"
          />
        </div>
        <div class="bk-reading">
          <span class="eyebrow">Mennesket bag forløbet</span>
          <h2 id="about-heading">Hej, jeg er Ditte.</h2>
          <p>
            Jeg er psykolog og har i mere end 20 år arbejdet med forholdet til mad, krop og
            selvværd. Ikke med slankekure eller hurtige løsninger, men med metoder fra kognitiv
            terapi.
          </p>
          <p>
            Jeg har set, hvor meget tankerne om kroppen kan fylde i en hverdag. Og jeg ved, hvor
            stor en lettelse det kan være at slippe dem.
          </p>
          <ul class="checklist">
            <li>
              <Icon name="check" size={16} /> Cand.psych.aut., uddannet fra Københavns Universitet i
              2004
            </li>
            <li>
              <Icon name="check" size={16} /> MCT Institute® Registered – 2-årig international
              efteruddannelse i Metakognitiv Terapi fra The Metacognitive Therapy Institute (MCTI®)
              v. prof. Adrian Wells
            </li>
            <li>
              <Icon name="check" size={16} /> 2-årig efteruddannelse i Kognitiv Adfærdsterapi (KAT),
              Selskab for Adfærds- og Kognitiv Terapi (SAKT)
            </li>
          </ul>
          <a href="/om-ditte/" class="text-link">Læs om min faglige baggrund <Icon size={17} /></a>
        </div>
      </div>
    </section>

    <section class="section bk-fit" aria-labelledby="fit-heading">
      <div class="container bk-two-column">
        <div>
          <span class="eyebrow">Er forløbet noget for dig?</span>
          <h2 id="fit-heading">Til dig, der er træt af at kæmpe mod din krop.</h2>
        </div>
        <div class="bk-reading">
          <p class="bk-lead">
            Bliv glad for din krop er til dig, der gerne vil have mere ro i hovedet og mere frihed
            i hverdagen. Du behøver ikke have alle svar, før du begynder. Du skal bare have lyst
            til at prøve noget andet end det, du plejer.
          </p>
          <p>Forløbet passer til dig, der:</p>
          <ul class="checklist">
            <li>
              <Icon name="check" size={16} /> vil holde op med at kritisere din krop, men ikke ved
              hvordan
            </li>
            <li><Icon name="check" size={16} /> helst vil arbejde på egen hånd og i dit eget tempo</li>
            <li><Icon name="check" size={16} /> er træt af kure, vægtmål og kostplaner</li>
            <li><Icon name="check" size={16} /> vil have øvelser, du kan bruge i din hverdag</li>
          </ul>
          <p>
            I løbet af de seks moduler lærer du at spotte de tanker, der sætter kropskritikken i
            gang. Du øver dig i at gøre noget andet, og du laver en plan for de dage, hvor spejlet
            driller igen.
          </p>
          <p>
            Metoden kommer fra kognitiv terapi. Forskning i selvstændige forløb om kropsbilledet
            viser, at de kan forbedre det, og at øvelser, hvor man arbejder med sine tanker om
            kroppen, hænger sammen med bedre resultater.<sup
              ><a href="#kilde-1" aria-label="Se kilde 1">1</a></sup
            >
          </p>
          <p>
            Jeg kan ikke love dig et bestemt resultat, for det er forskelligt, hvad der virker for
            hvem. Men der er hverken kostplan eller vægtmål. Her handler det om dit forhold til din
            krop.
          </p>
          <a
            class="button bk-purchase-link"
            href={bodyCourse.checkout}
            data-event="checkout_click"
            data-location="body_fit"
          >
            {bodyCourse.purchaseCta} <Icon size={18} />
          </a>
          <p class="bk-note">
            Forløbet er et selvstudieforløb og ikke behandling. Er du bekymret for dit helbred,
            fremkalder du opkastning, spiser du meget restriktivt, eller har du symptomer på
            anoreksi, så tal med din egen læge. Vil du hellere tale med mig, kan du{' '}
            <a href="/individuelt-forloeb/">bestille individuelle samtaler</a>.
          </p>
          <p class="bk-source" id="kilde-1">
            <sup>1</sup> Kilde: Alleva, J.M., Sheeran, P., Webb, T.L. m.fl. (2015). A meta-analytic
            review of stand-alone interventions to improve body image. <i>PLoS ONE, 10</i>(9),
            e0139177. Gennemgangen omfatter 62 afprøvninger med i alt 3.846 deltagere. Forbedringen
            var i gennemsnit lille til moderat, og efter korrektion for skævheder i studierne var
            den lille, men pålidelig. Den handler om den slags forløb i almindelighed og ikke om
            netop dette forløb.{' '}
            <a href="https://doi.org/10.1371/journal.pone.0139177" rel="noopener">
              doi.org/10.1371/journal.pone.0139177
            </a>
          </p>
