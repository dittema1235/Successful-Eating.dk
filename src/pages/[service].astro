---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import CTA from '../components/CTA.astro';
import { site, formatPrice } from '../data/site';

export function getStaticPaths() {
  return [{ params: { service: 'kropsglaede' } }];
}

const clinicContact = 'https://dittemunchandersen.dk/kontakt/';
const title = 'Kropsaccept: individuelle psykologsamtaler | Successful Eating';
const description =
  'Tal med klinisk psykolog Ditte Munch-Andersen om kropskritik og selvbillede. Individuelle samtaler i Helsingør eller online er et separat tilbud.';
const schema = {
  '@type': 'Service',
  '@id': site.url + '/kropsglaede/#service',
  name: 'Individuelle psykologsamtaler om kropsaccept',
  description,
  serviceType: 'Individuel psykologisk behandling',
  provider: { '@id': site.url + '/#organization' },
  areaServed: { '@type': 'Country', name: 'Danmark' },
  url: site.url + '/kropsglaede/',
};
---

<Layout
  title={title}
  description={description}
  schema={schema}
  breadcrumbs={[{ name: 'Kropsaccept', url: '/kropsglaede/' }]}
>
  <section class="page-hero tone-peach">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Brødkrummer">
        <a href="/">Forside</a><span>/</span><span>Kropsaccept</span>
      </nav>
      <div class="body-hero">
        <div>
          <span class="eyebrow">INDIVIDUELLE SAMTALER · SEPARAT TILBUD</span>
          <h1>Mindre kropskritik. Mere plads til at være dig.</h1>
          <p class="intro">
            Hvis tanker om krop, vægt og udseende fylder for meget, kan vi arbejde med det sammen.
            Et individuelt forløb tager udgangspunkt i din situation, i min klinik i Helsingør
            eller online.
          </p>
          <p>
            Samtalerne er et særskilt psykologisk behandlingstilbud. De er ikke inkluderet i
            Successful Eating – online selvstudieforløb.
          </p>
          <a class="button" href={clinicContact} data-event="clinic_site_click" data-location="body_hero">
            Kontakt klinikken om individuelle samtaler <Icon name="northeast" size={17} />
          </a>
        </div>
        <img
          src="/images/ditte-portrait.webp"
          srcset="/images/ditte-portrait-small.webp 500w, /images/ditte-portrait.webp 900w"
          sizes="(max-width: 820px) 85vw, 36vw"
          width="900"
          height="1600"
          alt="Klinisk psykolog Ditte Munch-Andersen"
        />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container body-content">
      <div>
        <span class="eyebrow">DET KAN VI TALE OM</span>
        <h2>Når kritik af kroppen tager plads fra hverdagen.</h2>
      </div>
      <div class="prose">
        <p>
          Kropskritik kan gøre det svært at være til stede i sociale situationer, vælge tøj,
          bevæge sig frit eller mærke egne behov. Den kan også hænge sammen med gentagne forsøg
          på at styre spisning og vægt.
        </p>
        <p>
          I individuelle samtaler undersøger vi, hvordan det ser ud for dig, og hvilke mønstre
          der er hjælpsomme at arbejde med. Rammer, antal samtaler og pris aftales som del af det
          særskilte tilbud, før du beslutter dig.
        </p>
        <p>
          Hvis du hellere vil begynde med psykologisk viden og øvelser på egen hånd, kan du læse
          om <a href="/forloebet/">Successful Eating – online selvstudieforløb</a>. Det koster{' '}
          {formatPrice(site.productPrice)} inkl. moms og indeholder ikke individuelle samtaler.
        </p>
      </div>
    </div>
  </section>

  <section class="section body-choice">
    <div class="container body-choice-grid">
      <article>
        <span class="eyebrow">INDIVIDUELLE SAMTALER</span>
        <h2>En ramme med personlig kontakt.</h2>
        <p>
          Vi mødes én til én og kan tage udgangspunkt i det, der fylder hos dig. Du kan vælge
          klinikken i Helsingør eller en samtale online.
        </p>
        <a href="/individuelt-forloeb/" class="text-link">
          Læs om individuelle samtaler <Icon size={17} />
        </a>
      </article>
      <article>
        <span class="eyebrow">ONLINE SELVSTUDIE</span>
        <h2>En ramme, hvor du arbejder selv.</h2>
        <p>
          Successful Eating er bygget som 58 dages videoer og øvelser med livslang adgang til
          materialet. Samtaler kan tilkøbes, men er ikke en del af selvstudiet.
        </p>
        <a href="/forloebet/" class="text-link">
          Læs om Successful Eating <Icon size={17} />
        </a>
      </article>
    </div>
  </section>

  <CTA body />
</Layout>

<style>
  .body-hero { display: grid; grid-template-columns: minmax(0,1.2fr) minmax(0,.8fr); gap: clamp(35px,6vw,85px); align-items: center; }
  .body-hero h1 { max-width: 720px; }
  .body-hero .intro { margin-top: 27px; max-width: 640px; }
  .body-hero p:not(.intro) { margin-top: 18px; max-width: 650px; }
  .body-hero .button { margin-top: 28px; }
  .body-hero img { width: 100%; max-width: 420px; border-radius: 20px; justify-self: center; }
  .body-content { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1fr); gap: clamp(35px,7vw,100px); }
  .body-choice { background: var(--sage); }
  .body-choice-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 24px; }
  .body-choice article { background: var(--white); border: 1px solid var(--line); border-radius: 20px; padding: clamp(25px,4vw,42px); }
  .body-choice article p { margin-top: 20px; }
  .body-choice .text-link { margin-top: 24px; }
  @media (max-width: 820px) {
    .body-hero, .body-content, .body-choice-grid { grid-template-columns: 1fr; }
    .body-hero img { justify-self: start; }
  }
</style>
