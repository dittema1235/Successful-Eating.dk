---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import archived from '../data/archive.json';
import library from '../data/library-pages.json';
import { topics } from '../data/topics';
import { site } from '../data/site';
export function getStaticPaths() {
  return [...archived, ...library].map((post) => ({
    params: { legacy: post.slug },
    props: { post },
  }));
}
const { post } = Astro.props;
const revisedLibrary = 'editorialAuthor' in post && post.editorialAuthor;
const topic = topics.find((t) => t.slug === post.topic)!;
// Kropsbillede-artiklerne, der henviser til onlineforløbet Bliv glad for din krop
// i stedet for den gratis guide (guiden hører til Successful Eating-forløbet).
const bodyCoursePosts = [
  'blog/50565-hvordan-vil-det-vaere-at-hade-din-krop',
  'blog/50294-du-behoever-ikke-at-elske-din-krop',
  'blog/50433-har-du-et-problem-med-din-krop-eller-med',
  'blog/54908-man-maa-vaelge-sine-kampe',
];
const nextStep = bodyCoursePosts.includes(post.slug)
  ? {
      title: 'Bliv glad for din krop.',
      text: 'Et onlineforløb over seks uger med undervisning og konkrete øvelser, så du kan arbejde med kropskritik på egen hånd og i dit eget tempo.',
      button: 'Se forløbet',
      href: '/kropsglaede/',
      link: null,
    }
  : post.salesCta
    ? {
        title: 'Begynd med den gratis guide.',
        text: 'Få refleksioner om sult, træthed og overspisning. Guiden er gratis og kan være et første skridt.',
        button: 'Få den gratis guide',
        href: '/gratis-guide/',
        link: { label: 'Se det aktuelle tilbud', href: topic.service },
      }
    : {
        title: 'Mere plads til dig.',
        text: 'Lær Ditte og hendes faglige tilgang at kende, eller begynd med en gratis guide.',
        button: 'Mød Ditte',
        href: '/om-ditte/',
        link: { label: 'Læs om den gratis guide', href: '/gratis-guide/' },
      };
const url = new URL(`/${post.slug}`, site.url).href;
const schema = {
  '@type': revisedLibrary ? 'Article' : 'BlogPosting',
  '@id': `${url}#article`,
  headline: post.title,
  description: post.description,
  mainEntityOfPage: { '@id': `${url}#webpage` },
  url,
  author: { '@id': revisedLibrary ? `${site.url}/#organization` : `${site.url}/om-ditte#person` },
  publisher: { '@id': `${site.url}/#organization` },
  inLanguage: 'da-DK',
  ...(post.published ? { datePublished: post.published } : {}),
  ...(post.editorialUpdated || post.modified
    ? { dateModified: post.editorialUpdated || post.modified }
    : {}),
};
---

<Layout
  title={`${post.title} | Successful Eating`}
  description={post.description}
  schema={schema}
  breadcrumbs={[
    { name: 'Artikelarkiv', url: '/blog' },
    { name: post.title, url: `/${post.slug}` },
  ]}
>
  <article>
    <header class="page-hero">
      <div class="container">
        <nav class="breadcrumbs" aria-label="Brødkrummer">
          <a href="/">Forside</a>
          <span>/</span>
          <a href="/blog">Artikelarkiv</a>
          <span>/</span>
          <a href={`/blog/emner/${topic.slug}`}>{topic.title}</a>
        </nav>
        <span class="eyebrow">{topic.title}</span>
        <h1>{post.title}</h1>
        <div class="article-byline">
          <img src="/images/ditte-portrait-small.webp" width="42" height="42" alt="" />
          <div>
            {revisedLibrary ? 'Redaktion: Successful Eating · Efter en artikel af ' : 'Af '}
            <a href="/om-ditte">Ditte Munch-Andersen</a>
            <span>
              {post.published
                ? `Oprindeligt udgivet ${new Date(post.published).toLocaleDateString('da-DK', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'Europe/Copenhagen' })}`
                : 'Fra artikelarkivet'}
              {post.editorialUpdated
                ? ` · Redaktionelt tilpasset ${new Date(post.editorialUpdated).toLocaleDateString('da-DK', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'Europe/Copenhagen' })}`
                : ''}
            </span>
          </div>
        </div>
      </div>
    </header>
    <div class="section">
      <div class="container content-grid">
        <div>
          <div class="callout" style="margin-top:0">
            <p>
              {revisedLibrary
                ? 'Redaktionelt opdateret med kilder og forslag til videre hjælp. Generel information erstatter ikke en individuel vurdering.'
                : 'Fra Dittes artikelarkiv. Artiklen afspejler tidspunktet, den blev skrevet på. Ældre tilbud og beskrivelser er ikke nødvendigvis aktuelle.'}{' '}
              Find opdaterede introduktioner i{' '}
              <a href="/madro-biblioteket" style="text-decoration:underline">
                Madro-biblioteket
              </a>
              .
            </p>
          </div>
          <div class="prose" set:html={post.body} />
          <div class="library-feature">
            <a class="text-link" href={`/blog/emner/${topic.slug}`}>
              Mere om {topic.title.toLowerCase()} <Icon size={16} />
            </a>
          </div>
        </div>
        <aside class="facts-card">
          <span class="eyebrow">ET NÆSTE SKRIDT</span>
          <h2>{nextStep.title}</h2>
          <p class="small muted">{nextStep.text}</p>
          <a class="button" style="margin-top:23px" href={nextStep.href}>
            {nextStep.button} <Icon size={17} />
          </a>
          {
            nextStep.link && (
              <a class="text-link" style="margin-top:25px" href={nextStep.link.href}>
                {nextStep.link.label} <Icon size={16} />
              </a>
            )
          }
        </aside>
      </div>
    </div>
  </article>
</Layout>
