---
import Layout from '../../../layouts/Layout.astro';
import ArchiveCard from '../../../components/ArchiveCard.astro';
import { topics } from '../../../data/topics';
import posts from '../../../data/archive.json';
import { articles } from '../../../data/articles';
export function getStaticPaths() {
  return topics.map((topic) => ({ params: { topic: topic.slug }, props: { topic } }));
}
const { topic } = Astro.props;
const related = posts.filter((p) => p.topic === topic.slug);
const guides = articles.filter((p) => p.topic === topic.slug);
---

<Layout
  title={`${topic.title} | Successful Eating`}
  description={topic.description}
  breadcrumbs={[
    { name: 'Artikelarkiv', url: '/blog' },
    { name: topic.title, url: `/blog/emner/${topic.slug}` },
  ]}
>
  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Brødkrummer">
        <a href="/">Forside</a>
        <span>/</span>
        <a href="/blog">Artikelarkiv</a>
        <span>/</span>
        <span>{topic.title}</span>
      </nav>
      <span class="eyebrow">VIDEN OM DIT FORHOLD TIL MAD</span>
      <h1>{topic.title}</h1>
      <p class="intro">{topic.intro}</p>
      <div class="actions">
        <a class="button" href={topic.guide}>
          Begynd her →
        </a>
        <a class="text-link" href={topic.service}>
          Læs om behandling →
        </a>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      {guides.length > 0 && (
        <div class="library-feature" style="margin-top:0;margin-bottom:50px">
          <h2 style="margin-bottom:30px">Guides til emnet</h2>
          <div class="archive-list">
            {guides.map((p) => (
              <article class="archive-item">
                <h3>
                  <a href={`/madro-biblioteket/${p.slug}`}>{p.title}</a>
                </h3>
                <p>{p.description}</p>
                <a class="text-link" href={`/madro-biblioteket/${p.slug}`}>
                  Læs artiklen →
                </a>
              </article>
            ))}
          </div>
        </div>
      )}
      <h2 style="margin-bottom:30px">Fra artikelarkivet</h2>
      <div class="archive-list">
        {related.map((post) => (
          <ArchiveCard post={post} />
        ))}
      </div>
    </div>
  </section>
</Layout>
