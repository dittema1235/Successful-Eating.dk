---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
const configured = import.meta.env.PUBLIC_GUIDE_SIGNUP_URL;
let signup: string | undefined;
if (configured) {
  const u = new URL(configured);
  if (
    u.protocol !== 'https:' ||
    (u.hostname === 'www.successfuleating.dk' && u.pathname.replace(/\/$/, '') === '/sulteneller')
  )
    throw Error(
      'PUBLIC_GUIDE_SIGNUP_URL must be an external HTTPS provider URL, not /sulteneller.',
    );
  signup = u.href;
}
const mail = `mailto:${site.email}?subject=${encodeURIComponent('Jeg vil gerne modtage guiden Sulten – eller bare mentalt træt?')}&body=${encodeURIComponent('Hej Ditte\n\nJeg vil gerne bede om din gratis guide.\n\nVenlig hilsen\n')}`;
---

<Layout
  title="Sulten – eller bare mentalt træt? Gratis guide | Successful Eating"
  description="Få den gratis guide af psykolog Ditte Munch-Andersen. Et lille første skridt til at forstå din spisning og finde mere ro i de svære eftermiddage."
  breadcrumbs={[{ name: 'Gratis guide', url: '/sulteneller' }]}
>
  <section class="section">
    <div class="container">
      <div class="guide-panel">
        <div class="guide-art" aria-hidden="true">
          <div class="book-mockup">
            <span class="eyebrow">DIN LILLE GUIDE TIL MERE MADRO</span>
            <h3>
              Sulten –<br />
              eller bare
              <br />
              <em>mentalt træt?</em>
            </h3>
            <Icon name="leaf" size={66} />
            <small>PSYKOLOG DITTE MUNCH-ANDERSEN</small>
          </div>
          <div class="free-badge">
            <span>EN GAVE</span>
            <strong>til dig</strong>
          </div>
        </div>
        <div>
          <span class="eyebrow">EN GRATIS GUIDE FRA DITTE</span>
          <h1 style="font-size:clamp(2.25rem,4vw,3.25rem)">
            Et lille skridt
            <br />
            til mere madro.
          </h1>
          <p class="intro" style="margin-top:23px">
            Få refleksioner og en lille plan til de eftermiddage, hvor overskuddet er væk, og du let
            går på autopilot.
          </p>
          <div class="actions">
            <a
              class="button"
              href={signup || mail}
              data-event={signup ? 'guide_signup_click' : 'guide_request_email_click'}
              data-location="sulteneller"
            >
              {signup ? 'Hent guiden og tilmeld dig' : 'Bed om guiden via e-mail'}{' '}
              <Icon name="northeast" size={17} />
            </a>
          </div>
          <p class="guide-fineprint">
            {signup
              ? 'Du fortsætter til tilmeldingssiden. Læs samtykket til nyhedsbrevet, før du tilmelder dig. Du kan altid afmelde dig igen.'
              : 'Din mail åbnes med en kladde til Ditte. Du bliver ikke automatisk tilmeldt et nyhedsbrev ved at bede om guiden.'}
          </p>
          <a class="text-link" href="/kontakt" style="margin-top:22px">
            Har du spørgsmål? <Icon size={16} />
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
