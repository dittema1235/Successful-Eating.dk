---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import GuideSignup from '../components/GuideSignup.astro';
---

<Layout
  title="Sulten – eller bare mentalt træt? Gratis guide | Successful Eating"
  description="Få den gratis guide af psykolog Ditte Munch-Andersen. Et lille første skridt til at forstå din spisning og finde mere ro i de svære eftermiddage."
  breadcrumbs={[{ name: 'Gratis guide', url: '/sulteneller' }]}
>
  <section class="section">
    <div class="container">
      <div class="guide-panel">
        <div class="guide-art" aria-hidden="true">
          <div class="book-mockup">
            <span class="eyebrow">DIN LILLE GUIDE TIL MERE MADRO</span>
            <h3>
              Sulten –<br />
              eller bare
              <br />
              <em>mentalt træt?</em>
            </h3>
            <Icon name="leaf" size={66} />
            <small>PSYKOLOG DITTE MUNCH-ANDERSEN</small>
          </div>
          <div class="free-badge">
            <span>EN GAVE</span>
            <strong>til dig</strong>
          </div>
        </div>
        <div>
          <span class="eyebrow">EN GRATIS GUIDE FRA DITTE</span>
          <h1 style="font-size:clamp(2.25rem,4vw,3.25rem)">
            Et lille skridt
            <br />
            til mere madro.
          </h1>
          <p class="intro" style="margin-top:23px">
            Få refleksioner og en lille plan til de eftermiddage, hvor overskuddet er væk, og du let
            går på autopilot.
          </p>
          <div class="actions">
            <GuideSignup location="sulteneller">Ja tak, send mig guiden</GuideSignup>
          </div>
          <p class="guide-fineprint">
            Du tilmelder dig den gratis guide og e-mails fra Ditte om overspisning. Du kan altid
            afmelde dig via linket i hver e-mail.
          </p>
          <a class="text-link" href="/kontakt" style="margin-top:22px">
            Har du spørgsmål? <Icon size={16} />
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
