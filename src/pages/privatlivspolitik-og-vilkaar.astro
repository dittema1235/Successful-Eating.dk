---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
---

<Layout
  title="Privatlivspolitik og vilkår | Successful Eating"
  description="Find privatlivsoplysninger, cookievalg og handelsbetingelser for Successful Eating hos psykolog Ditte Munch-Andersen."
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">TRYGHED & GENNEMSIGTIGHED</span>
      <h1>Privatlivspolitik og vilkår</h1>
      <p class="intro">
        Her kan du finde oplysninger om dine data og de vilkår, der gælder for behandling og
        tilmelding.
      </p>
    </div>
  </section>
  <section class="section">
    <div class="container contact-grid">
      <div class="contact-card">
        <h2>Privatliv & cookies</h2>
        <p>Om tekniske oplysninger, eksterne tjenester, dine rettigheder og cookievalg.</p>
        <a href="/privatliv" class="text-link" style="margin-top:20px">
          Læs privatlivsoplysningerne <Icon size={17} />
        </a>
      </div>
      <div class="contact-card">
        <h2>Handelsbetingelser</h2>
        <p>Om priser, betaling, afbud, fortrydelse og det praktiske ved behandling.</p>
        <a href="/terms" class="text-link" style="margin-top:20px">
          Læs handelsbetingelserne <Icon size={17} />
        </a>
      </div>
    </div>
  </section>
</Layout>
