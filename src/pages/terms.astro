---
import Layout from '../layouts/Layout.astro';
import originalTerms from '../data/original-terms.html?raw';
---

<Layout
  title="Handelsbetingelser | Successful Eating"
  description="Handelsbetingelser for behandling og ydelser hos psykolog Ditte Munch-Andersen. Læs om betaling, afbud, rettigheder og behandling af personoplysninger."
  breadcrumbs={[{ name: 'Handelsbetingelser', url: '/terms' }]}
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">VILKÅR & PRAKTISK INFORMATION</span>
      <h1>Handelsbetingelser</h1>
      <p class="intro">
        Her finder du de eksisterende vilkår for ydelser hos psykolog Ditte Munch-Andersen.
      </p>
    </div>
  </section>
  <section class="section">
    <div class="container simple-page">
      <div class="callout">
        <p>
          Vilkårene nedenfor er videreført fra det tidligere website. For denne hjemmesides brug af
          cookies og eksterne tjenester gælder også{' '}
          <a class="text-link" href="/privatliv">
            privatlivsoplysningerne
          </a>
          . De konkrete priser og betalingsvilkår fremgår før tilmelding.
        </p>
      </div>
      <div class="prose" set:html={originalTerms} />
    </div>
  </section>
</Layout>
