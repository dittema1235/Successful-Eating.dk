---
import Icon from './Icon.astro';
import { faqs } from '../data/site';
---

<section class="section faq-section" id="spoergsmaal">
  <div class="container faq-grid">
    <div class="faq-intro">
      <span class="eyebrow">DET MÅ DU GERNE SPØRGE OM</span>
      <h2>Spørgsmål om onlineforløbet</h2>
      <p>Her er de vigtigste svar om indhold, adgang og individuelle samtaler.</p>
      <a href="/kontakt" class="text-link">
        Spørg Ditte <Icon size={17} />
      </a>
    </div>
    <div class="faq-list">
      {faqs.map((faq) => (
        <details>
          <summary>{faq.question}</summary>
          <p>{faq.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>
