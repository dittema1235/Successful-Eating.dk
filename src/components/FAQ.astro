---
import Icon from './Icon.astro';
import { faqs } from '../data/site';
---

<section class="section faq-section" id="spoergsmaal">
  <div class="container faq-grid">
    <div class="faq-intro">
      <span class="eyebrow">DET MÅ DU GERNE SPØRGE OM</span>
      <h2>Spørgsmål om behandling og pris</h2>
      <p>Det er naturligt at have spørgsmål, før du tager det første skridt.</p>
      <a href="/kontakt" class="text-link">
        Spørg Ditte <Icon size={17} />
      </a>
    </div>
    <div class="faq-list">
      {faqs.map((faq) => (
        <details>
          <summary>{faq.question}</summary>
          <p>{faq.answer}</p>
          {'source' in faq && faq.source && (
            <p class="faq-source">
              Kilde: <a href={faq.source.href}>{faq.source.label}</a>.
            </p>
          )}
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-source {
    margin-top: -8px;
    color: var(--muted);
    font-size: var(--text-small);
  }
  .faq-source a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
