---
import Icon from './Icon.astro';
import { site, formatPrice } from '../data/site';
---

<section class="section purchase-section" id="priser" aria-labelledby="purchase-heading">
  <div class="container purchase-layout">
    <div class="purchase-copy">
      <span class="eyebrow">SUCCESSFUL EATING · PRIS & ADGANG</span>
      <h2 id="purchase-heading">Et online selvstudieforløb til {formatPrice(site.productPrice)} inkl. moms.</h2>
      <p class="intro">
        Du får 58 dages struktur med et fundament og syv moduler. Materialet består af
        videoundervisning og øvelser, som du arbejder med på egen hånd.
      </p>
      <p>Du har livslang adgang til onlineforløbets materiale og kan vende tilbage til det senere.</p>
      <a href="/forloebet/" class="text-link">
        Se hele onlineforløbet <Icon size={17} />
      </a>
    </div>
    <div class="purchase-card">
      <span class="eyebrow">ONLINE SELVSTUDIEFORLØB</span>
      <h3>Successful Eating</h3>
      <strong class="purchase-price">{formatPrice(site.productPrice)}</strong>
      <p>inkl. moms</p>
      <ul>
        <li><Icon name="check" size={18} /> Fundament og syv moduler over 58 dage</li>
        <li><Icon name="check" size={18} /> Videoundervisning og øvelser</li>
        <li><Icon name="check" size={18} /> Livslang adgang til materialet</li>
      </ul>
      <p class="purchase-note">
        Individuelle samtaler og personlig sparring er ikke inkluderet. Samtaler med Ditte kan
        købes separat.
      </p>
      <a class="button" href={site.checkout} data-event="checkout_click" data-location="purchase_options">
        {site.purchaseCta} <Icon name="northeast" size={17} />
      </a>
      <small>Du fortsætter til betaling hos systeme.io.</small>
      <a class="purchase-terms" href="/terms/">Læs handelsbetingelserne</a>
    </div>
  </div>
</section>

<style>
  .purchase-section { background: var(--sand); scroll-margin-top: 110px; }
  .purchase-layout { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,.9fr); gap: clamp(35px,7vw,100px); align-items: center; }
  .purchase-copy h2 { max-width: 650px; }
  .purchase-copy .intro { margin-top: 24px; }
  .purchase-copy > p:not(.intro) { margin-top: 18px; max-width: 580px; }
  .purchase-copy .text-link { margin-top: 26px; }
  .purchase-card { background: var(--white); border: 1px solid var(--line); border-radius: 23px; padding: clamp(27px,4vw,45px); box-shadow: 0 20px 50px #294c3d12; }
  .purchase-card h3 { margin-bottom: 18px; }
  .purchase-price { font-family: var(--serif); font-weight: 520; font-size: clamp(3rem,5vw,4.5rem); line-height: 1; display: block; }
  .purchase-card > p { color: var(--muted); }
  .purchase-card ul { list-style: none; padding: 22px 0; margin: 22px 0; border-block: 1px solid var(--line); }
  .purchase-card li { display: flex; gap: 12px; align-items: flex-start; padding-block: 7px; }
  .purchase-card li svg { margin-top: 5px; color: var(--green); }
  .purchase-card .purchase-note { color: var(--ink); font-size: .95rem; line-height: 1.6; }
  .purchase-card .button { width: 100%; margin-top: 24px; }
  .purchase-card small, .purchase-terms { display: block; margin-top: 12px; font-size: .88rem; text-align: center; line-height: 1.5; color: var(--muted); }
  .purchase-terms { color: var(--green); text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 820px) { .purchase-layout { grid-template-columns: 1fr; } }
</style>
