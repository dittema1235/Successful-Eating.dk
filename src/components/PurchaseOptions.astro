---
import Icon from './Icon.astro';
import { site, consultation, formatPrice } from '../data/site';
interface Props {
  explainPrice?: boolean;
}
const { explainPrice = false } = Astro.props;
---

<section class="section purchase-section" id="priser" aria-labelledby="purchase-heading">
  <div class="container">
    <div class="section-heading">
      <div>
        <span class="eyebrow">SUCCESSFUL EATING · PRIS & OPSTART</span>
        <h2 id="purchase-heading">
          {explainPrice ? (
            <>
              Hvad får du for{' '}
              <span class="price-together">{formatPrice(site.treatmentPrice)}?</span>
            </>
          ) : (
            'To måder at tage det første skridt.'
          )}
        </h2>
        <a class="purchase-trust" href={site.trustpilot}>
          Se vores anmeldelser på Trustpilot
        </a>
      </div>
      <p class="intro">
        {explainPrice
          ? '“Det er da mange penge.” Det er en helt fair tanke. Når du vurderer, om forløbet giver mening for dig, er det værd at se på, hvad prisen dækker.'
          : 'Begynd med hele forløbet eller med en forsamtale. Begge veje giver plads til at finde ud af, om behandlingen passer til dig.'}
      </p>
    </div>
    {explainPrice && (
      <div class="purchase-context">
        <div>
          <h3>8 ugers terapi, viden og træning</h3>
          <ul>
            <li>En individuel forsamtale med mig på {site.consultationMinutes} minutter</li>
            <li>4 online gruppeterapier med højst 6 deltagere</li>
            <li>Ca. 5 timers video i små bidder og daglige øvelser</li>
            <li>12 ugers adgang til video, øvelser og materiale</li>
          </ul>
          <a class="text-link" href="#det-faar-du">
            Læs om de fire dele af forløbet <Icon size={17} />
          </a>
        </div>
        <div>
          <h3>Prisen i perspektiv</h3>
          <p>
            Min normale psykologtakst er{' '}
            <strong>{formatPrice(site.psychologistHourlyRate)} i timen.</strong> I Successful Eating
            får du et sammenhængende forløb til{' '}
            <strong>{formatPrice(site.treatmentPrice)} i alt</strong>, hvor forsamtalen og
            gruppeterapien understøttes af viden og træning mellem samtalerne.
          </p>
          <p>
            <strong>Medlem af Sygeforsikringen “danmark”?</strong> Du kan muligvis få tilskud til
            psykologbehandlingen. I forsamtalen vurderer vi din situation; det konkrete tilskud
            afhænger af din situation og dit medlemskab. <a href="#tilskud">Læs om tilskud</a>.
          </p>
        </div>
      </div>
    )}
    <div class="purchase-grid">
      <article class="purchase-card purchase-primary">
        <span class="eyebrow">FORLØB MED FORSAMTALE</span>
        <h3>Start på Successful Eating</h3>
        <p class="purchase-price">{formatPrice(site.treatmentPrice)}</p>
        <p>
          Otte ugers psykologisk behandling online. En individuel forsamtale er inkluderet i prisen.
        </p>
        <div class="purchase-highlight">
          <Icon name="shield" size={23} />
          <p>
            <strong>Alle pengene tilbage ved et dårligt match.</strong> Vurderes forløbet ved
            forsamtalen ikke at passe til dig, får du hele det indbetalte beløb tilbage.
          </p>
        </div>
        <a
          class="button"
          href={site.checkout}
          data-event="checkout_click"
          data-location="purchase_options"
        >
          Køb forløbet · {formatPrice(site.treatmentPrice)} <Icon name="northeast" size={17} />
        </a>
        <p class="small muted">Du fortsætter til betaling hos systeme.io.</p>
      </article>
      <article class="purchase-card">
        <span class="eyebrow">FORSAMTALE FØRST</span>
        <h3>Find ud af, hvad der passer til dig</h3>
        <p class="purchase-price">
          {formatPrice(site.consultationPrice)} <span>/ {site.consultationMinutes} minutter</span>
        </p>
        <p>
          En individuel klinisk forsamtale med Ditte, hvor I undersøger dine behov og vurderer, om
          forløbet er det rette næste skridt.
        </p>
        <div class="purchase-highlight">
          <Icon name="check" size={23} />
          <p>
            <strong>Beløbet modregnes, hvis du vælger forløbet.</strong> Du betaler derefter{' '}
            {formatPrice(site.treatmentPrice - site.consultationPrice)} mere – altså{' '}
            {formatPrice(site.treatmentPrice)} i alt.
          </p>
        </div>
        <a
          class="button button-outline"
          href={consultation.href}
          data-event={
            consultation.online ? 'consultation_booking_click' : 'consultation_request_email_click'
          }
          data-location="purchase_options"
        >
          {consultation.online
            ? `Book forsamtale · ${formatPrice(site.consultationPrice)}`
            : 'Aftal forsamtale via e-mail'}{' '}
          <Icon name="northeast" size={17} />
        </a>
        <p class="small muted">
          {consultation.online
            ? 'Du fortsætter til booking og betaling.'
            : 'Din mail åbnes. Tid og betaling aftales med Ditte; et klik er ikke en booking.'}
        </p>
      </article>
    </div>
    <p class="purchase-terms">
      Læs <a href="/terms">handelsbetingelserne</a>, eller <a href="/kontakt">kontakt Ditte</a>,
      hvis du har spørgsmål.
    </p>
  </div>
</section>

<style>
  .purchase-section {
    background: var(--paper);
    scroll-margin-top: 110px;
  }
  .section-heading h2 {
    max-width: 600px;
  }
  .price-together {
    white-space: nowrap;
  }
  .purchase-trust {
    display: inline-flex;
    align-items: center;
    margin-top: 18px;
    color: var(--green);
    font-size: var(--text-small);
    line-height: 1.4;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .purchase-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 26px;
  }
  .purchase-context {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(28px, 5vw, 64px);
    padding-bottom: 36px;
    margin-bottom: 36px;
    border-bottom: 1px solid var(--line);
  }
  .purchase-context h3 {
    margin-bottom: 16px;
    font-size: clamp(1.5rem, 2.5vw, 1.875rem);
  }
  .purchase-context ul {
    margin: 0 0 20px;
    padding-left: 1.2em;
  }
  .purchase-context li + li {
    margin-top: 10px;
  }
  .purchase-context p + p {
    margin-top: 18px;
  }
  .purchase-context p a {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .purchase-context .text-link {
    font-size: var(--text-small);
  }
  .purchase-card {
    padding: clamp(25px, 3vw, 44px);
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--white);
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .purchase-primary {
    background: var(--sage);
  }
  .purchase-card h3 {
    font-size: clamp(1.6875rem, 3vw, 2.1875rem);
    line-height: 1.15;
  }
  .purchase-price {
    font-size: 2.375rem;
    font-weight: 600;
    color: var(--green);
    line-height: 1.2;
  }
  .purchase-price span {
    display: inline-block;
    font-size: var(--text-body);
    font-weight: 400;
  }
  .purchase-highlight {
    display: flex;
    gap: 13px;
    border-top: 1px solid var(--line);
    padding-top: 20px;
    margin-bottom: auto;
  }
  .purchase-highlight :global(svg) {
    flex-shrink: 0;
    margin-top: 3px;
  }
  .purchase-highlight p {
    font-size: var(--text-body);
  }
  .purchase-highlight strong {
    display: block;
    margin-bottom: 6px;
  }
  .purchase-card .button {
    align-self: flex-start;
    text-align: center;
  }
  .purchase-terms {
    margin-top: 25px;
    font-size: var(--text-small);
    text-align: center;
  }
  .purchase-terms a {
    text-decoration: underline;
  }
  @media (max-width: 700px) {
    .purchase-context,
    .purchase-grid {
      grid-template-columns: 1fr;
    }
    .purchase-card .button {
      width: 100%;
    }
  }
</style>
