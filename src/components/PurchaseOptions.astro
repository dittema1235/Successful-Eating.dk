---
import Icon from './Icon.astro';
import { site, consultation, formatPrice } from '../data/site';
interface Props {
  explainPrice?: boolean;
}
const { explainPrice = false } = Astro.props;
---

<section class="section purchase-section" id="priser" aria-labelledby="purchase-heading">
  <div class="container">
    <div class="section-heading">
      <div>
        <span class="eyebrow">FRI FRA OVERSPISNING · PRIS & OPSTART</span>
        <h2 id="purchase-heading">
          {explainPrice ? (
            <>
              Hvad får du for{' '}
              <span class="price-together">{formatPrice(site.treatmentPrice)}?</span>
            </>
          ) : (
            'To måder at tage det første skridt.'
          )}
        </h2>
        <a class="purchase-trust" href={site.trustpilot}>
          Se vores anmeldelser på Trustpilot
        </a>
      </div>
      <p class="intro">
        {explainPrice
          ? '“Det er da mange penge.” Det er en helt fair tanke. Når du vurderer, om forløbet giver mening for dig, er det værd at se på, hvad prisen dækker.'
          : 'Begynd med hele forløbet eller med en forsamtale. Begge veje giver plads til at finde ud af, om behandlingen passer til dig.'}
      </p>
    </div>
    {explainPrice && (
      <div class="purchase-context">
        <div>
          <h3>
            Et omfattende behandlingsforløb til{' '}
            <span class="price-together">{formatPrice(site.treatmentPrice)}</span>
          </h3>
          <p>
            Min normale psykologtakst er{' '}
            <strong>{formatPrice(site.psychologistHourlyRate)} i timen.</strong> Fri fra overspisning
            koster <strong>{formatPrice(site.treatmentPrice)} i alt.</strong>
          </p>
          <p>
            Du får <strong>5 terapigange med mig</strong> – én individuel forsamtale og fire
            gruppeterapigange – plus ca. 5 timers videoundervisning og øvelser, som du arbejder med
            mellem møderne.
          </p>
          <p>
            I videoerne får du den viden og erfaring, jeg har samlet gennem mere end 20 år som
            psykolog, og som ligger til grund for den måde, jeg arbejder med overspisning på.
          </p>
          <p>
            Hvis jeg skulle give dig al den viden og undervisning, du får gennem videoerne, i
            terapirummet, ville det kræve mange ekstra timer. Efter min vurdering svarer indholdets
            samlede omfang derfor omtrent til <strong>10 individuelle psykologsamtaler</strong>,
            hvis al undervisning og terapi skulle foregå individuelt.
          </p>
          <p>
            Ved at kombinere individuel samtale, gruppeterapi og videoundervisning kan jeg tilbyde
            et omfattende behandlingsforløb til en væsentligt lavere pris end et tilsvarende
            individuelt forløb.
          </p>
          <p>
            Det er kombinationen af viden, træning og terapi, der gør Fri fra overspisning til et
            samlet behandlingsforløb – til en overkommelig pris.
          </p>
        </div>
        <div class="purchase-details">
          <div>
            <h3>8 ugers terapi, viden og træning</h3>
            <ul>
              <li>En individuel forsamtale med mig på {site.consultationMinutes} minutter</li>
              <li>4 online gruppeterapier med højst 6 deltagere</li>
              <li>Ca. 5 timers video i små bidder og daglige øvelser</li>
              <li>12 ugers adgang til video, øvelser og materiale</li>
            </ul>
            <a class="text-link" href="#det-faar-du">
              Læs om de fire dele af forløbet <Icon size={17} />
            </a>
          </div>
          <div>
            <h3>Resultater fra 2024</h3>
            <p>I brugerundersøgelsen fra 2024 blandt deltagere, der gennemførte forløbet:</p>
            <ul class="purchase-results">
              <li>
                <strong>78 %</strong> havde ingen eller højst én overspisning de sidste 2 uger af
                forløbet.
              </li>
              <li>
                <strong>43 %</strong> oplevede forbedret psykisk helbred.
              </li>
              <li>
                <strong>29 %</strong> oplevede markant bedre fysisk helbred.
              </li>
            </ul>
            <p class="small">
              Resultaterne er individuelle.{' '}
              <a href="/resultater#dokumenterede-resultater">
                Læs mere om undersøgelsen og resultaterne
              </a>
              .
            </p>
          </div>
          <p>
            <strong>Medlem af Sygeforsikringen “danmark”?</strong> Du kan muligvis få tilskud til
            psykologbehandlingen. I forsamtalen vurderer vi din situation; det konkrete tilskud
            afhænger af din situation og dit medlemskab. <a href="#tilskud">Læs om tilskud</a>.
          </p>
        </div>
      </div>
    )}
    <div class="purchase-grid">
      <article class="purchase-card purchase-primary">
        <span class="eyebrow">FORLØB MED FORSAMTALE</span>
        <h3>Start på Fri fra overspisning</h3>
        <p class="purchase-price">{formatPrice(site.treatmentPrice)}</p>
        <p>
          Otte ugers psykologisk behandling online. En individuel forsamtale er inkluderet i prisen.
        </p>
        <div class="purchase-highlight">
          <Icon name="shield" size={23} />
          <p>
            <strong>Alle pengene tilbage ved et dårligt match.</strong> Vurderes forløbet ved
            forsamtalen ikke at passe til dig, får du hele det indbetalte beløb tilbage.
          </p>
        </div>
        {
          explainPrice ? (
            <a
              class="button"
              href={site.checkout}
              data-event="checkout_click"
              data-location="purchase_options"
            >
              Køb forløbet · {formatPrice(site.treatmentPrice)} <Icon name="northeast" size={17} />
            </a>
          ) : (
            <a
              class="button"
              href="/forloebet"
              data-event="service_click"
              data-location="purchase_options"
            >
              Se forløbet og tilmelding <Icon size={17} />
            </a>
          )
        }
        <p class="small muted">
          {
            explainPrice
              ? 'Du fortsætter til betaling hos systeme.io.'
              : 'Du ser indhold, pris og tilmelding på forløbssiden.'
          }
        </p>
      </article>
      <article class="purchase-card">
        <span class="eyebrow">FORSAMTALE FØRST</span>
        <h3>Find ud af, hvad der passer til dig</h3>
        <p class="purchase-price">
          {formatPrice(site.consultationPrice)} <span>/ {site.consultationMinutes} minutter</span>
        </p>
        <p>
          En individuel klinisk forsamtale med Ditte, hvor I undersøger dine behov og vurderer, om
          forløbet er det rette næste skridt.
        </p>
        <div class="purchase-highlight">
          <Icon name="check" size={23} />
          <p>
            <strong>Beløbet modregnes, hvis du vælger forløbet.</strong> Du betaler derefter{' '}
            {formatPrice(site.treatmentPrice - site.consultationPrice)} mere – altså{' '}
            {formatPrice(site.treatmentPrice)} i alt.
          </p>
        </div>
        <a
          class="button button-outline"
          href={consultation.href}
          data-event={
            consultation.online ? 'consultation_booking_click' : 'consultation_request_email_click'
          }
          data-location="purchase_options"
        >
          {consultation.online
            ? `Book forsamtale · ${formatPrice(site.consultationPrice)}`
            : 'Aftal forsamtale via e-mail'}{' '}
          <Icon name="northeast" size={17} />
        </a>
        <p class="small muted">
          {consultation.online
            ? 'Du fortsætter til booking og betaling.'
            : 'Din mail åbnes. Tid og betaling aftales med Ditte; et klik er ikke en booking.'}
        </p>
      </article>
    </div>
    <p class="purchase-terms">
      Læs <a href="/terms">handelsbetingelserne</a>, eller <a href="/kontakt">kontakt Ditte</a>,
      hvis du har spørgsmål.
    </p>
  </div>
</section>

<style>
  .purchase-section {
    background: var(--paper);
    scroll-margin-top: 110px;
  }
  .section-heading h2 {
    max-width: 600px;
  }
  .price-together {
    white-space: nowrap;
  }
  .purchase-trust {
    display: inline-flex;
    align-items: center;
    margin-top: 18px;
    color: var(--green);
    font-size: var(--text-small);
    line-height: 1.4;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .purchase-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 26px;
  }
  .purchase-context {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: clamp(28px, 5vw, 64px);
    padding-bottom: 36px;
    margin-bottom: 36px;
    border-bottom: 1px solid var(--line);
  }
  .purchase-context h3 {
    margin-bottom: 16px;
    font-size: clamp(1.5rem, 2.5vw, 1.875rem);
  }
  .purchase-context ul {
    margin: 0 0 20px;
    padding-left: 1.2em;
  }
  .purchase-context li + li {
    margin-top: 10px;
  }
  .purchase-context p + p {
    margin-top: 18px;
  }
  .purchase-context p a {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .purchase-details {
    display: grid;
    gap: 28px;
    align-content: start;
  }
  .purchase-context .purchase-results {
    margin-top: 16px;
  }
  .purchase-context .text-link {
    font-size: var(--text-small);
  }
  .purchase-card {
    padding: clamp(25px, 3vw, 44px);
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--white);
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .purchase-primary {
    background: var(--sage);
  }
  .purchase-card h3 {
    font-size: clamp(1.6875rem, 3vw, 2.1875rem);
    line-height: 1.15;
  }
  .purchase-price {
    font-size: 2.375rem;
    font-weight: 600;
    color: var(--green);
    line-height: 1.2;
  }
  .purchase-price span {
    display: inline-block;
    font-size: var(--text-body);
    font-weight: 400;
  }
  .purchase-highlight {
    display: flex;
    gap: 13px;
    border-top: 1px solid var(--line);
    padding-top: 20px;
    margin-bottom: auto;
  }
  .purchase-highlight :global(svg) {
    flex-shrink: 0;
    margin-top: 3px;
  }
  .purchase-highlight p {
    font-size: var(--text-body);
  }
  .purchase-highlight strong {
    display: block;
    margin-bottom: 6px;
  }
  .purchase-card .button {
    align-self: flex-start;
    text-align: center;
  }
  .purchase-terms {
    margin-top: 25px;
    font-size: var(--text-small);
    text-align: center;
  }
  .purchase-terms a {
    text-decoration: underline;
  }
  @media (max-width: 700px) {
    .purchase-context,
    .purchase-grid {
      grid-template-columns: 1fr;
    }
    .purchase-card .button {
      width: 100%;
    }
  }
</style>
