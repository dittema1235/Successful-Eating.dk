---
import Icon from './Icon.astro';
import { services } from '../data/site';
---

<section class="section courses-section" id="forloeb">
  <div class="container">
    <div class="section-heading">
      <div>
        <span class="eyebrow">VÆLG DET, DER PASSER TIL DIG</span>
        <h2>
          Begynd med din spisning.
          <br />
          Eller med din krop.
        </h2>
      </div>
      <p class="intro">
        Successful Eating og Bliv glad for din krop er onlineforløb, du gennemfører på egen hånd.
        Vil du hellere tale med Ditte, kan du bestille individuelle samtaler som et separat tilbud.
      </p>
    </div>
    <div class="course-grid">
      {services.map((s) => (
        <article class="course-card">
          <div class="course-top">
            <div class={`course-icon tone-${s.tone}`}>
              <Icon name={s.icon} size={29} />
            </div>
            <span class="course-tag">{s.tag}</span>
          </div>
          <span class="eyebrow">{s.eyebrow}</span>
          <h3>{s.title}</h3>
          <p>{s.intro}</p>
          <ul class="checklist">
            {s.features.map((f) => (
              <li>
                <Icon name="check" size={16} />
                {f}
              </li>
            ))}
          </ul>
          <a
            href={`/${s.slug}`}
            class="text-link"
            data-event="service_click"
            data-location={s.slug}
          >
            {s.linkLabel} <Icon size={18} />
          </a>
        </article>
      ))}
    </div>
    <p class="course-help">
      Har du spørgsmål til forskellen? <a href="/kontakt">Kontakt Ditte</a> eller se{' '}
      <a href="/individuelt-forloeb/">individuelle samtaler</a>.
    </p>
  </div>
</section>
