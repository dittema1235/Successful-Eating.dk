---
import Icon from './Icon.astro';
import { services } from '../data/site';
---

<section class="section courses-section" id="forloeb">
  <div class="container">
    <div class="section-heading">
      <div>
        <span class="eyebrow">VÆLG DEN RAMME, DER PASSER DIG</span>
        <h2>
          Arbejd selvstændigt.
          <br />
          Eller tal med Ditte.
        </h2>
      </div>
      <p class="intro">
        Successful Eating er et online selvstudieforløb. Individuelle samtaler er et separat
        tilbud, som du kan købe, hvis du ønsker personlig kontakt.
      </p>
    </div>
    <div class="course-grid">
      {services.map((s) => (
        <article class="course-card">
          <div class="course-top">
            <div class={`course-icon tone-${s.tone}`}>
              <Icon name={s.icon} size={29} />
            </div>
            <span class="course-tag">{s.tag}</span>
          </div>
          <span class="eyebrow">{s.eyebrow}</span>
          <h3>{s.title}</h3>
          <p>{s.intro}</p>
          <ul class="checklist">
            {s.features.map((f) => (
              <li>
                <Icon name="check" size={16} />
                {f}
              </li>
            ))}
          </ul>
          <a
            href={`/${s.slug}`}
            class="text-link"
            data-event="service_click"
            data-location={s.slug}
          >
            Læs om {s.slug === 'kropsglaede' ? 'individuel kropsaccept' : 'Successful Eating'} <Icon size={18} />
          </a>
        </article>
      ))}
    </div>
    <p class="course-help">
      Har du spørgsmål til forskellen? <a href="/kontakt">Kontakt Ditte.</a>
    </p>
  </div>
</section>
