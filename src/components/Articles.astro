---
import Icon from './Icon.astro';
import { articles, type Article } from '../data/articles';
interface Props {
  limit?: number;
  items?: Article[];
}
const { limit, items = articles }: Props = Astro.props;
const list = items.slice(0, limit ?? items.length);
---

<div class="article-grid">
  {list.map((a) => (
    <article class="article-card">
      <a href={`/madro-biblioteket/${a.slug}`}>
        <div class={`article-illustration tone-${a.tone}`} aria-hidden="true">
          <span class="illustration-word">{a.word}</span>
        </div>
        <span class="eyebrow">
          {a.category} · {a.readTime} læsning
        </span>
        <h3>{a.title}</h3>
        <p>{a.description}</p>
        <span class="text-link">
          Læs artiklen <Icon size={16} />
        </span>
      </a>
    </article>
  ))}
</div>
