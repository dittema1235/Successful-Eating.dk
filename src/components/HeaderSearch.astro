---
import Icon from './Icon.astro';
---

<div class="search-strip">
  <form
    class="container header-search"
    role="search"
    aria-label="Søg i artikler"
    action="/blog#archive-search"
    method="get"
  >
    <label for="header-query">Søg i artiklerne</label>
    <div class="search-field">
      <Icon name="search" size={19} />
      <input
        id="header-query"
        type="search"
        name="q"
        placeholder="Søg i artiklerne …"
        autocomplete="off"
      />
    </div>
    <button class="button button-small" type="submit">
      Søg
    </button>
  </form>
</div>

<script>
  const headerQuery = document.querySelector<HTMLInputElement>('#header-query');
  if (headerQuery) headerQuery.value = new URLSearchParams(location.search).get('q') || '';
</script>

<style>
  .search-strip {
    padding-block: 12px;
    background: var(--sand);
    border-bottom: 1px solid var(--line);
  }
  .header-search {
    display: flex;
    align-items: stretch;
    gap: 10px;
    max-width: 640px;
  }
  label {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
  .search-field {
    position: relative;
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: center;
    background: var(--white);
    border: 1px solid var(--muted);
    border-radius: 5px;
  }
  .search-field :global(svg) {
    position: absolute;
    left: 14px;
    pointer-events: none;
    color: var(--muted);
  }
  input {
    width: 100%;
    min-width: 0;
    min-height: 44px;
    padding: 8px 12px 8px 42px;
    background: transparent;
    color: var(--ink);
    border: 0;
    border-radius: inherit;
    font-size: var(--text-body);
  }
  input::placeholder {
    color: var(--muted);
    opacity: 1;
  }
  button {
    flex-shrink: 0;
    min-width: 68px;
  }
</style>
