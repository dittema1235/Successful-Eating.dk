---
import Icon from './Icon.astro';
import { pagePath } from '../data/site';
interface Props {
  post: { slug: string; title: string; description: string; published?: string | null };
}
const { post } = Astro.props;
const href = pagePath(`/${post.slug}`);
---

<article class="archive-item">
  {post.published && (
    <time datetime={post.published}>
      {new Date(post.published).toLocaleDateString('da-DK', {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
        timeZone: 'Europe/Copenhagen',
      })}
    </time>
  )}
  <h2>
    <a href={href}>{post.title}</a>
  </h2>
  <p>{post.description}</p>
  <a class="text-link" href={href}>
    Læs artiklen <Icon size={15} />
  </a>
</article>
