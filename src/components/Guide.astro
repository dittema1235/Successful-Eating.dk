---
import Icon from './Icon.astro';
import GuideSignup from './GuideSignup.astro';
---

<section class="guide-section" id="gratis-guide">
  <div class="container">
    <div class="guide-panel">
      <div class="guide-art" aria-hidden="true">
        <div class="book-mockup">
          <span class="eyebrow">DIN LILLE GUIDE TIL MERE MADRO</span>
          <h3>
            Sulten –<br />
            eller bare
            <br />
            <em>mentalt træt?</em>
          </h3>
          <Icon name="leaf" size={66} />
          <small>PSYKOLOG DITTE MUNCH-ANDERSEN</small>
        </div>
        <div class="free-badge">
          <span>EN GAVE</span>
          <strong>til dig</strong>
        </div>
      </div>
      <div>
        <span class="eyebrow">ET LILLE SKRIDT. HELT GRATIS.</span>
        <h2>
          Når dagen er lang,
          <br />
          og overskuddet er væk.
        </h2>
        <p class="intro">
          Kender du trætheden, der sender dig på autopilot i køkkenet? I min gratis guide får du
          enkle refleksioner og en lille plan til de svære eftermiddage.
        </p>
        <div class="actions">
          <GuideSignup location="guide_section">Ja tak, jeg vil gerne have guiden</GuideSignup>
        </div>
        <p class="guide-fineprint">
          Gratis guide og e-mails om overspisning. Du kan altid afmelde dig.
        </p>
      </div>
    </div>
  </div>
</section>
