---
import Icon from './Icon.astro';
import { site, formatPrice } from '../data/site';
---

<section class="closing-cta">
  <div class="container">
    <span class="eyebrow">DU BEHØVER IKKE HAVE ALLE SVARENE</span>
    <h2>Det første skridt må gerne være lille.</h2>
    <p>
      Du kan starte med hele forløbet inklusive en gratis forsamtale, eller købe en forsamtale først
      og få beløbet modregnet, hvis du vælger at fortsætte.
    </p>
    <div class="actions">
      <a class="button" href="/forloebet#priser" data-event="pricing_click" data-location="closing">
        Se de to muligheder <Icon size={17} />
      </a>
      <a class="text-link" href="/kontakt">
        Skriv til Ditte <Icon size={17} />
      </a>
    </div>
    <p class="small">
      Forløb: {formatPrice(site.treatmentPrice)} · Forsamtale: {formatPrice(site.consultationPrice)}{' '}
      / {site.consultationMinutes} minutter
    </p>
  </div>
</section>
