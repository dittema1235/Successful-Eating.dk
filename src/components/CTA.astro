---
import Icon from './Icon.astro';
import { site, formatPrice } from '../data/site';
interface Props {
  body?: boolean;
  purchase?: boolean;
}
const { body = false } = Astro.props;
---

<section class="closing-cta">
  <div class="container">
    <span class="eyebrow">{body ? 'INDIVIDUEL HJÆLP' : 'ET STED AT BEGYNDE'}</span>
    <h2>{body ? 'Vil du tale med Ditte om din situation?' : 'Klar til at arbejde med dine mønstre?'}</h2>
    <p>
      {body
        ? 'Individuelle psykologsamtaler aftales separat. De er ikke inkluderet i onlineforløbet Bliv glad for din krop.'
        : 'Successful Eating er et online selvstudieforløb på 58 dage. Du arbejder selvstændigt og har livslang adgang til materialet.'}
    </p>
    <div class="actions">
      <a
        class="button"
        href={body ? '/individuelt-forloeb/' : site.checkout}
        data-event={body ? 'service_click' : 'checkout_click'}
        data-location="closing"
      >
        {body ? 'Se individuelle samtaler' : site.purchaseCta} <Icon size={17} />
      </a>
      <a
        class="text-link"
        href={body ? '/bliv-glad-for-din-krop/' : '/forloebet/'}
        data-event={body ? 'service_click' : undefined}
        data-location={body ? 'closing_course' : undefined}
      >
        {body ? 'Eller læs om Bliv glad for din krop' : 'Læs om onlineforløbet'} <Icon size={17} />
      </a>
    </div>
    <p class="small">
      {body
        ? 'Samtaler i Helsingør eller online · Pris oplyses særskilt'
        : formatPrice(site.productPrice) + ' inkl. moms · Livslang adgang · Samtaler er et separat tilkøb'}
    </p>
  </div>
</section>
