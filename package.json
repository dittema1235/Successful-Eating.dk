{
  "name": "successful-eating-dk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "npm run prepare:archive && astro check && astro build",
    "prepare:archive": "node scripts/prepare-archive.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "check:site": "node scripts/check-site.mjs",
    "test:e2e": "playwright test",
    "import:legacy": "node scripts/import-legacy.mjs",
    "format": "prettier --write src scripts tests public/consent.js *.ts *.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.5.0",
    "@fontsource-variable/dm-sans": "^5.2.0",
    "@fontsource-variable/fraunces": "^5.2.0",
    "astro": "^7.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.55.0",
    "cheerio": "^1.1.2",
    "prettier": "^3.9.8",
    "prettier-plugin-astro": "^1.0.1",
    "sharp": "^0.35.4",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
